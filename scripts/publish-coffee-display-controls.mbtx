///|
import {
  "moonbitlang/async@0.22.4",
  "moonbitlang/async@0.22.4/fs",
  "moonbitlang/async@0.22.4/shell",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/x@0.5.5/crypto",
}

///|
async fn main {
  guard @env.args() is [_, mode] else { fail("stage|ship|apply|verify") }
  let staging = "output/coffee-display-controls-20261123-v2"
  let remote = "/home/HwHiAiUser/coffee-display-controls-20261123-v2"
  let live = "/home/HwHiAiUser/moontown-display-20261108/site/disp"
  let previous = "71619b24e04e3b95915663245a08dae3d928c50e3947b1bf5835e5bf56bc2d79"
  let targets = [
    "display-week03-controls-v2.css", "display-awards-week03-names-v2.js", "display-week03-controls-v2.js",
    "index.html",
  ]
  fn digest(bytes : Bytes) -> String {
    @crypto.bytes_to_hex_string(@crypto.sha256(bytes))
  }
  async fn run(command : String, args : Array[String]) -> Unit {
    @shell.Cmd(command, args).output().check()
  }
  let ssh = [
    "-o", "BatchMode=yes", "-o", "StrictHostKeyChecking=yes", "-J", "HwHiAiUser@106.39.18.146:32123",
  ]
  match mode {
    "stage" => {
      @fs.mkdir(staging, recursive=true, permission=0o700)
      let rows : Array[Json] = []
      for
        (source, target) in [
          ("display.css", targets[0]),
          ("display-awards.js", targets[1]),
          ("display.js", targets[2]),
          ("index.html", targets[3]),
        ] {
        let content = @fs.read_file("src/ui/coffee-display/" + source).text()
        let transformed = if source == "index.html" {
          content
          .replace(old="display.css?v=week03-20261122", new=targets[0])
          .replace(old="display.js?v=week03-20261122", new=targets[2])
        } else if source == "display.js" {
          content.replace(old="./display-awards.js?v=3", new="./" + targets[1])
        } else {
          content
        }
        let bytes = @utf8.encode(transformed)
        @fs.write_file(staging + "/" + target, bytes)
        rows.push({ "path": target, "sha256": digest(bytes) })
      }
      @fs.write_file(
        staging + "/manifest.json",
        ({ "previous_html": previous, "files": rows } : Json).stringify(),
      )
      println("Staged icon controls and eight stable AI display aliases")
    }
    "ship" => {
      run("ssh", ssh + ["lunanexa-management", "mkdir -p " + remote])
      run(
        "scp",
        ssh +
        targets.map(path => staging + "/" + path) +
        [
          staging + "/manifest.json",
          "scripts/publish-coffee-display-controls.mbtx",
          "lunanexa-management:" + remote + "/",
        ],
      )
    }
    "apply" => {
      guard @json.parse(@fs.read_file(remote + "/manifest.json").text())
        is { "previous_html": String(old), "files": Array(files), .. } &&
        old == previous else {
        fail("Manifest")
      }
      guard digest(@fs.read_file(live + "/index.html").binary()) == old else {
        fail("Live display changed")
      }
      for row in files {
        guard row is { "path": String(path), "sha256": String(expected), .. } &&
          targets.contains(path) &&
          digest(@fs.read_file(remote + "/" + path).binary()) == expected else {
          fail("Invalid asset")
        }
        guard path == "index.html" || !@fs.exists(live + "/" + path) else {
          fail("Immutable target already exists")
        }
      }
      @fs.write_file(
        remote + "/before-index.html",
        @fs.read_file(live + "/index.html").binary(),
        permission=0o600,
        create_mode=CreateNew,
        sync=Full,
      )
      for path in targets {
        @fs.write_file(
          live + "/" + path + ".next",
          @fs.read_file(remote + "/" + path).binary(),
          permission=0o644,
          sync=Full,
        )
        @fs.rename(live + "/" + path + ".next", live + "/" + path)
      }
      @fs.write_file(
        remote + "/receipt.json",
        (
          {
            "published": true,
            "display_only": true,
            "organizer_confirmed_display": true,
          } : Json).stringify(),
        permission=0o600,
        create_mode=CreateNew,
      )
      println(
        "Published icon toggle and stable AI display aliases; contest records unchanged",
      )
    }
    "verify" => {
      guard @json.parse(@fs.read_file(staging + "/manifest.json").text())
        is { "files": Array(files), .. } else {
        fail("Manifest")
      }
      for row in files {
        guard row is { "path": String(path), "sha256": String(expected), .. } else {
          fail("Row")
        }
        run("curl", [
          "--fail",
          "--silent",
          "--show-error",
          "--max-time",
          "20",
          "--output",
          staging + "/served.bin",
          "https://suanli.kechuangfuwu.com:8443/disp/" + path,
        ])
        guard digest(@fs.read_file(staging + "/served.bin").binary()) ==
          expected else {
          fail("Served file differs: " + path)
        }
      }
      println("All four public display files match reviewed hashes")
    }
    _ => fail("Unknown mode")
  }
}
