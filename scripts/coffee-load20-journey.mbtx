///|
import {
  "moonbitlang/async@0.22.4",
  "moonbitlang/async@0.22.4/fs",
  "moonbitlang/async@0.22.4/shell",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
  "moonbitlang/core/string",
}

///|
let origin = "https://suanli.kechuangfuwu.com:8443"

///|
async fn base(root : String) -> String {
  guard @json.parse(@fs.read_file(root + "/run.json").text())
    is { "route": String(route), .. } &&
    [
      "coffee-load20-r2", "coffee-load20-r5", "coffee-mobile-20261108", "coffee-mobile-20261108-v2",
    ].contains(route) else {
    fail("Isolated journey only")
  }
  origin + "/" + route + "/api/creative/"
}

///|
async fn save(root : String, name : String, value : Json) -> Unit {
  @fs.write_file(
    root + "/journey-" + name + ".json",
    value.stringify(indent=2),
    permission=0o600,
  )
}

///|
async fn request(
  root : String,
  key : String,
  label : String,
  path : String,
  body~ : Json? = None,
  expected~ : String = "200",
) -> Json {
  let output = root + "/journey-" + key + "-" + label + ".json"
  let args = [
    "--silent",
    "--show-error",
    "--max-time",
    "30",
    "--cookie",
    root + "/" + key + "-cookies.txt",
    "--output",
    output,
    "--write-out",
    "%{http_code}",
  ]
  if body is Some(value) {
    let input = root + "/journey-" + key + "-" + label + "-body.json"
    @fs.write_file(input, value.stringify(), permission=0o600)
    args.append([
      "--header",
      "Origin: " + origin,
      "--header",
      "Sec-Fetch-Site: same-origin",
      "--header",
      "Content-Type: application/json",
      "--data-binary",
      "@" + input,
    ])
  }
  args.push(base(root) + path)
  let result = @shell.Cmd("curl", args).output()
  result.check()
  guard result.stdout() == expected else {
    fail(
      "Journey " +
      label +
      " HTTP " +
      result.stdout() +
      "; response retained privately",
    )
  }
  @json.parse(@fs.read_file(output).text())
}

///|
async fn action(
  root : String,
  key : String,
  actor : String,
  name : String,
  payload : Json,
  expected~ : String = "200",
) -> Json {
  request(
    root,
    key,
    name,
    "actions",
    body=Some({ "expected_actor_id": actor, "action": name, "payload": payload }),
    expected~,
  )
}

///|
async fn main {
  guard @env.args() is [_, phase, root] && root.has_prefix("/Users/kq/.codex/") else {
    fail(
      "coffee-load20-journey.mbtx submit19|host|approve|vote19|inspect PRIVATE_R2_EVIDENCE",
    )
  }
  if phase == "init-mobile" {
    guard [
        "/Users/kq/.codex/coffee-mobile-20261108", "/Users/kq/.codex/coffee-mobile-20261108-v2",
      ].contains(root) &&
      !@fs.exists(root) else {
      fail("Use a fresh private mobile rehearsal")
    }
    @fs.mkdir(root, permission=0o700)
    let source = "/Users/kq/.codex/coffee-load20-r6-20261107"
    for file in ["members.json", "jobs.json"] {
      @fs.write_file(
        root + "/" + file,
        @fs.read_file(source + "/" + file).binary(),
        permission=0o600,
      )
    }
    for i in 1..<=20 {
      let key = (if i < 10 { "0" } else { "" }) + i.to_string()
      @fs.write_file(
        root + "/" + key + "-cookies.txt",
        @fs.read_file(source + "/" + key + "-cookies.txt").binary(),
        permission=0o600,
      )
    }
    @fs.write_file(
      root + "/run.json",
      (
        {
          "route": if root.has_suffix("-v2") {
            "coffee-mobile-20261108-v2"
          } else {
            "coffee-mobile-20261108"
          },
        } : Json).stringify(),
      permission=0o600,
    )
    println(
      "Private rehearsal identity evidence initialized; no new accounts or generations",
    )
    return
  }
  if phase == "refresh-identities" {
    guard [
      "/Users/kq/.codex/coffee-mobile-20261108", "/Users/kq/.codex/coffee-mobile-20261108-v2",
    ].contains(root) else {
      fail("Mobile rehearsal identities only")
    }
    let identities : Array[(String, String, String)] = []
    for i in 1..<=20 {
      let key = (if i < 10 { "0" } else { "" }) + i.to_string()
      guard @json.parse(
          @fs.read_file(
            "/Users/kq/.codex/coffee-load20-20261107/" + key + "-register.json",
          ).text(),
        )
        is { "email": String(email), "password": String(password), .. } else {
        fail("Missing test identity")
      }
      identities.push((key, email, password))
    }
    guard @json.parse(
        @fs.read_file(
          "/Users/kq/.codex/coffee-qa-accounts-real-20261107/credentials.json",
        ).text(),
      )
      is Array(credentials) &&
      credentials.iter().find_first(item => item is { "role": "host", .. })
      is Some({ "username": String(host), "password": String(password), .. }) else {
      fail("Missing existing scoped host")
    }
    identities.push(("host", host, password))
    for (key, username, password) in identities {
      let input = root + "/login-" + key + "-input.json"
      @fs.write_file(
        input,
        (
          {
            "username": username,
            "password": password,
            "audience": "enterprise",
          } : Json).stringify(),
        permission=0o600,
      )
      let result = @shell.Cmd("curl", [
        "--silent",
        "--show-error",
        "--max-time",
        "30",
        "--header",
        "Origin: " + origin,
        "--header",
        "Sec-Fetch-Site: same-origin",
        "--header",
        "Content-Type: application/json",
        "--data-binary",
        "@" + input,
        "--cookie-jar",
        root + "/" + key + "-cookies.txt",
        "--output",
        root + "/login-" + key + "-response.json",
        "--write-out",
        "%{http_code}",
        origin + "/user/auth/password",
      ]).output()
      result.check()
      guard result.stdout() == "200" else {
        fail("Test sign-in failed; response retained privately")
      }
    }
    println(
      "Refreshed twenty ordinary test sessions and the existing scoped host",
    )
    return
  }
  guard @json.parse(@fs.read_file(root + "/members.json").text())
    is Array(members) &&
    members.length() == 20 else {
    fail("Need 20 ordinary identities")
  }
  if ["submit19", "submit20", "submit-last"].contains(phase) {
    guard @json.parse(@fs.read_file(root + "/jobs.json").text()) is Array(jobs) &&
      jobs.length() == 20 &&
      jobs.all(job => job is { "state": "completed", .. }) else {
      fail("Need 20 real completed jobs")
    }
    @async.with_task_group(group => {
      for member in members {
        guard member is { "role": String(key), "account_id": String(actor), .. } else {
          fail("Bad member")
        }
        if key == "20" && phase == "submit19" {
          continue
        }
        if key != "20" && phase == "submit-last" {
          continue
        }
        guard jobs
          .iter()
          .find_first(job => job is { "user": String(user), .. } && user == key)
          is Some({ "id": String(id), .. }) else {
          fail("Missing job")
        }
        group.spawn_bg(() => {
          ignore(
            action(root, key, actor, "submit", {
              "generation_id": id,
              "title": "半醒时刻 · " + key,
              "display_name": "体验者 " + key,
              "consent": true,
            }),
          )
        })
      }
    })
    println(
      if phase == "submit20" {
        "Submitted all 20 real images"
      } else if phase == "submit-last" {
        "Resubmitted user20's real image after review return"
      } else {
        "Submitted 19 real images; user 20 remains for the mobile UI submission"
      },
    )
    return
  }
  if !@fs.exists(root + "/host-cookies.txt") {
    @fs.write_file(
      root + "/host-cookies.txt",
      @fs.read_file(
        "/Users/kq/.codex/coffee-qa-accounts-real-20261107/host-cookies.txt",
      ).binary(),
      permission=0o600,
    )
  }
  let host = request(root, "host", "snapshot", "mine")
  guard host
    is { "viewer": { "account_id": String(host_id), "operator": True, .. }, .. } else {
    fail("Existing QA host has no authority here")
  }
  if phase == "host" {
    println("Verified existing scoped host")
    return
  }
  if phase == "review-mobile" {
    guard [
        "/Users/kq/.codex/coffee-mobile-20261108", "/Users/kq/.codex/coffee-mobile-20261108-v2",
      ].contains(root) &&
      host is { "review_queue": Array(queue), .. } &&
      queue.length() == 20 else {
      fail("Only the fresh twenty-pending rehearsal")
    }
    guard queue
      .iter()
      .find_first(item => {
        item is { "entry": { "display_name": "体验者 20", .. }, .. }
      })
      is Some({ "entry": { "id": String(id), .. }, .. }) &&
      members.iter().find_first(item => item is { "role": "01", .. })
      is Some({ "account_id": String(member_id), .. }) else {
      fail("Missing test entries")
    }
    ignore(
      action(
        root,
        "01",
        member_id,
        "approve",
        { "entry_id": id },
        expected="403",
      ),
    )
    ignore(
      action(
        root,
        "01",
        member_id,
        "vote",
        { "entry_id": id, "intent": "before-approval" },
        expected="409",
      ),
    )
    ignore(
      action(
        root,
        "host",
        host_id,
        "reject",
        { "entry_id": id },
        expected="400",
      ),
    )
    let rejected = action(root, "host", host_id, "reject", {
      "entry_id": id,
      "reason": "请在标题中表达半醒咖啡的主题，再提交审核。",
    })
    guard rejected
      is { "review_queue": Array(pending), "gallery": Array([]), .. } &&
      pending.length() == 19 else {
      fail("Rejection did not leave nineteen pending and no public entries")
    }
    println(
      "Permission, early vote and missing-opinion checks passed; returned user20 for resubmission",
    )
    return
  }
  if phase == "publish-mobile" {
    guard [
      "/Users/kq/.codex/coffee-mobile-20261108", "/Users/kq/.codex/coffee-mobile-20261108-v2",
    ].contains(root) else {
      fail("Rehearsal only")
    }
    ignore(action(root, "host", host_id, "award", {}, expected="409"))
    let published = action(root, "host", host_id, "publish-results", {})
    guard published
      is {
        "awards": Array(awards),
        "voting": { "settled": True, "total_votes": Number(20, ..), .. },
        ..
      } &&
      awards.length() == 3 else {
      fail("Expected three vote-based test awards")
    }
    save(root, "published-results", published)
    println(
      "Published three rehearsal prizes from the naturally sealed twenty votes",
    )
    return
  }
  if phase == "settlement" {
    let value = action(root, "host", host_id, "settlement", {})
    save(root, "settlement", value)
    println("Exported the naturally sealed test settlement")
    return
  }
  if ["approve", "approve20"].contains(phase) {
    guard host is { "review_queue": Array(queue), .. } &&
      queue.length() == (if phase == "approve20" { 20 } else { 19 }) else {
      fail("Unexpected pending count")
    }
    // Each approval remains a separate attributable review operation.
    for entry in queue {
      guard entry is { "entry": { "id": String(id), .. }, .. } else {
        fail("Missing entry")
      }
      ignore(
        action(root, "host", host_id, "approve", {
          "entry_id": id,
          "reason": "独立验收作品，已核对主题与展示内容。",
        }),
      )
    }
    println(
      if phase == "approve20" {
        "Approved all 20 entries"
      } else {
        "Approved remaining 19 entries after the mobile review"
      },
    )
    return
  }
  let public = request(root, "01", "public", "public")
  if ["wait-open", "wait-awards"].contains(phase) {
    for _ in 0..<360 {
      let current = request(root, "01", "clock-poll", "public")
      guard current
        is {
          "server_ms": String(now),
          "event": { "awards_ms": String(awards), .. },
          "voting": { "phase": String(status), .. },
          ..
        } else {
        fail("Missing authoritative event clock")
      }
      if phase == "wait-open" && status == "open" {
        println("Live server voting window is open")
        return
      }
      if phase == "wait-open" && status == "closed" {
        fail("The vote has already closed; never reopen a frozen event")
      }
      if phase == "wait-awards" &&
        status == "closed" &&
        @string.parse_uint64(now) >= @string.parse_uint64(awards) {
        println("Live server sealed the vote and reached awards time")
        return
      }
      @async.sleep(1000)
    }
    fail("Timed out waiting for the live event clock")
  }
  if phase == "vote-mobile-last" {
    guard [
        "/Users/kq/.codex/coffee-mobile-20261108", "/Users/kq/.codex/coffee-mobile-20261108-v2",
      ].contains(root) &&
      members.iter().find_first(item => item is { "role": "20", .. })
      is Some({ "account_id": String(voter), .. }) &&
      public
      is {
        "gallery": Array(gallery),
        "voting": { "phase": "open", "total_votes": Number(19, ..), .. },
        ..
      } else {
      fail("Need nineteen real votes in the open rehearsal")
    }
    let targets = ["03", "02", "20"].map(key => {
      guard gallery
        .iter()
        .find_first(item => {
          item is { "display_name": String(display), .. } &&
          display == "体验者 " + key
        })
        is Some({ "id": String(id), .. }) else {
        fail("Missing work")
      }
      id
    })
    ignore(action(root, "host", host_id, "publish-results", {}, expected="403"))
    ignore(
      action(root, "20", voter, "vote", {
        "entry_id": targets[0],
        "intent": "mobile-cast",
      }),
    )
    let changed = action(root, "20", voter, "vote", {
      "entry_id": targets[1],
      "intent": "mobile-change",
    })
    guard changed is { "voting": { "total_votes": Number(20, ..), .. }, .. } else {
      fail("Changing a vote must not add a ballot")
    }
    let cancelled = action(root, "20", voter, "cancel-vote", {
      "intent": "mobile-cancel",
    })
    guard cancelled is { "voting": { "total_votes": Number(19, ..), .. }, .. } else {
      fail("Cancelling a vote must remove exactly one ballot")
    }
    ignore(
      action(
        root,
        "20",
        voter,
        "vote",
        { "entry_id": targets[2], "intent": "mobile-own" },
        expected="409",
      ),
    )
    let restored = action(root, "20", voter, "vote", {
      "entry_id": targets[0],
      "intent": "mobile-restore",
    })
    guard restored is { "voting": { "total_votes": Number(20, ..), .. }, .. } else {
      fail("Need twenty votes after restoration")
    }
    save(root, "vote-change-cancel", restored)
    println(
      "Real voter20 cast, changed, cancelled and restored one ballot; own-vote and early awards blocked",
    )
    return
  }
  if ["vote19", "vote20"].contains(phase) {
    guard public
      is { "gallery": Array(gallery), "voting": { "phase": "open", .. }, .. } &&
      gallery.length() == 20 else {
      fail("Need 20 approved entries and an open vote")
    }
    @async.with_task_group(group => {
      for i, member in members {
        guard member is { "role": String(key), "account_id": String(actor), .. } else {
          fail("Bad member")
        }
        if key == "20" && phase == "vote19" {
          continue
        }
        let target = if i == 0 || (i >= 10 && i < 15) {
          1
        } else if i >= 15 {
          2
        } else {
          0
        }
        // A different author's entry; match by the public display name only.
        let author = (if target + 1 < 10 { "0" } else { "" }) +
          (target + 1).to_string()
        guard gallery
          .iter()
          .find_first(entry => {
            entry is { "display_name": String(name), .. } &&
            name == "体验者 " + author
          })
          is Some({ "id": String(id), .. }) else {
          fail("Missing eligible work")
        }
        group.spawn_bg(() => {
          ignore(
            action(root, key, actor, "vote", {
              "entry_id": id,
              "intent": "load20-r2-vote-" + key,
            }),
          )
        })
      }
    })
    println(
      if phase == "vote20" {
        "All 20 real accounts voted"
      } else {
        "19 real accounts voted; user 20 remains for the mobile UI vote"
      },
    )
    return
  }
  guard phase == "inspect" else { fail("Unknown journey phase") }
  let fresh = request(root, "host", "final", "mine")
  guard fresh
    is {
      "gallery": Array(gallery),
      "review_queue": Array(queue),
      "voting": Object(voting),
      ..
    } else {
    fail("Missing result")
  }
  let summary : Json = {
    "gallery": gallery.length(),
    "pending": queue.length(),
    "voting": Json::object(voting),
  }
  save(root, "summary", summary)
  println(summary.stringify(indent=2))
}
