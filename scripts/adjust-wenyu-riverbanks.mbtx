import {
  "moonbitlang/x@0.4.40/fs",
  "moonbitlang/core/json",
  "moonbitlang/core/encoding/base64",
}

///|
struct P { x : Double; y : Double } derive(ToJson)
///|
struct Segment { a : P; b : P }
///|
fn field(j : Json, k : String) -> Json { match j { Object(m) => m.get(k).unwrap_or(Json::null()); _ => Json::null() } }
///|
fn arr(j : Json) -> Array[Json] { match j { Array(a) => a; _ => abort("Expected array") } }
///|
fn num(j : Json) -> Double { match j { Number(n,..) => n; _ => abort("Expected number") } }
///|
fn str(j : Json) -> String { match j { String(s) => s; _ => "" } }
///|
fn point(j : Json) -> P { {x:num(field(j,"x")),y:num(field(j,"y"))} }
///|
fn distance(a : P, b : P) -> Double { ((a.x-b.x)*(a.x-b.x)+(a.y-b.y)*(a.y-b.y)).sqrt() }
///|
fn mix(a : P, b : P, t : Double) -> P { {x:a.x+(b.x-a.x)*t,y:a.y+(b.y-a.y)*t} }
///|
fn gentle(p : P) -> P {
  let w=1.0+0.01*((p.x-256.0)/256.0-p.y/144.0)
  guard w>0.0 else { abort("Unsafe source horizon") }
  {x:256.0+(p.x-256.0)/w,y:p.y/w}
}
///|
fn positive_tag(tags : Json, key : String) -> Bool {
  let v=str(field(tags,key))
  v!="" && v!="no" && v!="0" && v!="false"
}
///|
fn protected_way(way : Json) -> Bool {
  let tags=field(way,"tags")
  positive_tag(tags,"bridge") || positive_tag(tags,"tunnel") || positive_tag(tags,"ford")
}
///|
fn water(rows : Array[String], x : Int, y : Int) -> Bool {
  x>=0 && x<256 && y>=0 && y<144 && "rlb".contains(rows[y].get_char(x).unwrap().to_string())
}
///|
fn wet(rows : Array[String], p : P) -> Bool { water(rows,p.x.floor().to_int(),p.y.floor().to_int()) }
///|
// Truncated signed distance at tile centers; interpolate continuously at use.
fn shore_field(rows : Array[String]) -> Array[Double] {
  let result : Array[Double]=[]
  for y in 0..<144 {
    for x in 0..<256 {
      let inside=water(rows,x,y)
      let mut nearest=6.0
      for dy in -6..=6 {
        for dx in -6..=6 {
          let xx=x+dx;let yy=y+dy
          if xx>=0 && xx<256 && yy>=0 && yy<144 && water(rows,xx,yy)!=inside {
            nearest=nearest.min((dx*dx+dy*dy).to_double().sqrt()-0.5)
          }
        }
      }
      result.push(if inside {-nearest} else {nearest})
    }
  }
  result
}
///|
fn signed_distance(field : Array[Double], p : P) -> Double {
  let x=(p.x-0.5).max(0.0).min(254.999999)
  let y=(p.y-0.5).max(0.0).min(142.999999)
  let ix=x.floor().to_int();let iy=y.floor().to_int()
  let tx=x-ix.to_double();let ty=y-iy.to_double()
  let a=field[iy*256+ix]*(1.0-tx)+field[iy*256+ix+1]*tx
  let b=field[(iy+1)*256+ix]*(1.0-tx)+field[(iy+1)*256+ix+1]*tx
  a*(1.0-ty)+b*ty
}
///|
fn segment_distance(p : P, s : Segment) -> Double {
  let dx=s.b.x-s.a.x;let dy=s.b.y-s.a.y
  let length=dx*dx+dy*dy
  let t=if length==0.0 {0.0} else {((p.x-s.a.x)*dx+(p.y-s.a.y)*dy)/length}
  distance(p,mix(s.a,s.b,t.max(0.0).min(1.0)))
}
///|
fn smooth(t : Double) -> Double { let v=t.max(0.0).min(1.0);v*v*(3.0-2.0*v) }
///|
// Do not bend a transverse crossing into a bank-following detour just because
// it lacks bridge metadata. Guard it for review; never invent a bridge tag.
fn transverse(s : Segment, field : Array[Double], rows : Array[String]) -> Bool {
  let length=distance(s.a,s.b)
  if length<0.000001 {return false}
  let n=(length/0.5).ceil().to_int().max(1)
  for i in 0..=n {
    let p=mix(s.a,s.b,i.to_double()/n.to_double())
    if !wet(rows,p) {continue}
    let dx=signed_distance(field,{x:p.x+0.25,y:p.y})-signed_distance(field,{x:p.x-0.25,y:p.y})
    let dy=signed_distance(field,{x:p.x,y:p.y+0.25})-signed_distance(field,{x:p.x,y:p.y-0.25})
    let gradient=(dx*dx+dy*dy).sqrt()
    if gradient>0.000001 && ((s.b.x-s.a.x)*dx+(s.b.y-s.a.y)*dy).abs()/(length*gradient)>0.78 {
      return true
    }
  }
  false
}
///|
// One deterministic position field for every non-protected way: shared nodes
// cannot separate. Bridge spans and a 0.2-tile buffer are fixed; taper to 1.2.
fn adjust(p : P, field : Array[Double], locked_spans : Array[Segment]) -> P {
  if p.x<1.0 || p.x>255.0 || p.y<1.0 || p.y>143.0 { return p }
  let initial=signed_distance(field,p)
  if initial>=0.35 || initial<=-2.0 { return p }
  let mut clearance=1.2
  for s in locked_spans {
    if p.x>=s.a.x.min(s.b.x)-1.2 && p.x<=s.a.x.max(s.b.x)+1.2 &&
      p.y>=s.a.y.min(s.b.y)-1.2 && p.y<=s.a.y.max(s.b.y)+1.2 {
      clearance=clearance.min(segment_distance(p,s))
    }
  }
  if clearance<=0.2 { return p }
  let gain=smooth((clearance-0.2)/1.0)*smooth((initial+2.0)/0.5)
  let mut q=p
  for _ in 0..<12 {
    let d=signed_distance(field,q)
    if d>=0.35 { break }
    let dx=signed_distance(field,{x:q.x+0.25,y:q.y})-signed_distance(field,{x:q.x-0.25,y:q.y})
    let dy=signed_distance(field,{x:q.x,y:q.y+0.25})-signed_distance(field,{x:q.x,y:q.y-0.25})
    let length=(dx*dx+dy*dy).sqrt()
    if length<0.000001 { break }
    let step=(0.35-d).min(0.25)
    let candidate : P={x:q.x+step*dx/length,y:q.y+step*dy/length}
    let total=distance(p,candidate)
    q=if total>1.5 {mix(p,candidate,1.5/total)} else {candidate}
    if total>=1.5 { break }
  }
  mix(p,q,gain)
}
///|
// Smooth the displacement vectors, not the roads and not the terrain. Filtering
// removes tile-scale normal changes; convex B-spline weights avoid overshoot.
fn displacement_field(terrain : Array[Double]) -> Array[P] {
  let raw : Array[P]=[]
  for y in 0..<144 {
    for x in 0..<256 {
      let p : P={x:x.to_double()+0.5,y:y.to_double()+0.5}
      let q=adjust(p,terrain,[])
      raw.push({x:q.x-p.x,y:q.y-p.y})
    }
  }
  let weights=[1.0,4.0,6.0,4.0,1.0]
  let mut current=raw
  for _ in 0..<2 {
    for axis in 0..<2 {
      let next : Array[P]=[]
      for y in 0..<144 {
        for x in 0..<256 {
          let mut dx=0.0;let mut dy=0.0
          for k in -2..=2 {
            let xx=(x+(if axis==0 {k} else {0})).max(0).min(255)
            let yy=(y+(if axis==1 {k} else {0})).max(0).min(143)
            let v=current[yy*256+xx];let w=weights[k+2]/16.0
            dx+=v.x*w;dy+=v.y*w
          }
          next.push({x:dx,y:dy})
        }
      }
      current=next
    }
  }
  current
}
///|
fn cubic_weights(t : Double) -> Array[Double] {
  let t2=t*t;let t3=t2*t
  [(1.0-t)*(1.0-t)*(1.0-t)/6.0,(3.0*t3-6.0*t2+4.0)/6.0,
    (-3.0*t3+3.0*t2+3.0*t+1.0)/6.0,t3/6.0]
}
///|
fn smooth_adjust(p : P, field : Array[P], spans : Array[Segment]) -> P {
  if p.x<=0.0 || p.x>=256.0 || p.y<=0.0 || p.y>=144.0 {return p}
  let x=p.x-0.5;let y=p.y-0.5
  let ix=x.floor().to_int();let iy=y.floor().to_int()
  let wx=cubic_weights(x-ix.to_double());let wy=cubic_weights(y-iy.to_double())
  let mut dx=0.0;let mut dy=0.0
  for j in 0..<4 {
    for i in 0..<4 {
      let q=field[(iy+j-1).max(0).min(143)*256+(ix+i-1).max(0).min(255)]
      let w=wx[i]*wy[j];dx+=q.x*w;dy+=q.y*w
    }
  }
  let mut clearance=4.0
  if dx.abs()+dy.abs()<0.000000001 {return p}
  for s in spans {
    if p.x>=s.a.x.min(s.b.x)-4.0 && p.x<=s.a.x.max(s.b.x)+4.0 &&
      p.y>=s.a.y.min(s.b.y)-4.0 && p.y<=s.a.y.max(s.b.y)+4.0 {
      clearance=clearance.min(segment_distance(p,s))
    }
  }
  let gain=smooth((clearance-0.2)/3.8)*smooth(p.x.min(256.0-p.x).min(p.y).min(144.0-p.y)/2.0)
  {x:p.x+2.0*dx*gain,y:p.y+2.0*dy*gain}
}
///|
// Clip display only. The full geographic source stays in the input artifact.
fn clip(a : P, b : P) -> Segment? {
  let fa=[a.x,256.0-a.x,a.y,144.0-a.y]
  let fb=[b.x,256.0-b.x,b.y,144.0-b.y]
  let mut lo=0.0;let mut hi=1.0
  for i in 0..<4 {
    if fa[i]<0.0 && fb[i]<0.0 {return None}
    if (fa[i]<0.0)!=(fb[i]<0.0) {
      let t=fa[i]/(fa[i]-fb[i])
      if fa[i]<0.0 {lo=lo.max(t)} else {hi=hi.min(t)}
    }
  }
  if lo>hi {None} else {Some({a:mix(a,b,lo),b:mix(a,b,hi)})}
}
///|
fn self_test() -> Unit raise {
  let plane : Array[Double]=[]
  for _ in 0..<144 { for x in 0..<256 { plane.push(x.to_double()+0.5-100.0) } }
  let p : P={x:99.6,y:60}
  let q=adjust(p,plane,[])
  assert_true(q.x>=100.34 && distance(p,q)<=1.5)
  assert_true(distance(adjust({x:110,y:60},plane,[]),{x:110,y:60})==0.0)
  let bridge : Array[Segment]=[{a:{x:95,y:60},b:{x:105,y:60}}]
  assert_true(distance(adjust(p,plane,bridge),p)==0.0)
  assert_true(distance(adjust({x:98.01,y:65},plane,[]),{x:98.01,y:65})<=1.5)
  assert_true(!positive_tag({"bridge":"no"},"bridge"))
  assert_true(positive_tag({"bridge":"viaduct"},"bridge"))
  let rows : Array[String]=[]
  for _ in 0..<144 {rows.push(String::make(100,'r')+String::make(156,'.'))}
  assert_true(transverse({a:{x:99,y:60},b:{x:101,y:60}},plane,rows))
  assert_true(!transverse({a:{x:99.6,y:50},b:{x:99.6,y:70}},plane,rows))
  assert_true(clip({x:-5,y:20},{x:5,y:20}) is Some(_))
  for t in [0.0,0.25,0.5,0.9,1.0] {
    let weights=cubic_weights(t)
    let mut sum=0.0
    for w in weights {assert_true(w>=0.0);sum+=w}
    assert_true((sum-1.0).abs()<0.00000001)
  }
  let filtered=displacement_field(plane)
  assert_true(distance(smooth_adjust(p,filtered,bridge),p)==0.0)
  let left=smooth_adjust({x:99.5-0.00001,y:65},filtered,[])
  let middle=smooth_adjust({x:99.5,y:65},filtered,[])
  let right=smooth_adjust({x:99.5+0.00001,y:65},filtered,[])
  assert_true(((right.x-middle.x)-(middle.x-left.x)).abs()<0.00000001)
}
///|
fn main raise {
  self_test()
  let source=@json.parse(@fs.read_file_to_string("docs/project/wenyu-lower-perspective.json"))
  let ways=arr(field(source,"ways"));assert_eq(ways.length(),6420)
  let labels=@json.parse(@fs.read_file_to_string("src/ui/assets/tilemap/wenyu_reference_labels.json"))
  let rows=arr(field(labels,"rows")).map(str)
  assert_eq(rows.length(),144)
  let terrain=shore_field(rows)
  let locked_spans : Array[Segment]=[]
  let locked_nodes : Map[String,Bool]=Map([])
  let mut bridge_count=0;let mut vertices=0
  for way in ways {
    let points=arr(field(way,"pathGrid")).map(p=>gentle(point(p)))
    vertices+=points.length()
    if positive_tag(field(way,"tags"),"bridge") {bridge_count+=1}
    if protected_way(way) {
      for node in arr(field(way,"nodes")) {locked_nodes[node.stringify()]=true}
      for i in 1..<points.length() {locked_spans.push({a:points[i-1],b:points[i]})}
    }
  }
  assert_eq(vertices,44343);assert_eq(bridge_count,338)
  let mut transverse_guards=0
  for way in ways {
    if protected_way(way) {continue}
    let points=arr(field(way,"pathGrid")).map(p=>gentle(point(p)))
    for i in 1..<points.length() {
      if clip(points[i-1],points[i]) is Some(s) && transverse(s,terrain,rows) {
        locked_spans.push(s);transverse_guards+=1
      }
    }
  }
  let before=StringBuilder();let after=StringBuilder()
  let filtered=displacement_field(terrain)
  // Guard rare dry-to-water pockets as a smooth spatial fade, not a per-point
  // clamp. This keeps a continuous field and shared-node equality intact.
  let mut dry_guards=0
  for _ in 0..<3 {
    let extra : Array[Segment]=[]
    for way in ways {
      if protected_way(way) {continue}
      let points=arr(field(way,"pathGrid")).map(p=>gentle(point(p)))
      for i in 1..<points.length() {
        if clip(points[i-1],points[i]) is Some(s) {
          let n=(distance(s.a,s.b)/0.2).ceil().to_int().max(1)
          for j in 0..=n {
            let p=mix(s.a,s.b,j.to_double()/n.to_double())
            if !wet(rows,p) && wet(rows,smooth_adjust(p,filtered,locked_spans)) {
              extra.push({a:p,b:p})
            }
          }
        }
      }
    }
    if extra.is_empty() {break}
    dry_guards+=extra.length()
    for s in extra {locked_spans.push(s)}
  }
  let changes : Array[Json]=[];let residual : Array[Json]=[]
  let shared : Map[String,P]=Map([])
  let mut water_before=0;let mut water_after=0;let mut max_move=0.0;let mut newly_wet=0
  for way in ways {
    let points=arr(field(way,"pathGrid")).map(p=>gentle(point(p)))
    let nodes=arr(field(way,"nodes"));assert_eq(nodes.length(),points.length())
    let fixed=protected_way(way)
    // Exact source-node checks independently of display densification/clipping.
    for i,p in points {
      let q=if fixed {p} else {smooth_adjust(p,filtered,locked_spans)}
      let key=nodes[i].stringify()
      if locked_nodes.contains(key) {assert_true(distance(p,q)<0.000000001)}
      if shared.get(key) is Some(previous) {assert_true(distance(previous,q)<0.00000001)}
      shared[key]=q
    }
    let d0=StringBuilder();let d1=StringBuilder();let original=StringBuilder()
    let mut moved=0;let mut b=0;let mut a=0;let mut way_max=0.0
    for i in 1..<points.length() {
      if clip(points[i-1],points[i]) is Some(s) {
        original.write_string("M\{s.a.x},\{s.a.y}L\{s.b.x},\{s.b.y}")
        let n=(distance(s.a,s.b)/0.2).ceil().to_int().max(1)
        for j in 0..=n {
          let p=mix(s.a,s.b,j.to_double()/n.to_double())
          let q=if fixed {p} else {smooth_adjust(p,filtered,locked_spans)}
          let delta=distance(p,q)
          assert_true(delta<=1.50000001)
          if fixed {assert_eq(delta,0.0)}
          if delta>0.000001 {moved+=1}
          way_max=way_max.max(delta)
          if !fixed {
            if wet(rows,p) {b+=1}
            if wet(rows,q) {a+=1}
            if !wet(rows,p) && wet(rows,q) {newly_wet+=1}
          }
          let command=if j==0 {"M"} else {"L"}
          d0.write_string("\{command}\{p.x},\{p.y}")
          d1.write_string("\{command}\{q.x},\{q.y}")
        }
      }
    }
    let kind=str(field(field(way,"tags"),"highway"))
    if fixed {assert_eq(d0.to_string(),d1.to_string())}
    let minor=["footway","path","steps","cycleway","track","pedestrian"].contains(kind)
    let style="fill='none' stroke='#ffc46d' stroke-width='\{if minor {0.09} else {0.24}}' opacity='\{if minor {0.35} else {0.95}}'"
    before.write_string("<path d='\{original.to_string()}' \{style}/>")
    // Straight, unmoved source segments need no extra display samples.
    after.write_string("<path d='\{if moved==0 {original.to_string()} else {d1.to_string()}}' \{style}/>")
    water_before+=b;water_after+=a;max_move=max_move.max(way_max)
    if moved>0 {changes.push({"osmWayId":field(way,"osmWayId"),"name":field(field(way,"tags"),"name"),"maximumMovementTiles":way_max,"movedDisplaySamples":moved,"waterSamplesBefore":b,"waterSamplesAfter":a})}
    if a>0 {residual.push({"osmWayId":field(way,"osmWayId"),"waterSamples":a})}
  }
  assert_true(water_after<water_before)
  assert_eq(newly_wet,0)
  let report : Json={"schema":"moontown.wenyu_bank_clearance.v1","runtimeEligible":false,"routingAuthority":false,"terrainChanged":false,"source":"docs/project/wenyu-lower-perspective.json","base":"gentle 0.01 / 0.01","maximumMovementTiles":max_move,"sourceWays":6420,"sourceVertices":vertices,"bridgeWaysUnchanged":bridge_count,"sharedSourceNodesVerified":shared.length(),"waterSamplesBefore":water_before,"waterSamplesAfter":water_after,"method":"Continuous signed-distance riverbank clearance, 0.35-tile target, 1.5-tile cap. Fixed tagged bridges/tunnels/fords and 0.2-tile buffer; smooth taper to 1.2 tiles. Deep water beyond 2 tiles unchanged. Same position field preserves shared-node coordinates. Display densified at <=0.2 tile before adjustment; no source roads deleted.","limitations":"Raster-mask paired centerline sample counts, not surveyed water clearance or a routing certification. Residual deep/ambiguous crossings retained. Source and bridge metadata unchanged.","changedWays":changes,"residualWays":residual}
  let report : Json={"result":report,"supersedes":"Tile-following v1 rejected visually by user: excessive road waviness","smoothing":"Two separable [1,4,6,4,1]/16 blur passes on displacement vectors, followed by convex cubic B-spline interpolation. Gain 2; four-tile smooth bridge approach fade. No smoothing of source roads, bridge paths, or terrain.","dryRegressionGuardSamples":dry_guards,"transverseSegmentsGuardedNotAssumedBridges":transverse_guards,"newDryToWaterSamples":newly_wet}
  @fs.write_string_to_file("docs/project/wenyu-bank-clearance.json",report.stringify(indent=2))
  println("Changed \{changes.length()} ways; water samples \{water_before} -> \{water_after}; max move \{max_move}; \{bridge_count} bridge ways unchanged; \{transverse_guards} transverse segments guarded")
  let overlay="<svg xmlns='http://www.w3.org/2000/svg' width='2048' height='1152' viewBox='0 0 256 144'><title>Gentle road projection with local bank clearance; bridges fixed</title>\{after.to_string()}</svg>"
  // Rejected local-warp study; must never overwrite the active rigid trial.
  @fs.write_string_to_file("docs/project/wenyu-bank-local-study.svg",overlay)
  let png=@base64.encode(@fs.read_file_to_bytes("src/ui/assets/tilemap/wenyu_reference_labels_preview.png"))
  let svg=StringBuilder()
  svg.write_string("<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 1800 1120'><rect width='1800' height='1120' fill='#182a29'/><style>text{font:22px system-ui;fill:#f6f3e9}</style><text x='30' y='45'>Smooth riverbank offset · original road curves retained · all 338 bridge ways fixed</text>")
  for i in 0..<2 {
    let x=30+i*900
    let drawing=if i==0 {before.to_string()} else {after.to_string()}
    svg.write_string("<text x='\{x}' y='90'>\{if i==0 {"Before"} else {"After · at most 1.5 tiles toward land"}}</text><svg x='\{x}' y='110' width='840' height='473' viewBox='0 0 256 144'><image href='data:image/png;base64,\{png}' width='256' height='144'/>\{drawing}</svg><text x='\{x}' y='630'>River bend detail · identical scale</text><svg x='\{x}' y='655' width='840' height='350' viewBox='175 55 80 34'><image href='data:image/png;base64,\{png}' width='256' height='144'/>\{drawing}</svg>")
  }
  svg.write_string("<text x='30' y='1052'>Non-protected centerline water samples: \{water_before} → \{water_after}. Deep overlaps remain; terrain is not moved.</text><text x='30' y='1092'>© OpenStreetMap contributors · ODbL 1.0 · source roads retained · display-only local correction</text></svg>")
  @fs.write_string_to_file("docs/project/wenyu-bank-clearance.svg",svg.to_string())
  @fs.write_string_to_file("src/ui/rabbita-town/dist/wenyu-bank-clearance.svg",svg.to_string())
}
