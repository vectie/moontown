///|
import {
  "moonbitlang/async@0.22.4",
  "moonbitlang/async@0.22.4/fs",
  "moonbitlang/async@0.22.4/shell",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
}

///|
async fn kube(args : Array[String]) -> String {
  let result = @shell.Cmd(
    "kubectl",
    ["--kubeconfig", "/home/HwHiAiUser/.kube/lunanexa-management", ..args],
  ).output()
  result.check()
  result.stdout()
}

///|
async fn main {
  let (root, name, event_id) = match @env.args() {
    [_, root] => (root, "moontown-coffee-load20", "coffee-load20-20261107")
    [_, root, "r2"] =>
      (root, "moontown-coffee-load20-r2", "coffee-load20-r2-20261107")
    [_, root, "r3"] =>
      (root, "moontown-coffee-load20-r3", "coffee-load20-r3-20261107")
    [_, root, "r4"] =>
      (root, "moontown-coffee-load20-r4", "coffee-load20-r4-20261107")
    [_, root, "r5"] =>
      (root, "moontown-coffee-load20-r5", "coffee-load20-r5-20261107")
    [_, root, "r6"] =>
      (root, "moontown-coffee-load20-r6", "coffee-load20-r6-20261107")
    _ => fail("collect-coffee-load20.mbtx PRIVATE_RELEASE_DIR [r2]")
  }
  guard root.has_prefix("/home/HwHiAiUser/") else {
    fail("Private directory required")
  }
  let ns = "aigc-acceptance-20260915"
  guard @json.parse(
      kube(["-n", ns, "get", "pvc", name + "-state", "-o", "json"]),
    )
    is { "spec": { "volumeName": String(pv), .. }, .. } else {
    fail("Missing load PVC")
  }
  guard @json.parse(kube(["get", "pv", pv, "-o", "json"]))
    is {
      "spec": {
        "csi": {
          "volumeAttributes": {
            "server": "192.168.2.175",
            "share": "/data/lunanexa-workspaces",
            "subDir": String(subdir),
            ..
          },
          ..
        },
        ..
      },
      ..
    } &&
    subdir.has_prefix(ns + "/" + name + "-state/") &&
    !subdir.contains("..") else {
    fail("Unexpected load storage")
  }
  let state = @fs.read_file(
    "/data/lunanexa-workspaces/" + subdir + "/" + event_id + "/state.json",
  ).text()
  guard @json.parse(state)
    is { "challenge_id": String(challenge_id), "generations": Array(jobs), .. } &&
    challenge_id == event_id &&
    jobs.length() == 20 &&
    jobs.all(job => {
      job is { "state": String("completed" | "failed" | "needs_reconcile"), .. }
    }) else {
    fail("20jobs have not reached terminal state")
  }
  @fs.write_file(root + "/server-state.json", state, permission=0o600)
  @fs.write_file(root + "/stop-monitor", "complete", permission=0o600)
  @fs.write_file(
    root + "/pods-after.json",
    kube(["-n", ns, "get", "pods", "-l", "app=" + name, "-o", "json"]),
    permission=0o600,
  )
  @fs.write_file(
    root + "/models-after.json",
    kube([
      "-n", "lunanexa", "get", "pods", "-l", "app in (image-adapter,comfyui-image,qwen3-llm)",
      "-o", "json",
    ]),
    permission=0o600,
  )
  println("Collected20terminalserverrecords and retained private evidence")
}
