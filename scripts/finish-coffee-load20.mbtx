///|
import {
  "moonbitlang/async@0.22.4",
  "moonbitlang/async@0.22.4/fs",
  "moonbitlang/async@0.22.4/shell",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
}

///|
async fn kube(args : Array[String]) -> String {
  let result = @shell.Cmd(
    "kubectl",
    ["--kubeconfig", "/home/HwHiAiUser/.kube/lunanexa-management", ..args],
  ).output()
  result.check()
  result.stdout()
}

///|
async fn main {
  let (root, suffix, expected) = match @env.args() {
    [_, root] =>
      (
        root, "", "62213c1b44971cb81730fb288dcab73477b855833e2572272d4b7dabea2bfff4",
      )
    [_, root, "r3"] =>
      (
        root, "-r3", "32a21f916ca9ebd8bfd6161d0a3956ff4d41bb12c9bf8c73207c3ac390242af7",
      )
    [_, root, "r4"] =>
      (
        root, "-r4", "4fc3b7c6e9ba98e004858e8b61d18fee2e7a5c8b8099059376e92bf37afad33c",
      )
    [_, root, "r2"] =>
      (
        root, "-r2", "b760272cdac808f232d468873add989dbfe374cef0d2ddf19ce7d538caa7e743",
      )
    [_, root, "r6"] =>
      (
        root, "-r6", "b760272cdac808f232d468873add989dbfe374cef0d2ddf19ce7d538caa7e743",
      )
    _ => fail("PRIVATE_COMPLETED_RUN [r3|r4]")
  }
  let event_id = "coffee-load20" + suffix + "-20261107"
  guard root.has_prefix("/home/HwHiAiUser/") &&
    @json.parse(@fs.read_file(root + "/server-state.json").text())
    is { "challenge_id": String(challenge), "generations": Array(jobs), .. } &&
    challenge == event_id &&
    jobs.length() == 20 &&
    jobs.all(job => job is { "state": "completed", .. }) else {
    fail("Only stop the completed20-job rehearsal")
  }
  let ns = "aigc-acceptance-20260915"
  let name = "moontown-coffee-load20" + suffix
  let current = @json.parse(
    kube(["-n", ns, "get", "deployment", name, "-o", "json"]),
  )
  guard current
    is {
      "metadata": { "resourceVersion": String(version), .. },
      "spec": {
        "replicas": 1,
        "template": {
          "spec": {
            "containers": [
              {
                "name": "platform",
                "image": String(image),
                "env": Array(environment),
                ..
              },
            ],
            ..
          },
          ..
        },
        ..
      },
      ..
    } &&
    image ==
    "lunanexa-registry.lunanexa-registry.svc.cluster.local:5000/moon/moontown-account-gateway@sha256:" +
    expected &&
    environment.any(item => {
      item
      is {
        "name": "MOONTOWN_CREATIVE_STATE_FILE",
        "value": String(state_path),
        ..
      } &&
      state_path == "/creative/" + event_id + "/state.json"
    }) else {
    fail("Rehearsal drift")
  }
  @fs.write_file(
    root + "/deployment-finished.json",
    current.stringify(),
    permission=0o600,
    create_mode=CreateNew,
  )
  let patch : Json = [
    { "op": "test", "path": "/metadata/resourceVersion", "value": version },
    {
      "op": "test",
      "path": "/spec/template/spec/containers/0/image",
      "value": image,
    },
    { "op": "test", "path": "/spec/replicas", "value": 1 },
    { "op": "replace", "path": "/spec/replicas", "value": 0 },
  ]
  println(
    kube([
      "-n",
      ns,
      "patch",
      "deployment",
      name,
      "--type=json",
      "--patch",
      patch.stringify(),
    ]),
  )
  // Remove only this run's public exposure and added policy grants. Preserve
  // the complete PVC, files and reproducible manifests for inspection.
  for
    resource in [
      "route", "rewrite", "provider-network", "network-moontown-creative-provider",
      "network-moontown-platform",
    ] {
    println(
      kube(["delete", "-f", root + "/" + resource + ".json", "--wait=true"]),
    )
  }
  println(
    "Stopped load instance and removed its route/policies; retained20images and state, no production/GPU settings changed",
  )
}
