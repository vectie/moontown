///|
import {
  "moonbitlang/async@0.22.4",
  "moonbitlang/async@0.22.4/fs",
  "moonbitlang/async@0.22.4/shell",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
}

///|
async fn kube(args : Array[String]) -> String {
  let result = @shell.Cmd(
    "kubectl",
    ["--kubeconfig", "/home/HwHiAiUser/.kube/lunanexa-management", ..args],
  ).output()
  result.check()
  result.stdout()
}

///|
async fn main {
  let (root, runtime, ui, repeat) = match @env.args() {
    [_, root] => (root, "", "", false)
    [_, root, "r2", runtime, ui] => (root, runtime, ui, true)
    [_, root, "r3", runtime, ui] => (root, runtime, ui, true)
    [_, root, "r4", runtime, ui] => (root, runtime, ui, true)
    [_, root, "r5", runtime, ui] => (root, runtime, ui, true)
    [_, root, "r6", runtime, ui] => (root, runtime, ui, true)
    _ =>
      fail(
        "deploy-coffee-load20.mbtx NEW_PRIVATE_RELEASE_DIR [r2 RUNTIME_DIGEST UI_DIGEST]",
      )
  }
  guard root.has_prefix("/home/HwHiAiUser/") else {
    fail("Private directory required")
  }
  if repeat {
    for digest in [runtime, ui] {
      guard digest.has_prefix("sha256:") &&
        digest.length() == 71 &&
        digest[7:].all(c => c is ('0'..<='9' | 'a'..<='f')) else {
        fail("Pinned image digest required")
      }
    }
  }
  let ns = "aigc-acceptance-20260915"
  let third = @env.args().contains("r3")
  let fourth = @env.args().contains("r4")
  let fifth = @env.args().contains("r5")
  let sixth = @env.args().contains("r6")
  let name = if sixth {
    "moontown-coffee-load20-r6"
  } else if fifth {
    "moontown-coffee-load20-r5"
  } else if fourth {
    "moontown-coffee-load20-r4"
  } else if third {
    "moontown-coffee-load20-r3"
  } else if repeat {
    "moontown-coffee-load20-r2"
  } else {
    "moontown-coffee-load20"
  }
  let route = if sixth {
    "coffee-load20-r6"
  } else if fifth {
    "coffee-load20-r5"
  } else if fourth {
    "coffee-load20-r4"
  } else if third {
    "coffee-load20-r3"
  } else if repeat {
    "coffee-load20-r2"
  } else {
    "coffee-load20"
  }
  let event_id = route + "-20261107"
  for
    kind in [
      "deployment", "service", "configmap", "pvc", "ingressroute", "middleware",
    ] {
    guard kube([
        "-n",
        ns,
        "get",
        kind,
        if kind == "pvc" {
          name + "-state"
        } else {
          name
        },
        "--ignore-not-found",
        "-o",
        "name",
      ])
      .trim()
      .is_empty() else {
      fail("Load environment already exists; do not overwrite")
    }
  }
  @fs.mkdir(root, permission=0o700)
  let source = @json.parse(
    kube(["-n", ns, "get", "deployment", "moontown-platform", "-o", "json"]),
  )
  @fs.write_file(
    root + "/formal-reference.json",
    source.stringify(),
    permission=0o600,
  )
  guard source
    is { "spec": { "template": { "spec": Object(pod), .. }, .. }, .. } &&
    pod.get("containers") is Some(Array([Object(container)])) &&
    container.get("image") ==
    Some(
      Json::string(
        "lunanexa-registry.lunanexa-registry.svc.cluster.local:5000/moon/moontown-account-gateway@sha256:62213c1b44971cb81730fb288dcab73477b855833e2572272d4b7dabea2bfff4",
      ),
    ) &&
    container.get("env") is Some(Array(environment)) &&
    container.get("volumeMounts") is Some(Array(mounts)) &&
    pod.get("volumes") is Some(Array(volumes)) else {
    fail("Unexpected qualified runtime")
  }
  let env = environment.filter(item => {
    !(item is { "name": String(value), .. } &&
    value.has_prefix("MOONTOWN_ACTIVITY_"))
  })
  if repeat {
    container["image"] = Json::string(
      "lunanexa-registry.lunanexa-registry.svc.cluster.local:5000/moon/moontown-account-gateway@" +
      runtime,
    )
    guard pod.get("initContainers") is Some(Array([Object(init)])) else {
      fail("Missing UI init container")
    }
    init["image"] = Json::string(
      "lunanexa-registry.lunanexa-registry.svc.cluster.local:5000/moon/moontown-account-ui@" +
      ui,
    )
  }
  for item in env {
    if item is Object(values) &&
      values.get("name") == Some(Json::string("MOONTOWN_CREATIVE_STATE_FILE")) {
      values["value"] = Json::string("/creative/" + event_id + "/state.json")
    }
  }
  container["env"] = Json::array(env)
  container["volumeMounts"] = Json::array(
    mounts.filter(item => {
      !(item is { "name": String(value), .. } &&
      value.has_prefix("activity-program"))
    }),
  )
  let kept = volumes.filter(item => {
    !(item is { "name": String(value), .. } &&
    value.has_prefix("activity-program"))
  })
  for item in kept {
    if item is Object(values) {
      if values.get("name") == Some(Json::string("creative-state")) {
        values["persistentVolumeClaim"] = { "claimName": name + "-state" }
      }
      if values.get("name") == Some(Json::string("creative-config")) {
        values["configMap"] = { "name": name, "defaultMode": 292 }
      }
    }
  }
  pod["volumes"] = Json::array(kept)
  pod["automountServiceAccountToken"] = false
  let cm = @json.parse(
    kube(["-n", ns, "get", "configmap", "moontown-coffee-week01", "-o", "json"]),
  )
  guard cm is { "data": { "event.json": String(raw), .. }, .. } &&
    @json.parse(raw) is Object(config) &&
    config.get("brief") is Some(Object(brief)) else {
    fail("Missing trusted event config")
  }
  let now = @async.now().reinterpret_as_uint64()
  brief["id"] = Json::string(event_id)
  brief["name"] = "20 人并发验收 · 非正式活动"
  brief["scope"] = "独立压测，20个受邀普通账户，各生成一张；不参与正式评奖。"
  brief["deadline_ms"] = Json::string((now + 21600000UL).to_string())
  config["opens_ms"] = Json::string((now - 60000UL).to_string())
  config["voting_opens_ms"] = Json::string((now + 21660000UL).to_string())
  config["voting_closes_ms"] = Json::string((now + 25200000UL).to_string())
  config["awards_ms"] = Json::string((now + 28800000UL).to_string())
  config["event_quota"] = 20
  config["participant_quota"] = 1
  config["voting_mode"] = "builtin"
  guard @json.parse(@fs.read_file(root + "-members.json").text())
    is Array(members) &&
    members.length() == 20 else {
    fail("Need exactly20verifiedusers")
  }
  let participants = members.map(item => {
    guard item is { "account_id": String(id), .. } && id.has_prefix("lunanexa:") else {
      fail("Bad identity")
    }
    Json::string(id)
  })
  guard participants.all(item => participants.count(item) == 1) else {
    fail("Duplicate identity")
  }
  config["participant_account_ids"] = Json::array(participants)
  guard @json.parse(
      @fs.read_file("/home/HwHiAiUser/image-runtime-20261107/members.json").text(),
    )
    is Array(hosts) &&
    hosts.iter().find_first(item => item is { "role": "host", .. })
    is Some({ "account_id": String(host), .. }) else {
    fail("Missing QAhost")
  }
  config["manager_account_ids"] = [Json::string(host)]
  // Read-only qualification preflight; no provider grant or GPU tuning changes.
  let adapter = @json.parse(
    kube([
      "-n", "lunanexa", "get", "configmap", "image-adapter-qualified", "-o", "json",
    ]),
  )
  guard adapter is { "data": { "config.json": String(adapter_raw), .. }, .. } &&
    @json.parse(adapter_raw) is { "maximum_requests": Number(cap, ..), .. } &&
    cap >= 20.0 else {
    fail("Provider cap cannot cover test")
  }
  let adapter_pvc = @json.parse(
    kube(["-n", "lunanexa", "get", "pvc", "image-adapter-state", "-o", "json"]),
  )
  guard adapter_pvc is { "spec": { "volumeName": String(adapter_pv), .. }, .. } else {
    fail("Adapter PVC not bound")
  }
  guard @json.parse(kube(["get", "pv", adapter_pv, "-o", "json"]))
    is {
      "spec": {
        "csi": {
          "volumeAttributes": {
            "server": "192.168.2.175",
            "share": "/data/lunanexa-workspaces",
            "subDir": String(subdir),
            ..
          },
          ..
        },
        ..
      },
      ..
    } &&
    subdir.has_prefix("lunanexa/image-adapter-state/") &&
    !subdir.contains("..") else {
    fail("Unexpected adapter storage")
  }
  let journal = "/data/lunanexa-workspaces/" +
    subdir +
    "/z-image-turbo-v1/jobs.json"
  guard @json.parse(@fs.read_file(journal).text())
    is { "jobs": Array(provider_jobs), .. } &&
    provider_jobs.length() + 20 <= cap.to_int() else {
    fail("Insufficient existing provider allowance for20; no grant expansion")
  }
  println(
    "Existing provider allowance remaining: " +
    (cap.to_int() - provider_jobs.length()).to_string() +
    "; this run capped20",
  )
  let resources : Array[(String, Json)] = [
    (
      "config",
      {
        "apiVersion": "v1",
        "kind": "ConfigMap",
        "metadata": { "name": name, "namespace": ns },
        "data": { "event.json": Json::object(config).stringify() },
      },
    ),
    (
      "pvc",
      {
        "apiVersion": "v1",
        "kind": "PersistentVolumeClaim",
        "metadata": { "name": name + "-state", "namespace": ns },
        "spec": {
          "storageClassName": "lunanexa-workspaces-rwx",
          "accessModes": ["ReadWriteMany"],
          "resources": { "requests": { "storage": "1Gi" } },
        },
      },
    ),
    (
      "deployment",
      {
        "apiVersion": "apps/v1",
        "kind": "Deployment",
        "metadata": { "name": name, "namespace": ns },
        "spec": {
          "replicas": 1,
          "strategy": {
            "type": "RollingUpdate",
            "rollingUpdate": { "maxSurge": 0, "maxUnavailable": 1 },
          },
          "selector": { "matchLabels": { "app": name } },
          "template": {
            "metadata": { "labels": { "app": name } },
            "spec": Json::object(pod),
          },
        },
      },
    ),
    (
      "service",
      {
        "apiVersion": "v1",
        "kind": "Service",
        "metadata": { "name": name, "namespace": ns },
        "spec": {
          "selector": { "app": name },
          "ports": [{ "port": 8082, "targetPort": 8082 }],
        },
      },
    ),
    (
      "rewrite",
      {
        "apiVersion": "traefik.io/v1alpha1",
        "kind": "Middleware",
        "metadata": { "name": name, "namespace": ns },
        "spec": {
          "replacePathRegex": {
            "regex": "^/" + route + "/(.*)",
            "replacement": "/moontown/${1}",
          },
        },
      },
    ),
    (
      "route",
      {
        "apiVersion": "traefik.io/v1alpha1",
        "kind": "IngressRoute",
        "metadata": { "name": name, "namespace": ns },
        "spec": {
          "entryPoints": ["websecure"],
          "tls": { "secretName": "lunanexa-public-suanli-tls" },
          "routes": [
            {
              "kind": "Rule",
              "match": "Host(`suanli.kechuangfuwu.com`) && PathPrefix(`/" +
              route +
              "/`)",
              "priority": 200,
              "middlewares": [{ "name": name }],
              "services": [{ "name": name, "port": 8082 }],
            },
          ],
        },
      },
    ),
    (
      "provider-network",
      {
        "apiVersion": "networking.k8s.io/v1",
        "kind": "NetworkPolicy",
        "metadata": { "name": name, "namespace": "lunanexa" },
        "spec": {
          "podSelector": { "matchLabels": { "app": "image-adapter" } },
          "policyTypes": ["Ingress"],
          "ingress": [
            {
              "from": [
                {
                  "namespaceSelector": {
                    "matchLabels": { "kubernetes.io/metadata.name": ns },
                  },
                  "podSelector": { "matchLabels": { "app": name } },
                },
              ],
              "ports": [{ "protocol": "TCP", "port": 18991 }],
            },
          ],
        },
      },
    ),
  ]
  guard @json.parse(kube(["-n", ns, "get", "networkpolicy", "-o", "json"]))
    is { "items": Array(policies), .. } else {
    fail("Missing policy")
  }
  for policy in policies {
    if policy
      is {
        "metadata": { "name": String(original), .. },
        "spec": Object(spec),
        ..
      } &&
      spec.get("podSelector") ==
      Some(({ "matchLabels": { "app": "moontown-platform" } } : Json)) {
      spec["podSelector"] = { "matchLabels": { "app": name } }
      resources.push(
        (
          "network-" + original,
          {
            "apiVersion": "networking.k8s.io/v1",
            "kind": "NetworkPolicy",
            "metadata": {
              "name": (if sixth {
                "load20-r6-"
              } else if fifth {
                "load20-r5-"
              } else if fourth {
                "load20-r4-"
              } else if third {
                "load20-r3-"
              } else if repeat {
                "load20-r2-"
              } else {
                "load20-"
              }) +
              original,
              "namespace": ns,
            },
            "spec": Json::object(spec),
          },
        ),
      )
    }
  }
  for (label, value) in resources {
    let path = root + "/" + label + ".json"
    @fs.write_file(
      path,
      value.stringify(),
      permission=0o600,
      create_mode=CreateNew,
    )
    println(kube(["create", "-f", path]))
  }
  println(
    "Created isolated bounded20-user instance; existing activities unchanged",
  )
}
