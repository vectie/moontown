///|
import {
  "moonbitlang/async@0.22.4",
  "moonbitlang/async@0.22.4/fs",
  "moonbitlang/async@0.22.4/shell",
  "moonbitlang/core/json",
  "moonbitlang/x@0.5.5/crypto",
}

///|
async fn main {
  let target = "src/ui/coffee-display/assets"
  let source = target + "/group-logo.jpg"
  guard @crypto.bytes_to_hex_string(
      @crypto.sha256(@fs.read_file(source).binary()),
    ) ==
    "a93dd4ddcacb6b8cf66fdaa0d03a3651cd08ab62906ec028619d412745d898d6" else {
    fail("Unexpected original group JPEG")
  }
  // Crop the newer mark from the supplied comparison JPEG; only near-white
  // pixels gain transparency. Blue source pixels are not traced or recolored.
  @shell.Cmd("ffmpeg", [
    "-hide_banner",
    "-loglevel",
    "error",
    "-y",
    "-i",
    source,
    "-vf",
    "crop=196:218:686:76,format=rgba,colorkey=0xffffff:0.20:0.05",
    "-frames:v",
    "1",
    target + "/group-mark-raster-v5.png",
  ]).run()
  let original = @fs.read_file(target + "/banxing-workshop.svg").text()
  guard @crypto.bytes_to_hex_string(
      @crypto.sha256(@fs.read_file(target + "/banxing-workshop.svg").binary()),
    ) ==
    "c77d4c9d73a9ebf507beb77f8c3a82e17555cd00cb9cb73d5b6f78fa4ac92f2c" else {
    fail("Unexpected original coffee lettering")
  }
  let data = original.split(" d=\"").to_array()[1].split("\"").to_array()[0]
  let cup : Array[String] = []
  let glyphs : Array[Array[String]] = [[], [], [], []]
  let bounds : Array[(Double, Double, Double, Double)] = Array::make(
    4,
    (1000.0, 1000.0, 0.0, 0.0),
  )
  for index, contour in data.split("M").to_array() {
    if contour.trim().is_empty() {
      continue
    }
    let path = "M" + contour.to_owned()
    if index <= 10 {
      cup.push(path)
      continue
    }
    let numbers : Array[Double] = []
    for segment in contour.split("Q") {
      for section in segment.split("Z") {
        for token in section.split(",") {
          if !token.trim().is_empty() {
            numbers.push(@json.from_json(@json.parse(token.trim().to_owned())))
          }
        }
      }
    }
    guard numbers.length() % 2 == 0 else {
      fail("Unexpected contour coordinates")
    }
    let mut x0 = 1000.0
    let mut y0 = 1000.0
    let mut x1 = 0.0
    let mut y1 = 0.0
    for i = 0; i < numbers.length(); i = i + 2 {
      x0 = x0.min(numbers[i])
      x1 = x1.max(numbers[i])
      y0 = y0.min(numbers[i + 1])
      y1 = y1.max(numbers[i + 1])
    }
    // Assign whole outlines AND their counters by spatial glyph bounds,
    // rather than moving contour indexes that can be holes in another letter.
    let group = if x0 < 55.0 {
      0
    } else if x0 < 135.0 {
      1
    } else if x0 < 215.0 {
      2
    } else {
      3
    }
    glyphs[group].push(path)
    let (a, b, c, d) = bounds[group]
    bounds[group] = (a.min(x0), b.min(y0), c.max(x1), d.max(y1))
  }
  let parts : Array[String] = []
  parts.push(
    "<path transform=\"translate(0 9) scale(.35)\" d=\"" + cup.join("") + "\"/>",
  )
  for i, glyph in glyphs {
    guard !glyph.is_empty() else { fail("Missing original coffee glyph") }
    let (x0, _, x1, y1) = bounds[i]
    let scale = 0.8
    let x = 108.0 +
      i.to_double() * 54.0 -
      x0 * scale +
      (54.0 - (x1 - x0) * scale) / 2.0
    let y = 64.0 - y1 * scale
    parts.push(
      "<path transform=\"translate(\{x} \{y}) scale(\{scale})\" d=\"" +
      glyph.join("") +
      "\"/>",
    )
  }
  let temporary = @fs.tmpdir(prefix="coffee-wordmark-raster-")
  defer @shell.Cmd("rm", ["-r", temporary]).run()
  let svg = temporary + "/coffee.svg"
  @fs.write_file(
    svg,
    "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 328 80\" width=\"1312\" height=\"320\"><g fill=\"#000\" fill-rule=\"evenodd\">" +
    parts.join("") +
    "</g></svg>",
    create_mode=CreateNew,
  )
  @shell.Cmd("sips", [
    "-s",
    "format",
    "png",
    svg,
    "--out",
    target + "/banxing-single-line-v5.png",
  ]).run()
  println(
    "Prepared original JPEG white-to-alpha mark and intact single-line coffee lettering.",
  )
}
