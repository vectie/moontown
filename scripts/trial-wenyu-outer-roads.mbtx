///|
import {
  "moonbitlang/core/env",
  "moonbitlang/x@0.4.50/fs",
  "moonbitlang/core/json",
  "moonbitlang/core/math",
}

///|
struct P {
  x : Double
  y : Double
} derive(ToJson, FromJson, Eq, Debug)

///|
struct Geo {
  lon : Double
  lat : Double
} derive(FromJson, ToJson)

///|
struct SourceWay {
  geometryWgs84 : Array[Geo]
  osmWayId : Double
  nodes : Array[Double]
  pathGrid : Array[P]
  tags : Map[String, String]
} derive(FromJson)

///|
struct Source {
  ways : Array[SourceWay]
} derive(FromJson)

///|
struct Labels {
  rows : Array[String]
} derive(FromJson)

///|
fn grade(way : SourceWay, key : String) -> Bool {
  match way.tags.get(key) {
    None | Some("no" | "false" | "0" | "") => false
    _ => true
  }
}

///|
fn project(p : P) -> P {
  let w = 1.0 + 0.01 * ((p.x - 256) / 256 - p.y / 144)
  { x: 256 + (p.x - 256) / w, y: p.y / w, }
}

///|

///|
fn distance(a : P, b : P) -> Double {
  ((a.x - b.x) * (a.x - b.x) + (a.y - b.y) * (a.y - b.y)).sqrt()
}

///|
fn kind(w : SourceWay) -> String {
  if grade(w, "bridge") {
    "bridge"
  } else if grade(w, "tunnel") {
    "tunnel"
  } else if grade(w, "ford") {
    "ford"
  } else {
    "surface"
  }
}

///|
fn minor(w : SourceWay) -> Bool {
  ["footway", "path", "steps", "cycleway", "track", "pedestrian"].contains(
    w.tags.get("highway").unwrap_or(""),
  )
}

///|
fn rounded(x : Double) -> Double {
  (x * 10000).round() / 10000
}

///|
fn slab(a : Double, d : Double, lo : Double, hi : Double) -> (Double, Double) {
  if d == 0 {
    if a >= lo && a < hi {
      (0, 1)
    } else {
      (1, 0)
    }
  } else {
    let t = (lo - a) / d
    let u = (hi - a) / d
    (t.min(u).max(0), t.max(u).min(1))
  }
}

///|
// Exact interval union on a segment. pad=0 measures the centerline; half the
// SVG stroke width is a conservative square envelope for the round-stroked road.
fn intervals(
  a : P,
  b : P,
  water : Array[Bool],
  pad : Double,
) -> Array[(Double, Double)] {
  let hit : Array[(Double, Double)] = []
  let x0 = (a.x.min(b.x) - pad).floor().to_int().max(0)
  let x1 = (a.x.max(b.x) + pad).floor().to_int().min(255)
  let y0 = (a.y.min(b.y) - pad).floor().to_int().max(0)
  let y1 = (a.y.max(b.y) + pad).floor().to_int().min(143)
  for y in y0..<=y1 {
    let (v, w) = slab(
      a.y,
      b.y - a.y,
      y.to_double() - pad,
      y.to_double() + 1 + pad,
    )
    if w <= v {
      continue
    }
    for x in x0..<=x1 {
      if !water[y * 256 + x] {
        continue
      }
      let (l, h) = slab(
        a.x,
        b.x - a.x,
        x.to_double() - pad,
        x.to_double() + 1 + pad,
      )
      let lo = l.max(v)
      let hi = h.min(w)
      if hi > lo {
        hit.push((lo, hi))
      }
    }
  }
  hit.sort_by((a, b) => a.0.compare(b.0))
  let merged : Array[(Double, Double)] = []
  for (lo, hi) in hit {
    let n = merged.length()
    if n > 0 && lo <= merged[n - 1].1 {
      merged[n - 1] = (merged[n - 1].0, hi.max(merged[n - 1].1))
    } else {
      merged.push((lo, hi))
    }
  }
  merged
}

///|
fn measure(a : P, b : P, water : Array[Bool], pad : Double) -> Double {
  intervals(a, b, water, pad).fold(init=0.0, (v, h) => v + h.1 - h.0) *
  distance(a, b)
}

///|
fn mix(a : P, b : P, t : Double) -> P {
  { x: a.x + (b.x - a.x) * t, y: a.y + (b.y - a.y) * t, }
}

///|
struct Fit {
  mode : String
  origin : P
  shift : P
  axis : P
  drop : Double
  isotropic : Double
  uniform : Bool
} derive(ToJson, FromJson, Debug)

///|
// Both principal scales are positive and at most one. No rotation or shear.
fn Fit::at(f : Fit, p : P) -> P {
  let dx = p.x - f.origin.x
  let dy = p.y - f.origin.y
  let v = (dx * f.axis.x + dy * f.axis.y) * f.drop
  {
    x: p.x +
    f.shift.x -
    f.isotropic * dx -
    (if f.uniform { f.drop * dx } else { v * f.axis.x }),
    y: p.y +
    f.shift.y -
    f.isotropic * dy -
    (if f.uniform { f.drop * dy } else { v * f.axis.y }),
  }
}

///|
fn snap(p : P) -> P {
  { x: rounded(p.x), y: rounded(p.y), }
}

///|
fn minus(a : P, b : P) -> P {
  { x: a.x - b.x, y: a.y - b.y, }
}

///|
fn dot(a : P, b : P) -> Double {
  a.x * b.x + a.y * b.y
}

///|
fn det(a : P, b : P) -> Double {
  a.x * b.y - a.y * b.x
}

///|
fn unit(v : P) -> P {
  let d = dot(v, v).sqrt()
  { x: v.x / d, y: v.y / d, }
}

///|
fn near(a : P, b : P, c : P, d : P, pad : Double) -> Bool {
  a.x.min(b.x) <= c.x.max(d.x) + pad &&
  a.x.max(b.x) + pad >= c.x.min(d.x) &&
  a.y.min(b.y) <= c.y.max(d.y) + pad &&
  a.y.max(b.y) + pad >= c.y.min(d.y)
}

///|
// Quantize at SVG precision first. Ignore genuine endpoint meetings; compare
// proper crossings per pair of logical ways, including crossings over decks.
fn crosses(a : P, b : P, c : P, d : P) -> Bool {
  if !near(a, b, c, d, 0) {
    return false
  }
  let ab = minus(b, a)
  let cd = minus(d, c)
  det(ab, minus(c, a)) * det(ab, minus(d, a)) < -1.0e-12 &&
  det(cd, minus(a, c)) * det(cd, minus(b, c)) < -1.0e-12
}

///|
fn internal_touch(a : P, b : P, c : P, d : P) -> Bool {
  if a == b || c == d || !near(a, b, c, d, 0) {
    return false
  }
  let within = (p : P, q : P, r : P) => {
    det(minus(q, p), minus(r, p)).abs() < 0.000000001 &&
    dot(minus(r, p), minus(r, q)) < -0.000000001
  }
  within(a, b, c) ||
  within(a, b, d) ||
  within(c, d, a) ||
  within(c, d, b) ||
  (a == c && b == d) ||
  (a == d && b == c)
}

///|
struct PriorPlacement {
  fit : Fit
  dikeWet : Double
} derive(FromJson)

///|
struct PriorVariant {
  placement : PriorPlacement
} derive(FromJson)

///|
struct Prior {
  ways : Array[Double]
  beforeSafeExploratory : Array[PriorVariant]
} derive(FromJson)

///|
struct Bounds {
  lo : P
  hi : P
}

///|
fn bounds(ps : Array[P]) -> Bounds {
  let mut x = ps[0].x
  let mut y = ps[0].y
  let mut xx = x
  let mut yy = y
  for p in ps {
    x = x.min(p.x)
    xx = xx.max(p.x)
    y = y.min(p.y)
    yy = yy.max(p.y)
  }
  { lo: { x, y, }, hi: { x: xx, y: yy, }, }
}

///|
struct Road {
  id : Double
  name : String
  highway : String
  structure : Bool
  nodes : Array[Double]
  ps : Array[P]
  box : Bounds
  pad : Double
  inner : Bool
  eligible : Bool
}

///|
struct Pair {
  a : Int32
  b : Int32
  edges : Array[(Int32, Int32)]
  original : Int32
}

///|
struct Socket {
  node : Double
  p : P
  owners : Array[Int32]
  around : Array[(Int32, Int32)]
  deck : Array[P]
}

///|
struct Net {
  routing : Map[Double, Array[(Int32, Int32)]]
  roads : Array[Road]
  pairs : Array[Pair]
  sockets : Array[Socket]
  fits : Array[Fit]
  polylines : Map[(Int32, Int32), Array[P]]
  interactions : Map[(Int32, Int32, Int32), (Int32, Int32)]
  water : Array[Bool]
  wet_cache : Map[(Int32, Int32), Double]
}

///|
fn Net::points(net : Net, r : Int32, k : Int32) -> Array[P] {
  net.polylines.get_or_init((r, k), () => {
    net.roads[r].ps.map(p => snap(net.fits[k].at(p)))
  })
}

///|
fn Net::wet(net : Net, r : Int32, k : Int32) -> Double {
  net.wet_cache.get_or_init((r, k), () => {
    let ps = net.points(r, k)
    let mut sum = 0.0
    for i in 1..<ps.length() {
      sum += measure(ps[i - 1], ps[i], net.water, net.roads[r].pad)
    }
    sum
  })
}

///|
fn load_net(town~ : Bool = false) -> Net raise {
  let prior : Prior = @json.from_json(
    @json.parse(
      @fs.read_file_to_string("docs/project/wenyu-left-dike-group-trial.json"),
    ),
  )
  let bold = prior.beforeSafeExploratory[2].placement
  assert_eq(bold.dikeWet, 0)
  let inner : Set[Double] = Set(prior.ways)
  let source : Source = @json.from_json(
    @json.parse(
      @fs.read_file_to_string("docs/project/wenyu-lower-perspective.json"),
    ),
  )
  let labels : Labels = @json.from_json(
    @json.parse(
      @fs.read_file_to_string(
        "src/ui/assets/tilemap/wenyu_reference_labels.json",
      ),
    ),
  )
  let overrides : Map[String, P] = @json.from_json(
    @json.parse(
      @fs.read_file_to_string("docs/project/wenyu-bank-node-overrides.json"),
    ),
  )
  let all = source.ways.map(w => {
    let ps = w.nodes.mapi((i, n) => {
      overrides.get(n.to_string()).unwrap_or(project(w.pathGrid[i]))
    })
    Road::{
      id: w.osmWayId,
      name: w.tags.get("name").unwrap_or(""),
      highway: w.tags.get("highway").unwrap_or(""),
      structure: kind(w) != "surface",
      nodes: w.nodes,
      ps,
      box: bounds(ps),
      pad: if minor(w) {
        0.045
      } else {
        0.12
      },
      inner: inner.contains(w.osmWayId),
      eligible: false,
    }
  })
  let footprint : Array[P] = []
  for r in all {
    if r.inner {
      for p in r.ps {
        footprint.push(p)
      }
    }
  }
  let base = bounds(footprint)
  // A second halo covers contacts of outer ways with streets that stay outside the search.
  let broad : Set[Double] = Set([])
  if town {
    let audit = @json.parse(
      @fs.read_file_to_string("docs/project/wenyu-bank-surface-audit.json"),
    )
    if audit is { "unresolvedSurfaceWays": Array(rs), .. } {
      for r in rs {
        if r is { "way": Number(id, ..), "surfaceWet": Number(w, ..), .. } &&
          w >= 1.0 {
          broad.add(id)
        }
      }
    }
    let nodes : Set[Double] = Set([])
    for r in all {
      if broad.contains(r.id) {
        for n in r.nodes {
          nodes.add(n)
        }
      }
    }
    for r in all {
      if !r.structure && r.nodes.any(n => nodes.contains(n)) {
        broad.add(r.id)
      }
    }
  }
  let roads = all
    .filter(r => town || near(r.box.lo, r.box.hi, base.lo, base.hi, 25))
    .map(r => {
      ..r,
      eligible: !r.inner &&
      !r.structure &&
      (r.ps.all(p => near(p, p, base.lo, base.hi, 14)) || broad.contains(r.id)),
    })
  let pairs : Array[Pair] = []
  let owners : Map[Double, Array[Int32]] = Map([])
  let pos : Map[Double, P] = Map([])
  for i, r in roads {
    for j, n in r.nodes {
      let ns = owners.get_or_init(n, () => [])
      if !ns.contains(i) {
        ns.push(i)
      }
      pos[n] = r.ps[j]
    }
    for k in 0..<i {
      let s = roads[k]
      if !(r.inner || r.eligible || s.inner || s.eligible) ||
        !near(r.box.lo, r.box.hi, s.box.lo, s.box.hi, 10.01) {
        continue
      }
      let edges : Array[(Int32, Int32)] = []
      let mut original = 0
      for h in 1..<r.ps.length() {
        let a = snap(r.ps[h - 1])
        let b = snap(r.ps[h])
        if !near(a, b, s.box.lo, s.box.hi, 10.01) {
          continue
        }
        for j in 1..<s.ps.length() {
          let c = snap(s.ps[j - 1])
          let d = snap(s.ps[j])
          if near(a, b, c, d, 10.01) {
            edges.push((h, j))
            if crosses(a, b, c, d) {
              original += 1
            }
          }
        }
      }
      if !edges.is_empty() {
        pairs.push({ a: i, b: k, edges, original, })
      }
    }
  }
  let sockets : Array[Socket] = []
  for n, rs in owners {
    if rs.length() < 2 || !rs.any(i => roads[i].inner || roads[i].eligible) {
      continue
    }
    let p = pos[n]
    let around : Array[(Int32, Int32)] = []
    for i, r in roads {
      if near(p, p, r.box.lo, r.box.hi, 10.01) {
        for j in 1..<r.ps.length() {
          if near(p, p, r.ps[j - 1], r.ps[j], 10.01) {
            around.push((i, j))
          }
        }
      }
    }
    let deck : Array[P] = []
    for i in rs {
      let r = roads[i]
      if !r.structure {
        continue
      }
      let j = r.nodes.search_by(id => id == n).unwrap()
      deck.push(unit(minus(p, r.ps[if j == 0 { 1 } else { j - 1 }])))
    }
    sockets.push({ node: n, p, owners: rs, around, deck, })
  }
  sockets.sort_by((a, b) => a.node.compare(b.node))
  let z = P::{ x: 0, y: 0, }
  let neutral : Fit = {
    mode: "fixed",
    origin: z,
    shift: z,
    axis: { x: 1, y: 0, },
    drop: 0,
    isotropic: 0,
    uniform: false,
  }
  {
    roads,
    pairs,
    sockets,
    fits: [neutral, bold.fit],
    polylines: Map([]),
    interactions: Map([]),
    water: Array::makei(256 * 144, i => {
      labels.rows[i / 256][i % 256] is ('r' | 'l')
    }),
    wet_cache: Map([]),
    routing: Map([]),
  }
}

///|
fn Net::road_diff(
  net : Net,
  pi : Int32,
  ka : Int32,
  kb : Int32,
) -> (Int32, Int32) {
  if ka == kb {
    return (0, 0)
  }
  net.interactions.get_or_init((pi, ka, kb), () => {
    let pair = net.pairs[pi]
    let ra = net.roads[pair.a]
    let rb = net.roads[pair.b]
    let a = net.points(pair.a, ka)
    let b = net.points(pair.b, kb)
    let u = net.points(pair.a, 0)
    let v = net.points(pair.b, 0)
    let mut cross = 0
    let mut touches = 0
    for (i, j) in pair.edges {
      let p = a[i - 1]
      let q = a[i]
      let s = b[j - 1]
      let t = b[j]
      if !near(p, q, s, t, 0) {
        continue
      }
      if crosses(p, q, s, t) {
        cross += 1
      } else if (
          internal_touch(p, q, s, t) &&
          !internal_touch(u[i - 1], u[i], v[j - 1], v[j])
        ) ||
        (ra.nodes[i - 1] != rb.nodes[j - 1] && p == s && u[i - 1] != v[j - 1]) ||
        (ra.nodes[i - 1] != rb.nodes[j] && p == t && u[i - 1] != v[j]) ||
        (ra.nodes[i] != rb.nodes[j - 1] && q == s && u[i] != v[j - 1]) ||
        (ra.nodes[i] != rb.nodes[j] && q == t && u[i] != v[j]) {
        touches += 1
      }
    }
    let delta = cross - pair.original
    (delta.max(0) + touches, (-delta).max(0))
  })
}

///|
struct Link {
  socket : Int32
  a : P
  b : P
  from_fit : Int32
  to_fit : Int32
  pad : Double
}

///|
struct Issue {
  key : String
  roads : Array[Int32]
  n : Int32
  lost : Bool
  at : P
} derive(ToJson)

///|
struct Score {
  added : Int32
  lost : Int32
  bridges_ok : Bool
  waterChange : Double
  tieWet : Double
  travel : Double
} derive(ToJson, Debug)

///|
fn evaluate(
  net : Net,
  m : Array[Int32],
  events~ : Array[Issue]? = None,
  links_out~ : Array[Link]? = None,
) -> Score {
  let mut added = 0
  let mut lost = 0
  let mut bridges_ok = true
  let links : Array[Link] = []
  let mut tie_wet = 0.0
  let mut delta_wet = 0.0
  let mut travel = 0.0
  for i, r in net.roads {
    if r.inner && m[i] != 1 {
      delta_wet += net.wet(i, m[i]) - net.wet(i, 1)
    }
    if m[i] != 0 && !r.inner && !r.structure {
      delta_wet += net.wet(i, m[i]) - net.wet(i, 0)
      travel += distance(net.fits[m[i]].at(r.ps[0]), r.ps[0]) +
        distance(net.fits[m[i]].at(r.ps.last().unwrap()), r.ps.last().unwrap())
    }
  }
  for pi, pair in net.pairs {
    let ka = m[pair.a]
    let kb = m[pair.b]
    if ka == kb {
      continue
    }
    let (n, l) = net.road_diff(pi, ka, kb)
    added += n
    lost += l
    if (l > 0 || n > 0) && events is Some(ev) {
      let ar = net.roads[pair.a]
      let br = net.roads[pair.b]
      let (plus, minus) = difference_points(net, pair, ka, kb)
      for (points, is_lost) in [(plus, false), (minus, true)] {
        for point in points {
          ev.push({
            key: "r/\{ar.id}/\{br.id}/\{is_lost}",
            roads: [pair.a, pair.b],
            n: 1,
            lost: is_lost,
            at: point,
          })
        }
      }
    }
  }
  for si, s in net.sockets {
    let first = m[s.owners[0]]
    if s.owners.all(i => m[i] == first) {
      continue
    }
    let ks : Array[Int32] = []
    for i in s.owners {
      if !ks.contains(m[i]) {
        ks.push(m[i])
      }
    }
    // A physical deck owns its socket. Else use the incident road position
    // with the shortest total tie length, breaking ties in OSM input order.
    let anchor = if !s.deck.is_empty() {
      m[s.owners[s.owners.search_by(i => net.roads[i].structure).unwrap()]]
    } else {
      let mut best = ks[0]
      let mut length = 1.0e20
      for candidate in ks {
        let p = snap(net.fits[candidate].at(s.p))
        let sum = ks.fold(init=0.0, (v, k) => {
          v + distance(p, snap(net.fits[k].at(s.p)))
        })
        if sum < length - 1.0e-8 {
          best = candidate
          length = sum
        }
      }
      best
    }
    let edges = socket_tree(net, m, s, ks, anchor)
    for (from, k) in edges {
      let a = snap(net.fits[from].at(s.p))
      let b = snap(net.fits[k].at(s.p))
      for vec in s.deck {
        if dot(minus(b, a), vec) < distance(a, b) * 0.965925826 - 0.00011 {
          bridges_ok = false
        }
      }
      let apron = s.owners
        .filter(i => {
          m[i] ==
          (if !s.deck.is_empty() {
            anchor
          } else if ks.contains(0) {
            0
          } else {
            anchor
          })
        })
        .fold(init=0.0, (v, i) => v.max(net.roads[i].pad))
      let link : Link = {
        socket: si,
        a,
        b,
        from_fit: from,
        to_fit: k,
        pad: apron,
      }
      tie_wet += measure(a, b, net.water, apron)
      let mut connector = 0
      for (r, j) in s.around {
        let ps = net.points(r, m[r])
        if crosses(a, b, ps[j - 1], ps[j]) ||
          internal_touch(a, b, ps[j - 1], ps[j]) {
          connector += 1
          if events is Some(ev) {
            ev.push({
              key: "j/\{s.node}/\{net.roads[r].id}/\{j}",
              roads: s.owners + [r],
              n: 1,
              lost: false,
              at: contact_point(a, b, ps[j - 1], ps[j]),
            })
          }
        }
      }
      added += connector
      for other in links {
        if crosses(a, b, other.a, other.b) ||
          internal_touch(a, b, other.a, other.b) {
          added += 1
          if events is Some(ev) {
            let t = net.sockets[other.socket]
            ev.push({
              key: "j/\{s.node}/\{t.node}",
              roads: s.owners + t.owners,
              n: 1,
              lost: false,
              at: contact_point(a, b, other.a, other.b),
            })
          }
        }
      }
      links.push(link)
    }
  }
  if links_out is Some(out) {
    for link in links {
      out.push(link)
    }
  }
  { added, lost, bridges_ok, waterChange: delta_wet, tieWet: tie_wet, travel, }
}

///|
fn main raise {
  if !@fs.path_exists("output") {
    @fs.create_dir("output")
  }
  if !@fs.path_exists("output/outer-group-review") {
    @fs.create_dir("output/outer-group-review")
  }
  let town_mode = @env.args() is [_, "--settle-shore" | "--major-review" | "--town-source", _]
  let net = load_net(town=town_mode)
  let state = net.roads.map(r => if r.inner { 1 } else { 0 })
  let events : Array[Issue] = []
  if @env.args() is [_, mode, file] &&
    ["--bank-fit", "--group-fit", "--plan-head"].contains(mode) {
    let baseline = { ..net, routing: Map([]), }
    let prior = "docs/project/wenyu-approach-continuation.json"
    let base = state.copy()
    replay(baseline, base, read_layout(prior))
    load_routes(baseline, prior)
    let previous = evaluate(baseline, base)
    assert_eq((previous.added, previous.lost), (16, 7))
    let saved = read_layout(file)
    replay(net, state, saved)
    load_routes(net, file)
    let dir = "output/wenyu-fixed-heads"
    if !@fs.path_exists(dir) {
      @fs.create_dir(dir)
    }
    let count = if mode == "--plan-head" {
      head_placements(net, state)
    } else if mode == "--bank-fit" {
      coupled_bank(net, state, previous)
    } else {
      improve_road_groups(net, state, previous)
    }
    finish_trial(
      net,
      state,
      previous,
      saved.trials + count,
      reference=base,
      directory=dir,
      reference_net=baseline,
    )
    return
  }
  if @env.args() is [_, "--town-source", file] {
    let saved = read_layout(file)
    replay(net, state, saved)
    load_routes(net, file)
    let links : Array[Link] = []
    let result = evaluate(net,state,links_out=Some(links))
    assert_eq((result.added,result.lost),(saved.after.added,saved.after.lost))
    assert_true(result.bridges_ok)
    let graph = verify_layout(net,state,links)
    export_town_roads(net,state,links,graph)
    return
  }
  if @env.args() is [_, mode, file] && town_mode {
    let dir = "output/wenyu-major-roads"
    if !@fs.path_exists(dir) {
      @fs.create_dir(dir)
    }
    let base = state.copy()
    let before = { ..net, routing: Map([]), }
    let prior = "docs/project/wenyu-approach-continuation.json"
    replay(before, base, read_layout(prior))
    load_routes(before, prior)
    let initial = evaluate(before, base)
    let saved = read_layout(file)
    replay(net, state, saved)
    load_routes(net, file)
    let current = evaluate(net, state)
    println(
      "Town baseline " +
      Json(initial).stringify() +
      "; input " +
      Json(current).stringify(),
    )
    check_shore_intervals()
    assert_eq(
      (current.added, current.lost),
      (saved.after.added, saved.after.lost),
    )
    let runs = if mode == "--settle-shore" {
      let strict = major_corridors(net, state)
      let pinned = pin_streets(net, state)
      let linked = major_corridors(net, state, linked=true)
      strict + pinned + linked
    } else {
      0
    }
    finish_trial(
      net,
      state,
      initial,
      saved.trials + runs,
      reference=base,
      directory=dir,
      reference_net=before,
    )
    town_water_board(net, before, state, base, dir)
    return
  }
  if @env.args() is [_, "--constraints"] {
    let d = net.roads.search_by(r => r.id == 47518902).unwrap()
    if !@fs.path_exists("output/wenyu-fixed-heads") {
      @fs.create_dir("output/wenyu-fixed-heads")
    }
    let relations : Array[Json] = []
    for pair in net.pairs {
      let a = net.roads[pair.a]
      let b = net.roads[pair.b]
      if pair.original > 0 &&
        ((a.inner && b.structure) || (a.structure && b.inner)) {
        let core = if a.inner { a } else { b }
        let deck = if a.inner { b } else { a }
        relations.push({
          "way": core.id,
          "deck": deck.id,
          "line": Json(core.ps),
          "span": Json(deck.ps.map(snap)),
        })
      }
    }
    let a = net.sockets[net.sockets.search_by(s => s.node == 605039789).unwrap()]
    let b = net.sockets[net.sockets
      .search_by(s => s.node == 3351127195)
      .unwrap()]
    let doc : Json = {
      "water": Json(net.water),
      "line": Json(net.roads[d].ps),
      "goals": Json(relations),
      "a": Json(a.p),
      "b": Json(b.p),
      "va": Json(a.deck[0]),
      "vb": Json(b.deck[0]),
      "plan": Json(plan_qinbei(net).shift),
    }
    @fs.write_string_to_file(
      "output/wenyu-fixed-heads/constraints.json",
      doc.stringify(),
    )
    return
  }
  let start = evaluate(net, state, events=Some(events))
  println(
    "Start \{Json(start).stringify()} local ways \{net.roads.length()} / pairs \{net.pairs.length()} / sockets \{net.sockets.length()}",
  )
  let totals : Map[Int32, Int32] = Map([])
  for e in events {
    for i in e.roads {
      if !net.roads[i].inner {
        totals[i] = totals.get(i).unwrap_or(0) + e.n
      }
    }
  }
  let ranked = totals.keys().collect()
  ranked.sort_by((a, b) => totals[b].compare(totals[a]))
  for i in ranked {
    let r = net.roads[i]
    println(
      "\{r.id} \{r.name} \{r.highway} eligible=\{r.eligible} deck=\{r.structure} events \{totals[i]}",
    )
  }
  assert_eq(start.added, 64)
  assert_eq(start.lost, 10)
  if @env.args() is [_, mode, file] &&
    [
      "--review", "--refine", "--polish", "--continue", "--compare", "--approach-fit",
      "--approach-review",
    ].contains(mode) {
    let saved = read_layout(file)
    replay(net, state, saved)
    load_routes(net, file)
    let s = evaluate(net, state)
    if mode == "--approach-fit" || mode == "--approach-review" {
      check_joint_solver()
      check_junction_math()
      let base = state.copy()
      replay(
        net,
        base,
        read_layout("docs/project/wenyu-junction-fit-trial.json"),
      )
      let initial = evaluate({ ..net, routing: Map([]), }, base)
      assert_eq((initial.added, initial.lost), (18, 7))
      assert_eq((s.added, s.lost), (saved.after.added, saved.after.lost))
      let directory = "output/wenyu-approach-pass"
      if !@fs.path_exists(directory) {
        @fs.create_dir(directory)
      }
      let mut runs = 0
      if mode == "--approach-fit" {
        runs += neighbourhood_search(net, state, initial)
        runs += optimize_trees(net, state, initial)
        runs += fit_streets(net, state, initial)
        runs += compact_seams(net, state, initial)
        for limit in [12, 12, 28] {
          runs += escape_pass(net, state, initial, limit)
          runs += compact_seams(net, state, initial)
        }
        runs += sweep_neighbours(net, state, initial)
        runs += fit_contacts(net, state, initial)
        runs += compact_seams(net, state, initial)
      }
      finish_trial(
        net,
        state,
        initial,
        saved.trials + runs,
        reference=base,
        directory~,
      )
    } else if mode == "--continue" || mode == "--compare" {
      check_junction_math()
      let base = state.copy()
      replay(net, base, read_layout("docs/project/wenyu-outer-road-trial.json"))
      let previous = evaluate(net, base)
      assert_eq((previous.added, previous.lost), (25, 8))
      assert_eq((s.added, s.lost), (saved.after.added, saved.after.lost))
      let dir = "output/wenyu-next-pass"
      if !@fs.path_exists(dir) {
        @fs.create_dir(dir)
      }
      let mut count = 0
      if mode == "--continue" {
        count += optimize_junctions(net, state, previous)
        count += district_fit(net, state, previous)
        count += fit_deck_windows(net, state, previous)
        count += fit_contacts(net, state, previous)
        count += district_fit(net, state, previous)
        count += optimize_junctions(net, state, previous)
        count += sweep_neighbours(net, state, previous)
        count += fuse_districts(net, state, previous)
        count += fit_contacts(net, state, previous)
      }
      finish_trial(
        net,
        state,
        previous,
        saved.trials + count,
        reference=base,
        directory=dir,
      )
    } else if mode == "--review" {
      assert_eq(s.added, saved.after.added)
      assert_eq(s.lost, saved.after.lost)
      finish_trial(net, state, start, saved.trials)
    } else if mode == "--polish" {
      let t = tune_cohorts(net, state, start) +
        refit_core(net, state, start) +
        simplify(net, state, start)
      finish_trial(net, state, start, saved.trials + t)
    } else {
      search_outer(net, state, start, prior=saved.trials)
    }
  } else {
    search_outer(net, state, start)
  }
}

///|
fn prefer(s : Score, b : Score) -> Bool {
  if !s.bridges_ok {
    return false
  }
  let a = s.added + s.lost
  let n = b.added + b.lost
  if a != n {
    return a < n
  }
  if s.lost != b.lost {
    return s.lost < b.lost
  }
  if (s.waterChange + s.tieWet - b.waterChange - b.tieWet).abs() > 0.0001 {
    return s.waterChange + s.tieWet < b.waterChange + b.tieWet
  }
  s.travel < b.travel - 0.0001
}

///|
fn add_fit(net : Net, f : Fit) -> Int32 {
  let k = net.fits.length()
  net.fits.push(f)
  k
}

///|
fn proposals(
  net : Net,
  group : Array[Int32],
  phase : Int32,
  common : Array[Int32],
) -> Array[Int32] {
  let ids = common.copy()
  if phase == 0 {
    return ids
  }
  let all : Array[P] = []
  for r in group {
    for p in net.roads[r].ps {
      all.push(p)
    }
  }
  let ext = bounds(all)
  let center = mix(ext.lo, ext.hi, 0.5)
  let first = net.roads[group[0]]
  let pins = [first.ps[0], first.ps.last().unwrap(), center]
  for s in net.sockets {
    if !s.deck.is_empty() &&
      s.owners.any(r => group.contains(r)) &&
      !pins.contains(s.p) {
      pins.push(s.p)
    }
  }
  for origin in pins {
    for deg in [-75, -45, -20, 0, 35, 65, 90] {
      let t = deg.to_double() * 3.141592653589793 / 180
      for k in [0.035, 0.09] {
        let f = {
          ..net.fits[0],
          mode: "outer-compression",
          origin,
          drop: k,
          axis: { x: @math.cos(t), y: @math.sin(t), },
        }
        ids.push(add_fit(net, f))
      }
    }
  }
  return ids
}

///|
fn groups_for(
  net : Net,
  state : Array[Int32],
  phase : Int32,
) -> Array[Array[Int32]] {
  let ev : Array[Issue] = []
  ignore(evaluate(net, state, events=Some(ev)))
  let scores : Map[Int32, Int32] = Map([])
  for v in ev {
    for id in v.roads {
      if net.roads[id].eligible {
        scores[id] = scores.get(id).unwrap_or(0) + v.n
      }
    }
  }
  let active = scores.keys().collect()
  active.sort_by((a, b) => {
    if scores[a] == scores[b] {
      a.compare(b)
    } else {
      scores[b].compare(scores[a])
    }
  })
  let groups : Array[Array[Int32]] = []
  fn add(ids : Array[Int32]) -> Unit {
    let s = Set(ids).to_array()
    s.sort()
    if !s.is_empty() && !groups.contains(s) {
      groups.push(s)
    }
  }
  for i in active {
    let r = net.roads[i]
    let named = active.filter(j => r.name != "" && net.roads[j].name == r.name)
    add(named)
    add([i])
    if phase < 2 {
      let near_ways = active.filter(j => {
        net.roads[j].nodes.any(n => r.nodes.contains(n))
      })
      add(near_ways)
      for j in near_ways {
        if i != j {
          add([i, j])
        }
      }
      let local_named = net.roads
        .mapi((ix, s) => {
          if s.eligible &&
            s.name != "" &&
            s.name == r.name &&
            near(r.box.lo, r.box.hi, s.box.lo, s.box.hi, 2) {
            ix
          } else {
            -1
          }
        })
        .filter(ix => ix >= 0)
      add(local_named)
    }
  }
  return groups
}

///|
fn search_outer(
  net : Net,
  state : Array[Int32],
  start : Score,
  prior~ : Int32 = 0,
) -> Unit raise {
  let common = [0, 1]
  let z = net.fits[0]
  let inner = net.fits[1]
  for a in [0.2, 0.5, 0.8] {
    common.push(
      add_fit(net, {
        ..inner,
        mode: "partial-fit",
        drop: inner.drop * a,
        shift: { x: inner.shift.x * a, y: inner.shift.y * a, },
      }),
    )
  }
  for deg in [-150, -110, -75, -45, -25, 0, 25, 65, 100, 155] {
    let t = deg.to_double() * 3.141592653589793 / 180
    for v in [0.32, 1.15, 2.55, 3.8] {
      common.push(
        add_fit(net, {
          ..z,
          mode: "outer-translation",
          shift: { x: v * @math.cos(t), y: v * @math.sin(t), },
        }),
      )
    }
  }
  let mut best = evaluate(net, state)
  let mut tries = prior
  for
    phase in (if prior > 0 {
      [0, 4, 3, 2, 4, 3, 2]
    } else {
      [0, 0, 1, 2, 4, 3, 2, 4, 3, 2]
    }) {
    if phase == 4 {
      tries += target_cuts(net, state, start)
      best = evaluate(net, state)
      save_layout(net, state, start, tries)
    }
    if phase == 3 {
      tries += refit_core(net, state, start)
      best = evaluate(net, state)
      save_layout(net, state, start, tries)
    }
    if phase <= 1 {
      for alpha in common[1:] {
        let base = state.copy()
        for seam in [0.0, 0.35, 1.0, 3.0] {
          for inertia in [0.12, 0.7] {
            let trial = cut_groups(net, base, alpha, seam, inertia)
            if trial == base {
              continue
            }
            let s = evaluate(net, trial)
            tries += 1
            if s.waterChange + s.tieWet <= start.tieWet + 4 && prefer(s, best) {
              best = s
              for i, k in trial {
                state[i] = k
              }
              println(
                "Joint cut \{alpha} \{seam} -> \{best.added}/\{best.lost} surface delta \{s.waterChange+s.tieWet-start.tieWet}",
              )
            }
          }
        }
        if net.interactions.length() > 180000 {
          net.interactions.clear()
        }
      }
      save_layout(net, state, start, tries)
    }
    let groups = groups_for(net, state, phase)
    for ids in groups {
      let original = ids.map(i => state[i])
      let mut selected = -1
      let options = proposals(net, ids, phase, common)
      for k in options {
        if original.all(i => i == k) {
          continue
        }
        if ids.any(i => {
            net.roads[i].ps.any(p => distance(p, net.fits[k].at(p)) > 5.0001)
          }) {
          continue
        }
        if ids.any(i => net.wet(i, 0) < 0.00001 && net.wet(i, k) > 0.00001) {
          continue
        }
        for i in ids {
          state[i] = k
        }
        let s = evaluate(net, state)
        tries += 1
        if s.waterChange + s.tieWet <= start.tieWet + 4 && prefer(s, best) {
          selected = k
          best = s
        }
      }
      if selected >= 0 {
        for i in ids {
          state[i] = selected
        }
        println(
          "Phase \{phase} ways \{Json(ids.map(i=>net.roads[i].id)).stringify()} -> \{best.added}/\{best.lost}",
        )
      } else {
        for h, i in ids {
          state[i] = original[h]
        }
      }
      if net.interactions.length() > 120000 {
        net.interactions.clear()
      }
    }
    println("Pass \{phase} trials \{tries}, \{Json(best).stringify()}")
    save_layout(net, state, start, tries)
  }
  tries += tune_cohorts(net, state, start) + simplify(net, state, start)
  finish_trial(net, state, start, tries)
}

///|
fn save_layout(
  net : Net,
  state : Array[Int32],
  start : Score,
  tries : Int32,
) -> Unit raise {
  let ev : Array[Issue] = []
  let score = evaluate(net, state, events=Some(ev))
  let first = net.roads.search_by(r => r.inner).unwrap()
  let data : Json = {
    "before": Json(start),
    "after": Json(score),
    "trials": tries,
    "coreFit": Json(net.fits[state[first]]),
    "outer": Json(
      net.roads
      .mapi((i, r) => (i, r))
      .filter(t => !t.1.inner && state[t.0] != 0)
      .map(t => {
        Json::object({
          "way": Json(t.1.id),
          "name": Json(t.1.name),
          "fit": Json(net.fits[state[t.0]]),
        })
      }),
    ),
    "events": Json(
      ev.map(e => {
        Json::object({
          "key": Json(e.key),
          "ways": Json(e.roads.map(i => net.roads[i].id)),
          "count": Json(e.n),
          "lost": Json(e.lost),
          "at": Json(e.at),
        })
      }),
    ),
  }
  @fs.write_string_to_file(
    "output/outer-group-review/result.json",
    data.stringify(indent=2),
  )
}

///|
// Directed s-t cut for whole-way candidate groups. Crossing costs are
// asymmetric: moving the east carriageway differs from moving its neighbour.
struct Arc {
  to : Int32
  rev : Int32
  mut cap : Double
}

///|
struct Cut {
  g : Array[Array[Arc]]
}

///|
fn Cut::edge(c : Cut, a : Int32, b : Int32, cap : Double) -> Unit {
  if cap <= 0.0000001 {
    return
  }
  let ra = c.g[a].length()
  let rb = c.g[b].length()
  c.g[a].push({ to: b, rev: rb, cap, })
  c.g[b].push({ to: a, rev: ra, cap: 0, })
}

///|
fn Cut::labels(c : Cut, src : Int32, sink : Int32) -> Array[Bool] {
  let n = c.g.length()
  for ;; {
    let d = Array::make(n, -1)
    d[src] = 0
    let q = [src]
    let mut j = 0
    while j < q.length() {
      let u = q[j]
      j += 1
      for e in c.g[u] {
        if e.cap > 0.0000001 && d[e.to] < 0 {
          d[e.to] = d[u] + 1
          q.push(e.to)
        }
      }
    }
    if d[sink] < 0 {
      return d.map(i => i >= 0)
    }
    let next = Array::make(n, 0)
    fn send(u : Int32, limit : Double) -> Double {
      if u == sink {
        return limit
      }
      while next[u] < c.g[u].length() {
        let e = c.g[u][next[u]]
        if e.cap > 0.0000001 && d[e.to] == d[u] + 1 {
          let delta = send(e.to, limit.min(e.cap))
          if delta > 0.0000001 {
            e.cap -= delta
            c.g[e.to][e.rev].cap += delta
            return delta
          }
        }
        next[u] += 1
      }
      0
    }
    while send(src, 1.0e10) > 0.0000001 {

    }
  }
}

///|
fn cut_groups(
  net : Net,
  m : Array[Int32],
  alpha : Int32,
  seam : Double,
  inertia : Double,
  force~ : Array[Int32] = [],
) -> Array[Int32] {
  let n = net.roads.length()
  let src = n
  let sink = n + 1
  let inf = 1.0e6
  let cut : Cut = {
    g: Array::makei(n + 2 + net.sockets.length() * 2, _ => []),
  }
  let f = net.fits[alpha]
  let ok = net.roads.mapi((i, r) => {
    r.eligible &&
    (
      m[i] == alpha ||
      (
        r.ps.all(p => distance(f.at(p), p) <= 5.000001) &&
        !(net.wet(i, 0) < 0.00001 && net.wet(i, alpha) > 0.00001)
      )
    )
  })
  for s in net.sockets {
    if !s.deck.is_empty() {
      let a = snap(s.p)
      let b = snap(f.at(s.p))
      if s.deck.any(v => {
          dot(minus(b, a), v) < distance(a, b) * 0.965925826 - 0.00011
        }) {
        for i in s.owners {
          ok[i] = false
        }
      }
    }
  }
  for i, r in net.roads {
    if m[i] == alpha {
      cut.edge(src, i, inf)
    } else if !ok[i] {
      cut.edge(i, sink, inf)
    } else {
      let change = net.wet(i, alpha) - net.wet(i, m[i])
      cut.edge(i, sink, inertia + change.max(0) * 0.4)
      if r.inner {
        abort("unfixed core")
      }
    }
  }
  let cost = (v : (Int32, Int32)) => v.0.to_double() + v.1.to_double() * 1.2
  for r in force {
    if ok[r] {
      cut.edge(src, r, inf)
    }
  }
  for pi, p in net.pairs {
    if !ok[p.a] && !ok[p.b] {
      continue
    }
    let aa = m[p.a]
    let bb = m[p.b]
    if !ok[p.a] {
      let old = cost(net.road_diff(pi, aa, bb))
      let new_cost = cost(net.road_diff(pi, aa, alpha))
      cut.edge(src, p.b, (old - new_cost).max(0))
      cut.edge(p.b, sink, (new_cost - old).max(0))
      continue
    }
    if !ok[p.b] {
      let old = cost(net.road_diff(pi, aa, bb))
      let new_cost = cost(net.road_diff(pi, alpha, bb))
      cut.edge(src, p.a, (old - new_cost).max(0))
      cut.edge(p.a, sink, (new_cost - old).max(0))
      continue
    }
    let c00 = cost(net.road_diff(pi, aa, bb))
    let c10 = cost(net.road_diff(pi, alpha, bb))
    let c01 = cost(net.road_diff(pi, aa, alpha))
    // E(0,0)=c00, E(1,0)=c10, E(0,1)=c01, E(1,1)=0.
    let ua = -c01
    let ub = c01 - c00
    cut.edge(src, p.a, (-ua).max(0))
    cut.edge(p.a, sink, ua.max(0))
    cut.edge(src, p.b, (-ub).max(0))
    cut.edge(p.b, sink, ub.max(0))
    cut.edge(p.a, p.b, (c10 + c01 - c00).max(0))
  }
  for i, s in net.sockets {
    if !s.owners.any(id => ok[id]) {
      continue
    }
    let a = snap(s.p)
    let b = snap(f.at(s.p))
    if a == b {
      continue
    }
    let enter = n + 2 + 2 * i
    let exit = enter + 1
    let mut hits = 0
    for (r, j) in s.around {
      let ps = net.points(r, m[r])
      if crosses(a, b, ps[j - 1], ps[j]) ||
        internal_touch(a, b, ps[j - 1], ps[j]) {
        hits += 1
      }
    }
    let fee = seam * (0.3 + 0.08 * distance(a, b) + hits.to_double())
    cut.edge(enter, exit, fee)
    for r in s.owners {
      cut.edge(r, enter, inf)
      cut.edge(exit, r, inf)
    }
  }
  let selected = cut.labels(src, sink)
  return m.mapi((i, k) => if ok[i] && selected[i] { alpha } else { k })
}

///|
fn refit_core(net : Net, state : Array[Int32], start : Score) -> Int32 {
  let d = net.roads.search_by(r => r.id == 47518902).unwrap()
  let group = net.roads
    .mapi((i, r) => if r.inner { i } else { -1 })
    .filter(i => i >= 0)
  let ha = net.sockets[net.sockets.search_by(s => s.node == 605039789).unwrap()]
  let hb = net.sockets[net.sockets.search_by(s => s.node == 3351127195).unwrap()]
  let a = ha.p
  let b = hb.p
  let u = ha.deck[0]
  let v = hb.deck[0]
  let candidates : Array[Fit] = []
  let zero = net.fits[0]
  let diff = minus(b, a)
  // Translation plus orthogonal contraction; solve for translations whose
  // two head connectors remain on or close to the surveyed deck axes.
  for ang in 0..<90 {
    let rad = ang.to_double() * 3.141592653589793 / 90
    let axis = P::{ x: @math.cos(rad), y: @math.sin(rad), }
    for t in 0..<=34 {
      let k = t.to_double() / 400
      for iso in [0.0, 0.008, 0.022, 0.035] {
        let bend = P::{
          x: -k * dot(diff, axis) * axis.x - iso * diff.x,
          y: -k * dot(diff, axis) * axis.y - iso * diff.y,
        }
        let da = -det(bend, v) / det(u, v)
        if da < 0 || da > 5.4 {
          continue
        }
        let f : Fit = {
          ..zero,
          mode: "zero-shore-refit",
          origin: a,
          axis,
          drop: k,
          isotropic: iso,
          shift: { x: da * u.x, y: da * u.y, },
        }
        candidates.push(f)
      }
    }
  }
  let old = state.copy()
  let mut best = evaluate(net, state)
  let mut tries = 0
  let mut best_fit = state[d]
  let mut min_missing = best.lost
  let mut loss_fit = best_fit
  let mut loss_score = best
  fn sweep(fs : Array[Fit]) -> Unit {
    for f in fs {
      let sa = minus(f.at(a), a)
      let sb = minus(f.at(b), b)
      if dot(sa, u) < 0.965925826 * distance(f.at(a), a) - 0.00005 ||
        dot(sb, v) < 0.965925826 * distance(f.at(b), b) - 0.00005 ||
        distance(f.at(a), a) > 5 ||
        distance(f.at(b), b) > 5 ||
        measure(snap(a), snap(f.at(a)), net.water, 0.12) > 0.0000001 {
        continue
      }
      if net.roads[d].ps.any(p => distance(f.at(p), p) > 5) {
        continue
      }
      let line = net.roads[d].ps.map(p => snap(f.at(p)))
      if (for i in 1..<line.length() {
          if measure(line[i - 1], line[i], net.water, 0.12) > 0.00000001 {
            break true
          }
        } nobreak {
          false
        }) {
        continue
      }
      if group.any(i => net.roads[i].ps.any(p => distance(f.at(p), p) > 5)) {
        continue
      }
      let k = add_fit(net, f)
      for i in group {
        state[i] = k
      }
      let s = evaluate(net, state)
      tries += 1
      if s.bridges_ok && s.waterChange + s.tieWet <= start.tieWet + 4 {
        min_missing = min_missing.min(s.lost)
        if s.lost < loss_score.lost ||
          (s.lost == loss_score.lost && prefer(s, loss_score)) {
          loss_fit = k
          loss_score = s
        }
      }
      if s.waterChange + s.tieWet <= start.tieWet + 4 && prefer(s, best) {
        best = s
        best_fit = k
      }
      if net.interactions.length() > 200000 {
        net.interactions.clear()
      }
      if net.polylines.length() > 80000 {
        net.polylines.clear()
      }
    }
  }
  sweep(candidates)
  let varied : Array[Fit] = []
  for i in 1..<=100000 {
    let r = 4.2 * radical(i, 2) + 0.8
    let direction = (radical(i, 3) - 0.5) * 0.5235987756
    let t = radical(i, 5) * 3.141592653589793
    let axis = P::{ x: @math.cos(t), y: @math.sin(t), }
    varied.push({
      ..zero,
      mode: "zero-shore-affine",
      origin: a,
      axis,
      drop: radical(i, 7) * 0.10,
      isotropic: radical(i, 11) * 0.045,
      shift: {
        x: r * (u.x * @math.cos(direction) - u.y * @math.sin(direction)),
        y: r * (u.x * @math.sin(direction) + u.y * @math.cos(direction)),
      },
    })
  }
  sweep(varied)
  // Explore the neighbourhood of both objectives: the minimum total and the
  // most recovered deck crossings need not be at the same parameters.
  for amplitude in [1.0, 0.5, 0.2, 0.09] {
    let fs : Array[Fit] = []
    for seed in [loss_fit, best_fit] {
      let f = net.fits[seed]
      for j in 1..<=4000 {
        let t = (radical(j, 2) - 0.5) * 0.55 * amplitude
        let k = f.drop + (radical(j, 3) - 0.5) * 0.045 * amplitude
        let iso = f.isotropic + (radical(j, 5) - 0.5) * 0.012 * amplitude
        if iso < 0 || k < 0 {
          continue
        }
        fs.push({
          ..f,
          drop: k,
          isotropic: iso,
          axis: {
            x: f.axis.x * @math.cos(t) - f.axis.y * @math.sin(t),
            y: f.axis.x * @math.sin(t) + f.axis.y * @math.cos(t),
          },
          shift: {
            x: f.shift.x + (radical(j, 7) - 0.5) * 1.2 * amplitude,
            y: f.shift.y + (radical(j, 11) - 0.5) * 1.2 * amplitude,
          },
        })
      }
    }
    sweep(fs)
  }
  for level in [1.0, 0.35, 0.12] {
    let f = net.fits[best_fit]
    let fs : Array[Fit] = []
    for ai in -2..<=2 {
      for di in -1..<=1 {
        for si in -1..<=1 {
          for x in -2..<=2 {
            for y in -2..<=2 {
              let t = ai.to_double() * 3.141592653589793 / 180 * level * 3
              let k = f.drop + di.to_double() * 0.006 * level
              let iso = f.isotropic + si.to_double() * 0.002 * level
              if k < 0 || iso < 0 {
                continue
              }
              fs.push({
                ..f,
                axis: {
                  x: f.axis.x * @math.cos(t) - f.axis.y * @math.sin(t),
                  y: f.axis.x * @math.sin(t) + f.axis.y * @math.cos(t),
                },
                drop: k,
                isotropic: iso,
                shift: {
                  x: f.shift.x + x.to_double() * 0.20 * level,
                  y: f.shift.y + y.to_double() * 0.20 * level,
                },
              })
            }
          }
        }
      }
    }
    sweep(fs)
  }
  for i, k in old {
    state[i] = if net.roads[i].inner { best_fit } else { k }
  }
  println(
    "Zero-shore recheck \{tries}: \{best.added}/\{best.lost}; fewest missing in connected trials \{min_missing}",
  )
  return tries
}

///|
fn radical(i : Int32, base : Int32) -> Double {
  let mut n = i
  let mut w = 1.0
  let mut x = 0.0
  while n > 0 {
    w /= base.to_double()
    x += (n % base).to_double() * w
    n = n / base
  }
  x
}

///|
fn target_cuts(net : Net, state : Array[Int32], start : Score) -> Int32 {
  let ev : Array[Issue] = []
  let mut best = evaluate(net, state, events=Some(ev))
  let ranks : Map[Int32, Int32] = Map([])
  for e in ev {
    for i in e.roads {
      if net.roads[i].eligible {
        ranks[i] = ranks.get(i).unwrap_or(0) + e.n
      }
    }
  }
  let order = ranks.keys().collect()
  order.sort_by((a, b) => {
    if ranks[b] == ranks[a] {
      a.compare(b)
    } else {
      ranks[b].compare(ranks[a])
    }
  })
  let mut tries = 0
  for focus in order {
    if ranks[focus] < 2 {
      continue
    }
    let r = net.roads[focus]
    let peers = order.filter(j => {
      r.name != "" &&
      net.roads[j].name == r.name &&
      near(r.box.lo, r.box.hi, net.roads[j].box.lo, net.roads[j].box.hi, 3)
    })
    let subjects = if peers.is_empty() { [focus] } else { peers }
    let subject = Set(subjects)
    let watch = net.pairs
      .mapi((ix, p) => {
        if (subject.contains(p.a) && net.roads[p.b].inner) ||
          (subject.contains(p.b) && net.roads[p.a].inner) {
          ix
        } else {
          -1
        }
      })
      .filter(ix => ix >= 0)
    let anchors = [r.ps[0], r.ps.last().unwrap(), mix(r.box.lo, r.box.hi, 0.5)]
    for s in net.sockets {
      if s.owners.contains(focus) &&
        (!s.deck.is_empty() || s.owners.length() >= 3) &&
        !anchors.contains(s.p) {
        anchors.push(s.p)
      }
    }
    let pool : Array[(Double, Int32)] = []
    for a in anchors {
      for deg in [-80, -55, -36, -20, 0, 22, 45, 70, 90] {
        let rad = deg.to_double() * 3.141592653589793 / 180
        let axis : P = { x: @math.cos(rad), y: @math.sin(rad), }
        for scale in [0.035, 0.085, 0.15] {
          for slide in [0.0, 0.8, 2.25, 3.4] {
            let f : Fit = {
              ..net.fits[0],
              mode: "outer-group",
              origin: a,
              axis,
              drop: scale,
              shift: { x: slide * 0.88, y: -slide * 0.475, },
            }
            if r.ps.any(p => distance(f.at(p), p) > 5) {
              continue
            }
            let k = add_fit(net, f)
            let mut value = 0.0
            for ix in watch {
              let p = net.pairs[ix]
              let (n, l) = net.road_diff(
                ix,
                if subject.contains(p.a) {
                  k
                } else {
                  state[p.a]
                },
                if subject.contains(p.b) {
                  k
                } else {
                  state[p.b]
                },
              )
              value += n.to_double() + l.to_double()
            }
            let c = f.at(r.ps[0])
            value += 0.01 *
              (
                distance(c, r.ps[0]) +
                distance(f.at(r.ps.last().unwrap()), r.ps.last().unwrap())
              )
            pool.push((value, k))
          }
        }
      }
    }
    pool.sort_by((a, b) => a.0.compare(b.0))
    let used : Array[Fit] = []
    for (_, k) in pool {
      let f = net.fits[k]
      if used.any(g => {
          distance(f.at(r.ps[0]), g.at(r.ps[0])) +
          distance(f.at(r.ps.last().unwrap()), g.at(r.ps.last().unwrap())) <
          0.8
        }) {
        continue
      }
      used.push(f)
      for seam in [0.1, 0.8, 2.2] {
        for force in [[], [focus], subjects] {
          let trial = cut_groups(net, state, k, seam, 0.25, force~)
          let s = evaluate(net, trial)
          tries += 1
          if prefer(s, best) && s.waterChange + s.tieWet <= start.tieWet + 4 {
            best = s
            for i, t in trial {
              state[i] = t
            }
            println("Target \{r.id} \{best.added}/\{best.lost}")
          }
        }
      }
      if used.length() >= 10 {
        break
      }
    }
    if net.interactions.length() > 150000 {
      net.interactions.clear()
    }
    if net.polylines.length() > 60000 {
      net.polylines.clear()
    }
  }
  return tries
}

///|
fn contact_point(a : P, b : P, c : P, d : P) -> P {
  let div = det(minus(b, a), minus(d, c))
  if div.abs() > 1.0e-10 {
    return mix(a, b, (det(minus(c, a), minus(d, c)) / div).clamp(min=0, max=1))
  }
  let hits = [a, b, c, d].filter(p => {
    near(p, p, a, b, 0.00001) && near(p, p, c, d, 0.00001)
  })
  if hits.is_empty() {
    mix(a, b, 0.5)
  } else {
    mix(hits[0], hits.last().unwrap(), 0.5)
  }
}

///|
fn difference_points(
  net : Net,
  pair : Pair,
  ka : Int32,
  kb : Int32,
) -> (Array[P], Array[P]) {
  let before : Array[P] = []
  let now : Array[P] = []
  let touches : Array[P] = []
  let a = net.points(pair.a, ka)
  let b = net.points(pair.b, kb)
  let u = net.points(pair.a, 0)
  let v = net.points(pair.b, 0)
  let ra = net.roads[pair.a]
  let rb = net.roads[pair.b]
  for (i, j) in pair.edges {
    let p = a[i - 1]
    let q = a[i]
    let s = b[j - 1]
    let t = b[j]
    if crosses(u[i - 1], u[i], v[j - 1], v[j]) {
      before.push(contact_point(u[i - 1], u[i], v[j - 1], v[j]))
    }
    if crosses(p, q, s, t) {
      now.push(contact_point(p, q, s, t))
    } else if (
        internal_touch(p, q, s, t) &&
        !internal_touch(u[i - 1], u[i], v[j - 1], v[j])
      ) ||
      (ra.nodes[i - 1] != rb.nodes[j - 1] && p == s && u[i - 1] != v[j - 1]) ||
      (ra.nodes[i - 1] != rb.nodes[j] && p == t && u[i - 1] != v[j]) ||
      (ra.nodes[i] != rb.nodes[j - 1] && q == s && u[i] != v[j - 1]) ||
      (ra.nodes[i] != rb.nodes[j] && q == t && u[i] != v[j]) {
      touches.push(contact_point(p, q, s, t))
    }
  }
  while !before.is_empty() && !now.is_empty() {
    let mut best = 1.0e20
    let mut bi = 0
    let mut ni = 0
    for i, p in before {
      for j, q in now {
        let d = distance(p, q)
        if d < best {
          best = d
          bi = i
          ni = j
        }
      }
    }
    ignore(before.remove(bi))
    ignore(now.remove(ni))
  }
  (now + touches, before)
}

///|
struct SavedOuter {
  way : Double
  fit : Fit
} derive(FromJson)

///|
struct SavedScore {
  added : Int32
  lost : Int32
} derive(FromJson)

///|
struct Saved {
  coreFit : Fit
  outer : Array[SavedOuter]
  trials : Int32
  after : SavedScore
} derive(FromJson)

///|
struct FitGroup {
  fit : Fit
  ways : Array[Double]
} derive(FromJson)

///|
struct AuditLayout {
  coreFit : Fit
  outerGroups : Array[FitGroup]
  candidateEvaluations : Int32
  after : SavedScore
} derive(FromJson)

///|
fn replay(net : Net, state : Array[Int32], saved : Saved) -> Unit raise {
  let ids : Map[String, Int32] = Map([])
  for i, f in net.fits {
    ids[Json(f).stringify()] = i
  }
  let key = (f : Fit) => {
    ids.get_or_init(Json(f).stringify(), () => add_fit(net, f))
  }
  let active = key(saved.coreFit)
  for i, r in net.roads {
    state[i] = if r.inner { active } else { 0 }
  }
  for item in saved.outer {
    let i = net.roads.search_by(r => r.id == item.way).unwrap()
    if net.roads[i].structure {
      assert_true(
        net.roads[i].id == 47518657 &&
        Json(item.fit).stringify() == Json(plan_qinbei(net)).stringify(),
      )
    } else {
      assert_true(net.roads[i].eligible)
    }
    state[i] = key(item.fit)
  }
}

///|
fn finish_trial(
  net : Net,
  state : Array[Int32],
  start : Score,
  tries : Int32,
  reference? : Array[Int32],
  reference_net? : Net,
  directory~ : String = "output/outer-group-review",
) -> Unit raise {
  let base = match reference {
    Some(m) => m
    None => net.roads.map(r => if r.inner { 1 } else { 0 })
  }
  let before : Array[Issue] = []
  let after : Array[Issue] = []
  let before_links : Array[Link] = []
  let after_links : Array[Link] = []
  let baseline_net = reference_net.unwrap_or({ ..net, routing: Map([]), })
  let initial = evaluate(
    baseline_net,
    base,
    events=Some(before),
    links_out=Some(before_links),
  )
  let best = evaluate(
    net,
    state,
    events=Some(after),
    links_out=Some(after_links),
  )
  verify_crossings(baseline_net, base, before_links, initial)
  verify_crossings(net, state, after_links, best)
  assert_eq((initial.added, initial.lost), (start.added, start.lost))
  assert_true(best.bridges_ok)
  let d = net.roads.search_by(r => r.id == 47518902).unwrap()
  let core = state[d]
  let restored = verify_layout(net, state, after_links)
  let inner_wet = net.roads
    .mapi((i, r) => if r.inner { net.wet(i, core) } else { 0.0 })
    .fold(init=0.0, (s, w) => s + w)
  let dike_wet = net.wet(d, core) +
    after_links
    .filter(l => net.sockets[l.socket].node == 605039789)
    .fold(init=0.0, (s, l) => s + measure(l.a, l.b, net.water, l.pad))
  assert_eq(dike_wet, 0)
  let hist = (es : Array[Issue], lost : Bool) => {
    let m : Map[String, Int32] = Map([])
    for e in es {
      if e.lost == lost {
        m[e.key] = m.get(e.key).unwrap_or(0) + e.n
      }
    }
    m
  }
  let debt = (lost : Bool) => {
    let b = hist(before, lost)
    let a = hist(after, lost)
    let mut remaining = 0
    for key, n in b {
      remaining += n.min(a.get(key).unwrap_or(0))
    }
    let n = b.values().fold(init=0, (s, v) => s + v)
    let m = a.values().fold(init=0, (s, v) => s + v)
    (n, m, remaining, n - remaining, m - remaining)
  }
  let (nb, na, still, cleared, new_) = debt(false)
  let (lb, la, still_lost, recovered, new_loss) = debt(true)
  assert_eq((nb, na, lb, la), (start.added, best.added, start.lost, best.lost))
  let recovered_pairs : Array[Json] = []
  let remaining_losses = hist(after, true)
  for e in before {
    if !e.lost {
      continue
    }
    let remaining = remaining_losses.get(e.key).unwrap_or(0)
    if remaining > 0 {
      remaining_losses[e.key] = remaining - 1
      continue
    }
    recovered_pairs.push({
      "ways": Json(e.roads.map(i => net.roads[i].id)),
      "names": Json(e.roads.map(i => net.roads[i].name)),
    })
  }
  let groups : Map[Int32, Array[Double]] = Map([])
  let mut w0 = 0.0
  let mut w1 = 0.0
  let mut max_move = 0.0
  let mut changed_ways = 0
  let mut step_travel = 0.0
  for i, r in net.roads {
    if !r.inner && !r.structure && (state[i] != 0 || base[i] != 0) {
      w0 += net.wet(i, base[i])
      w1 += net.wet(i, state[i])
      let then = net.points(i, base[i])
      let now = net.points(i, state[i])
      if then != now {
        changed_ways += 1
        for n in 0..<now.length() {
          step_travel = step_travel.max(distance(then[n], now[n]))
        }
      }
    }
    if !r.inner && state[i] != 0 {
      groups.get_or_init(state[i], () => []).push(r.id)
      for p in r.ps {
        max_move = max_move.max(distance(p, net.fits[state[i]].at(p)))
      }
    }
  }
  assert_true(max_move <= 5.0001)
  let report : Json = {
    "schema": "moontown.wenyu-outer-road-trial.v1",
    "before": Json(initial),
    "after": Json(best),
    "candidateEvaluations": tries,
    "persistingOriginalConflicts": still,
    "originalConflictsRemoved": cleared,
    "newConflicts": new_,
    "originalMissingStillMissing": still_lost,
    "originalCrossingsRecovered": recovered,
    "recoveredRoadPairs": Json(recovered_pairs),
    "newMissingCrossings": new_loss,
    "deckCrossingsOnAdjacentApproaches": adjacent_approaches(net, after),
    "dikeWetIncludingEntry": dike_wet,
    "coreRoadsWet": inner_wet,
    "originalCoreWet": net.roads
    .mapi((i, r) => if r.inner { net.wet(i, base[i]) } else { 0.0 })
    .fold(init=0.0, (a, b) => a + b),
    "movedOuterWetBefore": w0,
    "movedOuterWetAfter": w1,
    "outerMaximumDisplacement": max_move,
    "outerWaysChangedSinceComparison": changed_ways,
    "maxOuterChangeSinceComparison": step_travel,
    "coreFit": Json(net.fits[core]),
    "graph": restored,
    "outerGroups": Json(
      groups
      .keys()
      .collect()
      .map(k => {
        Json::object({ "fit": Json(net.fits[k]), "ways": Json(groups[k]) })
      }),
    ),
    "beforeMarkers": Json(
      before.map(e => {
        Json::object({
          "key": Json(e.key),
          "lost": Json(e.lost),
          "point": Json(e.at),
        })
      }),
    ),
    "afterMarkers": Json(
      after.map(e => {
        Json::object({
          "key": Json(e.key),
          "lost": Json(e.lost),
          "point": Json(e.at),
        })
      }),
    ),
  }
  if report is Object(fields) &&
    (
      directory == "output/wenyu-approach-pass" ||
      directory == "output/wenyu-fixed-heads" ||
      directory == "output/wenyu-major-roads"
    ) {
    fields["junctionTrees"] = Json(
      net.routing
      .keys()
      .collect()
      .map(node => {
        Json::object({
          "node": Json(node),
          "betweenWays": Json(
            net.routing[node].map(pair => {
              [net.roads[pair.0].id, net.roads[pair.1].id]
            }),
          ),
        })
      }),
    )
    fields["beforeBoundaryLinks"] = Json(before_links.length())
    fields["beforeBoundaryLength"] = Json(
      before_links.fold(init=0.0, (total, l) => total + distance(l.a, l.b)),
    )
    fields["afterBoundaryLength"] = Json(
      after_links.fold(init=0.0, (total, l) => total + distance(l.a, l.b)),
    )
    fields["deckCrossingsOnBridgeheadLinks"] = Json(
      bridgehead_crossings(net, state, after, after_links),
    )
  }
  @fs.write_string_to_file(
    directory + "/audit.json",
    report.stringify(indent=2),
  )
  if reference is None {
    save_layout(net, state, start, tries)
  }
  println(
    "Original conflicts cleared \{cleared}, retained \{still}, new \{new_}; original crossings recovered \{recovered}, newly missing \{new_loss}.",
  )
  draw_outer(
    net,
    base,
    state,
    before,
    after,
    before_links,
    after_links,
    reference_net=baseline_net,
    directory~,
  )
}

///|
fn verify_layout(
  net : Net,
  state : Array[Int32],
  links : Array[Link],
) -> Json raise {
  let d = net.roads.search_by(r => r.id == 47518902).unwrap()
  let inner = state[d]
  let mut n = 0
  let mut max_gap = 0.0
  let mut bridge = 0
  let mut outer = 0
  for i, r in net.roads {
    let k = state[i]
    if r.structure && k != 0 {
      assert_true(
        r.id == 47518657 &&
        Json(net.fits[k]).stringify() == Json(plan_qinbei(net)).stringify(),
      )
    }
    if r.inner {
      assert_eq(k, inner)
    }
    if !r.inner && !r.structure && k != 0 {
      outer += 1
      assert_true(r.eligible)
      if net.wet(i, 0) <= 0.000001 {
        assert_true(net.wet(i, k) <= 0.00001)
      }
    }
    let f = net.fits[k]
    assert_true(f.drop >= 0 && f.isotropic >= 0 && f.drop + f.isotropic < 1)
    if k != 0 {
      assert_eq(net.points(i, k).length(), r.nodes.length())
      for j in 1..<r.ps.length() {
        let a = r.ps[j - 1]
        let b = r.ps[j]
        assert_true(distance(f.at(a), f.at(b)) <= distance(a, b) + 1.0e-7)
        assert_true(
          distance(f.at(mix(a, b, 0.5)), mix(f.at(a), f.at(b), 0.5)) < 1.0e-7,
        )
      }
    }
  }
  for si, s in net.sockets {
    if s.owners.all(i => state[i] == 0) {
      continue
    }
    let points : Array[P] = []
    for r in s.owners {
      let way = net.roads[r]
      let idx = way.nodes.search_by(id => id == s.node).unwrap()
      let p = net.points(r, state[r])[idx]
      if !points.contains(p) {
        points.push(p)
      }
    }
    let seen = [points[0]]
    let edges = links.filter(l => l.socket == si)
    for l in edges {
      let e1 = distance(snap(net.fits[l.from_fit].at(s.p)), l.a)
      let e2 = distance(snap(net.fits[l.to_fit].at(s.p)), l.b)
      max_gap = max_gap.max(e1).max(e2)
      assert_true(points.contains(l.a) && points.contains(l.b))
    }
    for ;; {
      let old = seen.length()
      for l in edges {
        if seen.contains(l.a) && !seen.contains(l.b) {
          seen.push(l.b)
        }
        if seen.contains(l.b) && !seen.contains(l.a) {
          seen.push(l.a)
        }
      }
      if seen.length() == old {
        break
      }
    }
    assert_eq(seen.length(), points.length())
    n += 1
    if !s.deck.is_empty() {
      bridge += 1
    }
  }
  assert_eq(max_gap, 0)
  assert_eq(net.roads[d].nodes.length(), 63)
  {
    "checkedJunctions": n,
    "junctionsAtStructures": bridge,
    "boundaryLinks": links.length(),
    "maxEndpointGap": max_gap,
    "outerWaysMoved": outer,
  }
}

///|
fn view_pt(p : P) -> P {
  { x: (p.x + p.y) * 0.7071067811865476, y: (p.y - p.x) * 0.7071067811865476, }
}

///|
fn path(ps : Array[P]) -> String {
  let buf = StringBuilder()
  for i, p in ps {
    buf.write_string("\{if i==0{"M"}else{"L"}}\{rounded(p.x)},\{rounded(p.y)}")
  }
  buf.to_string()
}

///|
fn draw_outer(
  net : Net,
  base : Array[Int32],
  after : Array[Int32],
  before_issues : Array[Issue],
  after_issues : Array[Issue],
  old_links : Array[Link],
  new_links : Array[Link],
  reference_net~ : Net,
  directory~ : String = "output/outer-group-review",
) -> Unit raise {
  let d = net.roads.search_by(r => r.id == 47518902).unwrap()
  let all = (net.points(d, base[d]) + net.points(d, after[d])).map(view_pt)
  let b = bounds(all)
  let x = b.lo.x - 4
  let y = b.lo.y - 7
  let w = b.hi.x - x + 4
  let h = b.hi.y - y + 5
  let panel = (960.0 * h / w).ceil().to_int()
  let show_bridge = directory != "output/outer-group-review" &&
    before_issues.any(e => e.lost && !after_issues.any(v => v.key == e.key))
  let head_marks = if directory == "output/wenyu-approach-pass" {
    [
      bridgehead_crossings(net, base, before_issues, old_links),
      bridgehead_crossings(net, after, after_issues, new_links),
    ]
  } else {
    [[], []]
  }
  let head_focus = if head_marks[1].is_empty() {
    None
  } else {
    Some(head_marks[1][0])
  }
  let height = 245 +
    panel * 2 +
    176 +
    (if show_bridge { 208 } else { 0 }) +
    (if head_focus is Some(_) { 208 } else { 0 })
  let mut bridge_focus : P? = None
  let extra_legend = if show_bridge {
    "　<tspan fill='#227768'>● 恢复的原交叉</tspan>"
  } else {
    ""
  }
  let out = StringBuilder()
  out.write_string(
    "<svg xmlns='http://www.w3.org/2000/svg' width='1016' height='\{height}' viewBox='0 0 1016 \{height}'><title>温榆河左堤路 · 外围路网校正试验</title><rect width='1016' height='\{height}' fill='#f9f7f0'/><g font-family='system-ui,sans-serif' fill='#203d34'><text x='28' y='39' font-size='24' font-weight='650'>温榆河左堤路 · 外围路网</text><text x='988' y='38' font-size='14' text-anchor='end'>两版堤路压水均为 0 格</text><text x='28' y='67' font-size='14' fill='#52645c'>墨绿 左堤路　赭色 参与调整的外围道路　紫线 桥面</text><text x='988' y='67' text-anchor='end' font-size='14'><tspan fill='#ae4135'>× 新增交叉或接触</tspan>　<tspan fill='#6947a6'>○ 消失的原交叉</tspan>\{extra_legend}</text><defs><g id='ground' shape-rendering='crispEdges'>",
  )
  let labels : Labels = @json.from_json(
    @json.parse(
      @fs.read_file_to_string(
        "src/ui/assets/tilemap/wenyu_reference_labels.json",
      ),
    ),
  )
  for yy in 0..<144 {
    let mut xx = 0
    while xx < 256 {
      let start = xx
      let c = labels.rows[yy][xx]
      xx += 1
      while xx < 256 && labels.rows[yy][xx] == c {
        xx += 1
      }
      let fill = match c {
        'r' | 'l' => "#98ccd5"
        'w' => "#cbded2"
        'G' => "#d8e3c9"
        'b' => "#bfd3d4"
        _ => "#eaeadd"
      }
      out.write_string(
        "<rect x='\{start}' y='\{yy}' width='\{xx-start}' height='1' fill='\{fill}'/>",
      )
    }
  }
  out.write_string("</g>")
  let locations = [before_issues, after_issues]
  let states = [base, after]
  let score_before = evaluate(reference_net, base)
  let score_after = evaluate(net, after)
  let scores = [score_before, score_after]
  for k, m in states {
    out.write_string(
      "<g id='roads\{k}' stroke-linejoin='round' fill='none'><use href='#ground'/>",
    )
    for layer in 0..<5 {
      for i, r in net.roads {
        let typ = if i == d {
          4
        } else if r.structure {
          3
        } else if r.inner {
          2
        } else if net.points(i, base[i]) != net.points(i, after[i]) {
          1
        } else {
          0
        }
        if layer != typ {
          continue
        }
        let color = ["#bdc4b7", "#ac773f", "#608d73", "#81758f", "#195e50"][typ]
        let width = if typ == 4 {
          0.36
        } else if typ == 3 {
          0.25
        } else if r.pad < 0.1 {
          0.085
        } else {
          0.155
        }
        out.write_string(
          "<path d='\{path(net.points(i,m[i]))}' stroke='\{color}' stroke-width='\{width}'/>",
        )
      }
    }
    for l in (if k == 0 { old_links } else { new_links }) {
      let at_head = head_marks[k].any(hit => {
        net.sockets[l.socket].node == hit.junction &&
        point_edge(hit.point, l.a, l.b) < 0.0002
      })
      let color = if at_head { "#cf792f" } else { "#a37941" }
      out.write_string(
        "<path d='\{path([l.a,l.b])}' stroke='\{color}' stroke-width='.14'/>",
      )
    }
    out.write_string("</g>")
    for detail in [false, true] {
      let scale = if detail { 0.35 } else { 1.0 }
      let id = if detail { "detail" } else { "scene" }
      out.write_string("<g id='\{id}\{k}' fill='none'><use href='#roads\{k}'/>")
      if k == 1 {
        for e in before_issues {
          if !e.lost || after_issues.any(issue => issue.key == e.key) {
            continue
          }
          let a = net.points(e.roads[0], m[e.roads[0]])
          let b = net.points(e.roads[1], m[e.roads[1]])
          let mut nearest = e.at
          let mut dist = 1.0e20
          for i in 1..<a.length() {
            for j in 1..<b.length() {
              if crosses(a[i - 1], a[i], b[j - 1], b[j]) {
                let q = contact_point(a[i - 1], a[i], b[j - 1], b[j])
                if distance(q, e.at) < dist {
                  nearest = q
                  dist = distance(q, e.at)
                }
              }
            }
          }
          assert_true(dist < 1.0e20)
          if bridge_focus is None {
            bridge_focus = Some(mix(nearest, e.at, 0.5))
          }
          out.write_string(
            "<circle cx='\{nearest.x}' cy='\{nearest.y}' r='\{scale*0.56}' fill='#227768' stroke='#fffaf0' stroke-width='\{scale*0.16}'><title>恢复的原交叉 · \{e.key}</title></circle>",
          )
        }
      }
      for e in locations[k] {
        let p = e.at
        let size = scale * 0.41
        if e.lost {
          out.write_string(
            "<circle cx='\{p.x}' cy='\{p.y}' r='\{scale*0.54}' stroke='#684b9f' stroke-width='\{scale*0.20}'><title>\{e.key}</title></circle>",
          )
        } else {
          out.write_string(
            "<path d='M\{p.x-size},\{p.y}h\{2.0*size}M\{p.x},\{p.y-size}v\{2.0*size}' stroke='#b74439' stroke-width='\{scale*0.17}'><title>\{e.key}</title></path>",
          )
        }
      }
      for crossing in head_marks[k] {
        let p = crossing.point
        out.write_string(
          "<circle cx='\{p.x}' cy='\{p.y}' r='\{scale*0.38}' fill='#c95d24' stroke='#fffaf0' stroke-width='\{scale*0.11}'><title>堤路与桥头接线的实际交点 · \{crossing.junction}</title></circle>",
        )
      }
      out.write_string("</g>")
    }
  }
  out.write_string("</defs>")
  let rot = "matrix(.7071067811865476 -.7071067811865476 .7071067811865476 .7071067811865476 0 0)"
  for k, s in scores {
    let top = 113 + k * (panel + 50)
    out.write_string(
      "<text x='28' y='\{top-12}' font-size='17' font-weight='650'>\{if k==0{"上一轮校准"}else{"本轮校准"}}</text><text x='988' y='\{top-12}' text-anchor='end' font-size='16'>冲突 \{s.added}　消失交叉 \{s.lost}</text><svg x='28' y='\{top}' width='960' height='\{panel}' viewBox='\{x} \{y} \{w} \{h}'><g transform='\{rot}'><use href='#scene\{k}'/></g></svg>",
    )
  }
  let mut focus = before_issues[0].at
  let mut gain = -1000
  for e in before_issues {
    if e.lost ||
      (show_bridge && bridge_focus is Some(p) && distance(e.at, p) < 9) {
      continue
    }
    let n = before_issues.filter(v => distance(v.at, e.at) < 4.5).length() -
      after_issues.filter(v => distance(v.at, e.at) < 4.5).length()
    if n > gain {
      gain = n
      focus = e.at
    }
  }
  let z = view_pt(focus)
  let top = 205 + panel * 2
  for k in 0..<2 {
    let left = 28 + k * 490
    out.write_string(
      "<text x='\{left}' y='\{top-12}' font-size='14'>\{if k==0{"同一街区 · 调整前"}else{"调整后"}}</text><svg x='\{left}' y='\{top}' width='470' height='176' viewBox='\{z.x-7.5} \{z.y-2.81} 15 5.62'><g transform='\{rot}'><use href='#detail\{k}'/></g></svg>",
    )
  }
  if show_bridge && bridge_focus is Some(point) {
    let z = view_pt(point)
    let top = top + 208
    for k in 0..<2 {
      let left = 28 + k * 490
      out.write_string(
        "<text x='\{left}' y='\{top-12}' font-size='14'>\{if k==0{"桥面与左堤路 · 调整前"}else{"恢复交叉后"}}</text><svg x='\{left}' y='\{top}' width='470' height='176' viewBox='\{z.x-5.5} \{z.y-2.06} 11 4.12'><g transform='\{rot}'><use href='#detail\{k}'/></g></svg>",
      )
    }
  }
  if head_focus is Some(crossing) {
    let z = view_pt(crossing.point)
    let head_top = top + 208 + (if show_bridge { 208 } else { 0 })
    for k in 0..<2 {
      let left = 28 + k * 490
      out.write_string(
        "<text x='\{left}' y='\{head_top-12}' font-size='14'>\{if k==0{"桥头放大 · 调整前"}else{"调整后 · 橙点为接线与堤路的交点"}}</text><svg x='\{left}' y='\{head_top}' width='470' height='176' viewBox='\{z.x-3.75} \{z.y-1.405} 7.5 2.81'><g transform='\{rot}'><use href='#detail\{k}'/></g></svg>",
      )
    }
  }
  out.write_string("</g></svg>")
  @fs.write_string_to_file(directory + "/comparison.svg", out.to_string())
}

///|
// Independent acceptance path: use complete old and new bounding boxes, all
// segments in each candidate pair and all approaches. It bypasses both the
// ten-cell search neighbourhood and the optimizer's interaction cache.
fn verify_crossings(
  net : Net,
  m : Array[Int32],
  links : Array[Link],
  expected : Score,
) -> Unit raise {
  let old = net.roads.mapi((i, _) => net.points(i, 0))
  let current = net.roads.mapi((i, _) => net.points(i, m[i]))
  let boxes = current.map(bounds)
  let mut added = 0
  let mut lost = 0
  for i, r in net.roads {
    let p = current[i]
    let u = old[i]
    for k in 0..<i {
      if m[i] == 0 && m[k] == 0 {
        continue
      }
      let s = net.roads[k]
      let q = current[k]
      let v = old[k]
      if !near(boxes[i].lo, boxes[i].hi, boxes[k].lo, boxes[k].hi, 0.0002) &&
        !near(r.box.lo, r.box.hi, s.box.lo, s.box.hi, 0.0002) {
        continue
      }
      let mut delta = 0
      for x in 1..<p.length() {
        for y in 1..<q.length() {
          let was = crosses(u[x - 1], u[x], v[y - 1], v[y])
          let now = crosses(p[x - 1], p[x], q[y - 1], q[y])
          if was && !now {
            delta -= 1
          } else if now && !was {
            delta += 1
          }
          if !now &&
            (
              (
                internal_touch(p[x - 1], p[x], q[y - 1], q[y]) &&
                !internal_touch(u[x - 1], u[x], v[y - 1], v[y])
              ) ||
              (
                r.nodes[x - 1] != s.nodes[y - 1] &&
                p[x - 1] == q[y - 1] &&
                u[x - 1] != v[y - 1]
              ) ||
              (
                r.nodes[x - 1] != s.nodes[y] &&
                p[x - 1] == q[y] &&
                u[x - 1] != v[y]
              ) ||
              (
                r.nodes[x] != s.nodes[y - 1] &&
                p[x] == q[y - 1] &&
                u[x] != v[y - 1]
              ) ||
              (r.nodes[x] != s.nodes[y] && p[x] == q[y] && u[x] != v[y])
            ) {
            added += 1
          }
        }
      }
      added += delta.max(0)
      lost += (-delta).max(0)
    }
  }
  for i, l in links {
    for j, box in boxes {
      if !near(l.a, l.b, box.lo, box.hi, 0.0001) {
        continue
      }
      let ps = current[j]
      for k in 1..<ps.length() {
        if crosses(l.a, l.b, ps[k - 1], ps[k]) ||
          internal_touch(l.a, l.b, ps[k - 1], ps[k]) {
          added += 1
        }
      }
    }
    for k in 0..<i {
      let q = links[k]
      if crosses(l.a, l.b, q.a, q.b) || internal_touch(l.a, l.b, q.a, q.b) {
        added += 1
      }
    }
  }
  assert_eq((added, lost), (expected.added, expected.lost))
}

///|
fn simplify(net : Net, state : Array[Int32], start : Score) -> Int32 {
  let mut best = evaluate(net, state)
  let mut tries = 0
  for _ in 0..<3 {
    let old_score = best
    let groups : Array[Array[Int32]] = []
    let outer = net.roads
      .mapi((i, r) => if !r.inner && state[i] != 0 { i } else { -1 })
      .filter(i => i >= 0)
    let fx = Set(outer.map(i => state[i]))
    for k in fx {
      let cohort = outer.filter(i => state[i] == k)
      groups.push(cohort)
      let active = Set(cohort)
      while !active.is_empty() {
        let seed = active.to_array()[0]
        let q = [seed]
        active.remove(seed)
        let mut idx = 0
        while idx < q.length() {
          let id = q[idx]
          idx += 1
          for s in net.sockets {
            if s.owners.contains(id) {
              for r in s.owners {
                if active.contains(r) {
                  active.remove(r)
                  q.push(r)
                }
              }
            }
          }
        }
        groups.push(q)
      }
    }
    for cell in [16.0, 8.0, 4.0] {
      let buckets : Map[(Int32, Int32), Array[Int32]] = Map([])
      for r in outer {
        let center = mix(net.roads[r].box.lo, net.roads[r].box.hi, 0.5)
        buckets
        .get_or_init(
          (
            (center.x / cell).floor().to_int(),
            (center.y / cell).floor().to_int(),
          ),
          () => [],
        )
        .push(r)
      }
      for _, b in buckets {
        groups.push(b)
      }
    }
    for r in outer {
      groups.push([r])
    }
    groups.sort_by((a, b) => b.length().compare(a.length()))
    for group in groups {
      let previous = group.map(id => state[id])
      if previous.all(k => k == 0) {
        continue
      }
      for i in group {
        state[i] = 0
      }
      let s = evaluate(net, state)
      tries += 1
      if s.bridges_ok &&
        s.added <= best.added &&
        s.lost <= best.lost &&
        s.waterChange + s.tieWet <= start.tieWet + 0.0001 {
        best = s
      } else {
        for j, i in group {
          state[i] = previous[j]
        }
      }
    }
    if old_score.travel == best.travel {
      break
    }
  }
  return tries
}

///|
// Tune an already moved collection as one unit, including its support streets.
// Re-fitting only currently conflicting ways can split a clean junction again.
fn tune_cohorts(net : Net, state : Array[Int32], start : Score) -> Int32 {
  let mut tries = 0
  let mut best = evaluate(net, state)
  for step in [1.0, 0.35, 0.12] {
    let members : Map[Int32, Array[Int32]] = Map([])
    for i, r in net.roads {
      if !r.inner && state[i] != 0 {
        members.get_or_init(state[i], () => []).push(i)
      }
    }
    let cohorts : Array[Array[Int32]] = []
    for _, ids in members {
      cohorts.push(ids)
      let pending = Set(ids)
      while !pending.is_empty() {
        let root = pending.to_array()[0]
        let q = [root]
        pending.remove(root)
        let mut j = 0
        while j < q.length() {
          let node = q[j]
          j += 1
          for s in net.sockets {
            if s.owners.contains(node) {
              for r in s.owners {
                if pending.contains(r) {
                  pending.remove(r)
                  q.push(r)
                }
              }
            }
          }
        }
        if q.length() != ids.length() {
          cohorts.push(q)
        }
      }
    }
    cohorts.sort_by((a, b) => b.length().compare(a.length()))
    for ids in cohorts {
      let previous = ids.map(i => state[i])
      if !previous.all(k => k == previous[0]) {
        continue
      }
      let f = net.fits[previous[0]]
      // Recenter without changing the seed geometry, so angular/scale refinements
      // are local to the roads being tested.
      let bb = bounds(
        ids.map(i => mix(net.roads[i].box.lo, net.roads[i].box.hi, 0.5)),
      )
      let pivot = mix(bb.lo, bb.hi, 0.5)
      let shift = minus(f.at(pivot), pivot)
      let mut next = previous[0]
      for ai in [-1.0, 0.0, 1.0] {
        for ki in [-1.0, 0.0, 1.0] {
          for dx in [-1.0, -0.3, 0.0, 0.3, 1.0] {
            for dy in [-1.0, -0.3, 0.0, 0.3, 1.0] {
              let t = ai * step * 0.08
              let k = f.drop + ki * 0.01 * step
              if k < 0 {
                continue
              }
              let trial : Fit = {
                ..f,
                mode: "outer-cohort",
                origin: pivot,
                shift: {
                  x: shift.x + dx * step * 0.65,
                  y: shift.y + dy * step * 0.65,
                },
                drop: k,
                axis: {
                  x: f.axis.x * @math.cos(t) - f.axis.y * @math.sin(t),
                  y: f.axis.x * @math.sin(t) + f.axis.y * @math.cos(t),
                },
              }
              if ids.any(i => {
                  net.roads[i].ps.any(p => distance(p, trial.at(p)) > 5)
                }) {
                continue
              }
              let key = add_fit(net, trial)
              if ids.any(i => {
                  net.wet(i, 0) < 0.00001 && net.wet(i, key) > 0.00001
                }) {
                continue
              }
              for i in ids {
                state[i] = key
              }
              let s = evaluate(net, state)
              tries += 1
              if prefer(s, best) &&
                s.waterChange + s.tieWet <= start.tieWet + 0.0001 {
                best = s
                next = key
              }
            }
          }
        }
      }
      for i in ids {
        state[i] = next
      }
      if net.interactions.length() > 150000 {
        net.interactions.clear()
      }
      if net.polylines.length() > 60000 {
        net.polylines.clear()
      }
    }
  }
  println("Cohort refinement \{tries}: \{best.added}/\{best.lost}")
  tries
}

///|
fn read_layout(file : String) -> Saved raise {
  let doc = @json.parse(@fs.read_file_to_string(file))
  if doc is { "outerGroups": Array(_), .. } {
    let layout : AuditLayout = @json.from_json(doc)
    let outer : Array[SavedOuter] = []
    for g in layout.outerGroups {
      for way in g.ways {
        outer.push({ way, fit: g.fit, })
      }
    }
    {
      coreFit: layout.coreFit,
      after: layout.after,
      trials: layout.candidateEvaluations,
      outer,
    }
  } else {
    @json.from_json(doc)
  }
}

///|
// A contact goal uses a real shared OSM node. Match two goals with a single
// symmetric contraction: the residual chord change is along its principal axis.
struct Pin {
  p : P
  target : P
  priority : Double
}

///|
fn pin_fit(p : Pin, q : Pin, isotropic : Double) -> Fit? {
  let d = minus(q.p, p.p)
  let target = minus(q.target, p.target)
  if dot(d, d) < 0.00001 {
    return None
  }
  let v = P::{
    x: (1.0 - isotropic) * d.x - target.x,
    y: (1.0 - isotropic) * d.y - target.y,
  }
  let sq = dot(v, v)
  let axis = if sq < 0.0000000001 { P::{ x: 1, y: 0, } } else { unit(v) }
  let projection = dot(d, v)
  if sq >= 0.0000000001 && projection <= 0 {
    return None
  }
  let k = if sq < 0.0000000001 { 0.0 } else { sq / projection }
  if k + isotropic > 0.20 {
    return None
  }
  Some({
    mode: "junction-pair",
    origin: p.p,
    shift: minus(p.target, p.p),
    axis,
    drop: k,
    isotropic,
    uniform: false,
  })
}

///|
fn optimize_junctions(
  net : Net,
  state : Array[Int32],
  previous : Score,
) -> Int32 {
  let mut tries = 0
  let mut best = evaluate(net, state)
  let wet_cap = previous.waterChange + previous.tieWet
  for pass in 0..<3 {
    let prev = best
    let groups = groups_for(net, state, 0)
    let issues : Array[Issue] = []
    ignore(evaluate(net, state, events=Some(issues)))
    for e in issues {
      let direct = e.roads.filter(i => net.roads[i].eligible)
      for i in direct {
        let s = net.sockets.filter(n => n.owners.contains(i))
        for n in s {
          let ns = n.owners.filter(j => net.roads[j].eligible)
          if ns.length() > 1 && !groups.contains(ns) {
            groups.push(ns)
          }
        }
      }
    }
    for ids in groups {
      let olds = ids.map(i => state[i])
      let old = net.fits[olds[0]]
      let touched = Set(ids)
      let pins : Array[Pin] = []
      let related = issues.filter(e => e.roads.any(i => touched.contains(i)))
      if related.is_empty() {
        continue
      }
      for s in net.sockets {
        if !s.owners.any(i => touched.contains(i)) {
          continue
        }
        let external = s.owners.filter(i => !touched.contains(i))
        for j in external {
          let target = net.fits[state[j]].at(s.p)
          if pins.any(p => p.p == s.p && distance(p.target, target) < 0.00001) {
            continue
          }
          let near = related.fold(init=100000.0, (d, e) => {
            d.min(distance(e.at, s.p))
          })
          pins.push({
            p: s.p,
            target,
            priority: near -
            0.5 * s.owners.length().to_double() -
            (if !s.deck.is_empty() { 5.0 } else { 0.0 }),
          })
        }
      }
      pins.sort_by((a, b) => a.priority.compare(b.priority))
      let size = pins.length().min(16)
      let fs : Array[Fit] = []
      for i in 0..<size {
        let p = pins[i]
        for
          seed in [
            old,
            net.fits[0],
            net.fits[state[net.roads.search_by(r => r.inner).unwrap()]],
          ] {
          fs.push({
            ..seed,
            mode: "junction-shift",
            origin: p.p,
            shift: minus(p.target, p.p),
          })
        }
        for j in 0..<i {
          let q = pins[j]
          for iso in [0.0, 0.0075, 0.035, 0.08] {
            if pin_fit(p, q, iso) is Some(f) {
              fs.push(f)
            }
          }
        }
      }
      let mut pick = -1
      for f in fs {
        if ids.any(i => net.roads[i].ps.any(p => distance(f.at(p), p) > 5.0)) {
          continue
        }
        let k = add_fit(net, f)
        if ids.any(i => net.wet(i, 0) < 0.00001 && net.wet(i, k) > 0.00001) {
          continue
        }
        for i in ids {
          state[i] = k
        }
        let s = evaluate(net, state)
        tries += 1
        if s.added <= previous.added &&
          s.lost <= previous.lost &&
          s.waterChange + s.tieWet <= wet_cap + 0.00001 &&
          prefer(s, best) {
          best = s
          pick = k
        }
      }
      for j, i in ids {
        state[i] = if pick < 0 { olds[j] } else { pick }
      }
      if net.interactions.length() > 160000 {
        net.interactions.clear()
      }
      if net.polylines.length() > 60000 {
        net.polylines.clear()
      }
    }
    println(
      "Junction fit \{pass}: \{best.added}/\{best.lost}, \{tries} evaluations",
    )
    if prev.added == best.added &&
      prev.lost == best.lost &&
      prev.travel == best.travel {
      break
    }
  }
  tries
}

///|
// Feasible translations form a polygon when the compression is held fixed.
// Clip against n·p >= limit. All clipping is in translation space.
fn clip_window(poly : Array[P], n : P, limit : Double) -> Array[P] {
  let out : Array[P] = []
  if poly.length() < 3 {
    return out
  }
  let mut a = poly.last().unwrap()
  let mut h = dot(n, a) - limit
  for b in poly {
    let k = dot(n, b) - limit
    if (h < 0) != (k < 0) {
      out.push(mix(a, b, h / (h - k)))
    }
    if k >= 0 {
      out.push(b)
    }
    a = b
    h = k
  }
  out
}

///|
fn hull(points : Array[P]) -> Array[P] {
  let sorted = points.copy()
  sorted.sort_by((a, b) => {
    if a.x == b.x {
      a.y.compare(b.y)
    } else {
      a.x.compare(b.x)
    }
  })
  fn chain(ps : Array[P]) -> Array[P] {
    let out : Array[P] = []
    for p in ps {
      while out.length() >= 2 {
        let b = out[out.length() - 1]
        let a = out[out.length() - 2]
        if det(minus(b, a), minus(p, b)) > 1.0e-12 {
          break
        }
        ignore(out.pop())
      }
      out.push(p)
    }
    ignore(out.pop())
    out
  }
  chain(sorted) + chain(sorted.rev())
}

///|
fn in_half(p : P, q : P) -> P {
  let d = minus(q, p)
  { x: -d.y, y: d.x, }
}

///|
fn intersect_window(poly : Array[P], region : Array[P]) -> Array[P] {
  let mut part = poly
  for i, a in region {
    let n = in_half(a, region[(i + 1) % region.length()])
    part = clip_window(part, n, dot(n, a))
    if part.length() < 3 {
      break
    }
  }
  part
}

///|
fn area(poly : Array[P]) -> Double {
  if poly.length() < 3 {
    return 0
  }
  poly
  .mapi((i, p) => det(p, poly[(i + 1) % poly.length()]))
  .fold(init=0.0, (v, d) => v + d)
  .abs() *
  0.5
}

///|
fn window_center(poly : Array[P]) -> P {
  let n = poly.length().to_double()
  {
    x: poly.fold(init=0.0, (a, p) => a + p.x) / n,
    y: poly.fold(init=0.0, (a, p) => a + p.y) / n,
  }
}

///|
// Return one open-water obstacle containing this placement. Its hull is the
// inflated raster cell minus the swept segment, so all translations inside
// it fail the same pavement check. Final acceptance uses exported coordinates.
fn wet_obstacle(line : Array[P], shift : P, water : Array[Bool]) -> Array[P]? {
  let pad = 0.1201
  for i in 1..<line.length() {
    let a = line[i - 1]
    let b = line[i]
    let lo_x = (a.x.min(b.x) + shift.x - pad).floor().to_int().max(0)
    let hi_x = (a.x.max(b.x) + shift.x + pad).floor().to_int().min(255)
    let lo_y = (a.y.min(b.y) + shift.y - pad).floor().to_int().max(0)
    let hi_y = (a.y.max(b.y) + shift.y + pad).floor().to_int().min(143)
    for y in lo_y..<=hi_y {
      let yy = y.to_double()
      let (u, v) = slab(a.y + shift.y, b.y - a.y, yy - pad, yy + 1 + pad)
      if v <= u {
        continue
      }
      for x in lo_x..<=hi_x {
        if !water[y * 256 + x] {
          continue
        }
        let xx = x.to_double()
        let (l, h) = slab(a.x + shift.x, b.x - a.x, xx - pad, xx + 1 + pad)
        if h.min(v) <= l.max(u) {
          continue
        }
        let ps : Array[P] = []
        for p in [a, b] {
          for dx in [-pad, 1.0 + pad] {
            for dy in [-pad, 1.0 + pad] {
              ps.push({ x: xx + dx - p.x, y: yy + dy - p.y, })
            }
          }
        }
        return Some(hull(ps))
      }
    }
  }
  None
}

///|
fn fit_deck_windows(net : Net, state : Array[Int32], previous : Score) -> Int32 {
  let d = net.roads.search_by(r => r.id == 47518902).unwrap()
  let inside = net.roads
    .mapi((i, r) => if r.inner { i } else { -1 })
    .filter(i => i >= 0)
  let before = state.copy()
  let a = net.sockets[net.sockets.search_by(s => s.node == 605039789).unwrap()]
  let b = net.sockets[net.sockets.search_by(s => s.node == 3351127195).unwrap()]
  let obs : Array[Issue] = []
  let mut best = evaluate(net, state, events=Some(obs))
  let goals = obs.filter(e => {
    e.lost &&
    e.roads.any(i => net.roads[i].inner) &&
    e.roads.any(i => net.roads[i].structure)
  })
  let edges : Array[(P, P, P, P)] = []
  for g in goals {
    let r = net.roads[g.roads.filter(i => net.roads[i].inner)[0]]
    let deck = net.roads[g.roads.filter(i => net.roads[i].structure)[0]]
    for i in 1..<r.ps.length() {
      for j in 1..<deck.ps.length() {
        if near(r.ps[i - 1], r.ps[i], deck.ps[j - 1], deck.ps[j], 5.002) {
          edges.push((r.ps[i - 1], r.ps[i], deck.ps[j - 1], deck.ps[j]))
        }
      }
    }
  }
  let extent : Array[P] = []
  for i in inside {
    for p in net.roads[i].ps {
      extent.push(p)
    }
  }
  let extreme = hull(extent)
  let directions = Array::makei(20, i => {
    let t = i.to_double() * 3.141592653589793 / 10
    P::{ x: @math.cos(t), y: @math.sin(t), }
  })
  let seed = net.fits[0]
  let mut winner = state[d]
  let mut tries = 0
  let mut windows = 0
  let wet_limit = previous.waterChange + previous.tieWet
  let all_fits : Array[Fit] = []
  for degrees in 0..<150 {
    let t = degrees.to_double() * 3.141592653589793 / 150
    for k in 0..<=34 {
      for iso in [0.0, 0.004, 0.009, 0.014, 0.019, 0.026, 0.035, 0.05, 0.075] {
        all_fits.push({
          ..seed,
          mode: "deck-window",
          origin: a.p,
          axis: { x: @math.cos(t), y: @math.sin(t), },
          drop: k.to_double() / 140,
          isotropic: iso,
        })
      }
    }
  }
  all_fits.push({ ..net.fits[winner], origin: a.p, shift: { x: 0, y: 0, }, })
  for f in all_fits {
    let mut root = [
      P::{ x: -5, y: -5, },
      P::{ x: 5, y: -5, },
      P::{ x: 5, y: 5, },
      P::{ x: -5, y: 5, },
    ]
    for head in [a, b] {
      let v = head.deck[0]
      let delta = minus(f.at(head.p), head.p)
      for sign in [-1.0, 1.0] {
        let n = P::{
          x: 0.258819045 * v.x + sign * 0.965925826 * v.y,
          y: 0.258819045 * v.y - sign * 0.965925826 * v.x,
        }
        root = clip_window(root, n, -dot(n, delta))
      }
    }
    for n in directions {
      if root.length() < 3 {
        break
      }
      let bound = extreme.fold(init=-100.0, (v, p) => {
        v.max(-5.0 - dot(n, minus(f.at(p), p)))
      })
      root = clip_window(root, n, bound)
    }
    if area(root) < 0.0000001 {
      continue
    }
    let line = net.roads[d].ps.map(p => f.at(p))
    let seen : Set[(Int32, Int32)] = Set([])
    for (p, q, c, h) in edges {
      let x = f.at(p)
      let y = f.at(q)
      let crossing = hull([minus(c, x), minus(c, y), minus(h, x), minus(h, y)])
      if area(crossing) < 0.00000001 {
        continue
      }
      let initial = intersect_window(root, crossing)
      if area(initial) < 0.00000001 {
        continue
      }
      let queue = [initial]
      let mut at = 0
      while at < queue.length() && at < 45 {
        let region = queue[at]
        at += 1
        let center = window_center(region)
        if wet_obstacle(line, center, net.water) is Some(block) {
          let mut rem = region
          for i, p0 in block {
            let n = in_half(p0, block[(i + 1) % block.length()])
            let v = dot(n, p0)
            let outside = clip_window(rem, { x: -n.x, y: -n.y, }, -v)
            if area(outside) > 0.0000001 {
              queue.push(outside)
            }
            rem = clip_window(rem, n, v)
            if rem.length() < 3 {
              break
            }
          }
          continue
        }
        windows += 1
        for s in [center] + region.map(v => mix(center, v, 0.92)) {
          let key = ((s.x * 250).round().to_int(), (s.y * 250).round().to_int())
          if seen.contains(key) {
            continue
          }
          seen.add(key)
          let trial = { ..f, shift: s, }
          if extreme.any(p => distance(trial.at(p), p) > 5.0) {
            continue
          }
          if measure(snap(a.p), snap(trial.at(a.p)), net.water, 0.12) > 0 {
            continue
          }
          if wet_obstacle(line, s, net.water) is Some(_) {
            continue
          }
          let id = add_fit(net, trial)
          if net.wet(d, id) > 0 {
            continue
          }
          for i in inside {
            state[i] = id
          }
          let score = evaluate(net, state)
          tries += 1
          if score.bridges_ok &&
            score.added <= previous.added &&
            score.lost <= previous.lost &&
            score.waterChange + score.tieWet <= wet_limit + 0.00001 &&
            (
              score.lost < best.lost ||
              (score.lost == best.lost && prefer(score, best))
            ) {
            best = score
            winner = id
          }
          if net.interactions.length() > 200000 {
            net.interactions.clear()
          }
          if net.polylines.length() > 60000 {
            net.polylines.clear()
          }
        }
      }
    }
  }
  for i, k in before {
    state[i] = if net.roads[i].inner { winner } else { k }
  }
  println(
    "Deck windows: \{windows} dry regions, \{tries} network trials: \{best.added}/\{best.lost}",
  )
  tries
}

///|
// The local factor graph retains every road pair that a relabeling may
// change, including the links of nearby stationary junctions. All omitted
// terms cancel against the starting score. Verify each winner globally.
fn pocket(net : Net, state : Array[Int32], active : Set[Int32]) -> Net {
  let moving_s = net.sockets.filter(s => s.owners.any(i => active.contains(i)))
  let sockets : Array[Socket] = []
  for s in net.sockets {
    if s.owners.any(i => active.contains(i)) {
      sockets.push(s)
      continue
    }
    if s.owners.all(i => state[i] == state[s.owners[0]]) {
      continue
    }
    let around = s.around.filter(t => active.contains(t.0))
    if !around.is_empty() || moving_s.any(m => distance(s.p, m.p) <= 10.001) {
      sockets.push({ ..s, around, })
    }
  }
  {
    ..net,
    pairs: net.pairs.filter(p => active.contains(p.a) || active.contains(p.b)),
    sockets,
    interactions: Map([]),
  }
}

///|
fn point_edge(p : P, a : P, b : P) -> Double {
  let v = minus(b, a)
  let len = dot(v, v)
  if len < 0.00000001 {
    return distance(p, a)
  }
  distance(p, mix(a, b, (dot(minus(p, a), v) / len).clamp(min=0, max=1)))
}

///|
fn district_fit(net : Net, state : Array[Int32], previous : Score) -> Int32 {
  let wet_cap = previous.waterChange + previous.tieWet
  let mut best = evaluate(net, state)
  let mut tries = 0
  for round in 0..<3 {
    let start = best
    let ev : Array[Issue] = []
    ignore(evaluate(net, state, events=Some(ev)))
    let hints : Array[Array[Int32]] = []
    for e in ev {
      if e.lost {
        continue
      }
      let ids = net.roads.mapi((i, r) => {
        if !r.eligible || !near(r.box.lo, r.box.hi, e.at, e.at, 9) {
          (-1, 10000.0)
        } else {
          let ps = net.points(i, state[i])
          let mut gap = 1.0e9
          for j in 1..<ps.length() {
            gap = gap.min(point_edge(e.at, ps[j - 1], ps[j]))
          }
          (i, gap - (if e.roads.contains(i) { 5.0 } else { 0.0 }))
        }
      })
      let nearby = ids.filter(t => t.0 >= 0 && t.1 < 3.25)
      nearby.sort_by((a, b) => a.1.compare(b.1))
      let limit = nearby.length().min(8)
      let district = nearby[:limit].map(t => t.0)
      if !district.is_empty() && !hints.contains(district) {
        hints.push(district)
      }
    }
    for district in hints {
      let active = Set(district)
      let view = pocket(net, state, active)
      let anchor = state.copy()
      let old = evaluate(view, state)
      let added = best.added - old.added
      let lost = best.lost - old.lost
      let wet_offset = best.tieWet - old.tieWet
      let labels = Set(state).to_array()
      let active_core = state[net.roads.search_by(r => r.inner).unwrap()]
      if !labels.contains(active_core) {
        abort("missing inner state")
      }
      let mut winning = best
      let mut winning_labels = district.map(i => state[i])
      for k in labels {
        let f = net.fits[k]
        let avail = district.filter(i => {
          anchor[i] != k &&
          net.roads[i].ps.all(p => distance(f.at(p), p) <= 5.00) &&
          !(net.wet(i, 0) < 0.00001 && net.wet(i, k) > 0.00001)
        })
        if avail.is_empty() {
          continue
        }
        let choices = 1 << avail.length()
        for j in 1..<choices {
          for ii, id in avail {
            state[id] = if (j & (1 << ii)) != 0 { k } else { anchor[id] }
          }
          let local_score = evaluate(view, state)
          let s = {
            ..local_score,
            added: local_score.added + added,
            lost: local_score.lost + lost,
            tieWet: local_score.tieWet + wet_offset,
          }
          tries += 1
          if s.added <= previous.added &&
            s.lost <= previous.lost &&
            prefer(s, winning) &&
            s.waterChange + s.tieWet <= wet_cap + 0.00001 {
            winning = s
            winning_labels = district.map(i => state[i])
          }
        }
        for i in avail {
          state[i] = anchor[i]
        }
      }
      for j, i in district {
        state[i] = winning_labels[j]
      }
      let check = evaluate(net, state)
      if check.added != winning.added ||
        check.lost != winning.lost ||
        (check.tieWet - winning.tieWet).abs() > 0.00001 {
        abort("local score does not match full network")
      }
      if prefer(check, best) {
        best = check
      } else {
        for i in district {
          state[i] = anchor[i]
        }
      }
    }
    println(
      "Neighbourhood assignment \{round}: \{best.added}/\{best.lost} after \{tries}",
    )
    if best.travel == start.travel &&
      best.added == start.added &&
      best.lost == start.lost {
      break
    }
  }
  tries
}

///|
fn station(p : P, a : P, b : P) -> Double {
  let v = minus(b, a)
  let len = dot(v, v)
  if len <= 1.0e-12 {
    0.0
  } else {
    (dot(minus(p, a), v) / len).clamp(min=0, max=1)
  }
}

///|
// A prospective contact is only a calibration target. No vertex is added.
// Offset to either side of the crossing boundary and move the entire way.
fn siding_targets(
  out : Array[Pin],
  a : P,
  b : P,
  old_a : P,
  old_b : P,
  c : P,
  d : P,
) -> Unit {
  let ab = minus(b, a)
  let cd = minus(d, c)
  if dot(ab, ab) < 0.000001 || dot(cd, cd) < 0.000001 {
    return
  }
  let n = unit({ x: -cd.y, y: cd.x, })
  let m = unit({ x: -ab.y, y: ab.x, })
  for (p, raw) in [(a, old_a), (b, old_b)] {
    let hit = mix(c, d, station(p, c, d))
    for v in [-0.18, -0.015, 0.015, 0.18] {
      let q : P = { x: hit.x + n.x * v, y: hit.y + n.y * v, }
      if distance(raw, q) <= 5 {
        out.push({ p: raw, target: q, priority: distance(p, q), })
      }
    }
  }
  for z in [c, d] {
    let t = station(z, a, b)
    let raw = mix(old_a, old_b, t)
    for v in [-0.18, -0.015, 0.015, 0.18] {
      let q : P = { x: z.x + m.x * v, y: z.y + m.y * v, }
      if distance(raw, q) <= 5 {
        out.push({ p: raw, target: q, priority: distance(mix(a, b, t), q), })
      }
    }
  }
}

///|
fn fit_contacts(
  net : Net,
  state : Array[Int32],
  previous : Score,
) -> Int32 raise {
  let mut best = evaluate(net, state)
  let initial = best
  let mut tries = 0
  for round in 0..<3 {
    let entry = best
    let groups = groups_for(net, state, 0)
    let issues : Array[Issue] = []
    ignore(evaluate(net, state, events=Some(issues)))
    for e in issues {
      for i in e.roads {
        if !net.roads[i].eligible {
          continue
        }
        let cohort = net.roads
          .mapi((j, r) => {
            if r.eligible && state[j] != 0 && state[j] == state[i] {
              j
            } else {
              -1
            }
          })
          .filter(j => j >= 0)
        if !cohort.is_empty() && !groups.contains(cohort) {
          groups.push(cohort)
        }
        for s in net.sockets {
          if !s.owners.contains(i) {
            continue
          }
          let adjacent = s.owners.filter(j => net.roads[j].eligible)
          if adjacent.length() > 1 && !groups.contains(adjacent) {
            groups.push(adjacent)
          }
        }
      }
    }
    for ids in groups {
      let selected = Set(ids)
      let socks = net.sockets.filter(s => {
        s.owners.any(j => selected.contains(j)) &&
        s.owners.any(j => !selected.contains(j))
      })
      let ev : Array[Issue] = []
      let links : Array[Link] = []
      ignore(evaluate(net, state, events=Some(ev), links_out=Some(links)))
      let affected = ev.filter(e => {
        !e.lost && e.roads.any(i => selected.contains(i))
      })
      if affected.is_empty() {
        continue
      }
      let stops : Array[Pin] = []
      for s in socks {
        for i in s.owners {
          let p = net.fits[state[i]].at(s.p)
          if !stops.any(t => t.p == s.p && distance(t.target, p) < 0.00001) {
            let proximity = affected.fold(init=1000.0, (g, e) => {
              g.min(distance(e.at, p))
            })
            stops.push({
              p: s.p,
              target: p,
              priority: proximity - (if s.deck.is_empty() { 0.0 } else { 9.0 }),
            })
          }
        }
      }
      stops.sort_by((a, b) => a.priority.compare(b.priority))
      let aim : Array[Pin] = []
      for e in affected {
        if e.key.has_prefix("r/") {
          for i in e.roads {
            if !selected.contains(i) {
              continue
            }
            let js = e.roads.filter(j => !selected.contains(j))
            if js.is_empty() {
              continue
            }
            let j = js[0]
            let r = net.roads[i]
            let p = net.points(i, state[i])
            let q = net.points(j, state[j])
            for x in 1..<p.length() {
              if point_edge(e.at, p[x - 1], p[x]) > 0.02 {
                continue
              }
              for y in 1..<q.length() {
                if point_edge(e.at, q[y - 1], q[y]) > 0.02 {
                  continue
                }
                siding_targets(
                  aim,
                  p[x - 1],
                  p[x],
                  r.ps[x - 1],
                  r.ps[x],
                  q[y - 1],
                  q[y],
                )
              }
            }
          }
        } else {
          for l in links {
            if point_edge(e.at, l.a, l.b) > 0.01 {
              continue
            }
            let s = net.sockets[l.socket]
            for (r, j) in s.around {
              let ps = net.points(r, state[r])
              if point_edge(e.at, ps[j - 1], ps[j]) > 0.003 {
                continue
              }
              if selected.contains(r) {
                siding_targets(
                  aim,
                  ps[j - 1],
                  ps[j],
                  net.roads[r].ps[j - 1],
                  net.roads[r].ps[j],
                  l.a,
                  l.b,
                )
              } else if s.owners.any(i => selected.contains(i)) {
                let target = mix(
                  ps[j - 1],
                  ps[j],
                  station(e.at, ps[j - 1], ps[j]),
                )
                let vector = minus(ps[j], ps[j - 1])
                if dot(vector, vector) > 0.00001 {
                  let n = unit({ x: -vector.y, y: vector.x, })
                  for sign in [-0.18, -0.015, 0.015, 0.18] {
                    let p : P = {
                      x: target.x + sign * n.x,
                      y: target.y + sign * n.y,
                    }
                    if distance(s.p, p) <= 5 {
                      aim.push({
                        p: s.p,
                        target: p,
                        priority: distance(p, e.at),
                      })
                    }
                  }
                }
              }
            }
          }
        }
      }
      if aim.is_empty() {
        continue
      }
      aim.sort_by((a, b) => a.priority.compare(b.priority))
      let old = ids.map(i => state[i])
      let seed = net.fits[old[0]]
      let view = pocket(net, state, selected)
      let sub = evaluate(view, state)
      let add = best.added - sub.added
      let loss = best.lost - sub.lost
      let water = best.tieWet - sub.tieWet
      let mut chosen = -1
      let seen : Set[(Int32, Int32, Int32, Int32, Int32)] = Set([])
      fn attempt(f : Fit) -> Unit {
        let shift = f.at({ x: 200, y: 65, })
        let xx = if f.uniform {
          f.drop + f.isotropic
        } else {
          f.drop * f.axis.x * f.axis.x + f.isotropic
        }
        let yy = if f.uniform {
          xx
        } else {
          f.drop * f.axis.y * f.axis.y + f.isotropic
        }
        let xy = if f.uniform { 0.0 } else { f.drop * f.axis.x * f.axis.y }
        let signature = (
          (shift.x * 10000).round().to_int(),
          (shift.y * 10000).round().to_int(),
          (xx * 100000).round().to_int(),
          (yy * 100000).round().to_int(),
          (xy * 100000).round().to_int(),
        )
        if seen.contains(signature) {
          return
        }
        seen.add(signature)
        if ids.any(i => net.roads[i].ps.any(p => distance(f.at(p), p) > 5)) {
          return
        }
        let k = add_fit(net, f)
        if ids.any(i => net.wet(i, 0) < 0.00001 && net.wet(i, k) > 0.00001) {
          return
        }
        for i in ids {
          state[i] = k
        }
        let fit = evaluate(view, state)
        let full = {
          ..fit,
          added: fit.added + add,
          lost: fit.lost + loss,
          tieWet: fit.tieWet + water,
        }
        tries += 1
        if full.added <= initial.added &&
          full.lost <= initial.lost &&
          prefer(full, best) &&
          full.waterChange + full.tieWet <=
          previous.waterChange + previous.tieWet + 0.00001 {
          best = full
          chosen = k
        }
        if net.polylines.length() > 50000 {
          net.polylines.clear()
        }
        if view.interactions.length() > 80000 {
          view.interactions.clear()
        }
      }
      for z in aim[:aim.length().min(96)] {
        for scale in [seed, net.fits[0]] {
          attempt({
            ..scale,
            mode: "contact-translation",
            origin: z.p,
            shift: minus(z.target, z.p),
          })
        }
        for p in stops[:stops.length().min(14)] {
          for iso in [0.0, 0.006, 0.02, 0.06] {
            if pin_fit(p, z, iso) is Some(f) {
              attempt(f)
            }
          }
        }
      }
      for j, i in ids {
        state[i] = if chosen < 0 { old[j] } else { chosen }
      }
      let check = evaluate(net, state)
      assert_true(
        (check.added, check.lost) == (best.added, best.lost) && check.bridges_ok,
      )
      best = check
    }
    println("Contact fit \{round}: \{best.added}/\{best.lost} after \{tries}")
    if best.added == entry.added &&
      best.lost == entry.lost &&
      best.travel == entry.travel {
      break
    }
  }
  tries
}

///|
struct Track {
  p : P
  q : P
}

///|
// All vertices along a convex blend of two legal affine fits travel on
// straight tracks. Three such vertices are collinear at roots of a quadratic.
fn contact_times(a : Track, b : Track, c : Track, ts : Array[Double]) -> Unit {
  let v = minus(b.p, a.p)
  let w = minus(c.p, a.p)
  let vv = minus(minus(b.q, a.q), v)
  let ww = minus(minus(c.q, a.q), w)
  let aa = det(vv, ww)
  let bb = det(vv, w) + det(v, ww)
  let cc = det(v, w)
  fn emit(t : Double) -> Unit {
    if t > 0.000001 && t < 0.999999 {
      let p = mix(a.p, a.q, t)
      let q = mix(b.p, b.q, t)
      let r = mix(c.p, c.q, t)
      if dot(minus(r, p), minus(r, q)) < 0.001 {
        ts.push(t)
      }
    }
  }
  if aa.abs() < 1.0e-10 {
    if bb.abs() > 1.0e-10 {
      emit(-cc / bb)
    }
  } else {
    let dd = bb * bb - 4.0 * aa * cc
    if dd >= 0 {
      let s = dd.sqrt()
      emit((-bb + s) / (2 * aa))
      emit((-bb - s) / (2 * aa))
    }
  }
}

///|
fn blend_fit(f : Fit, g : Fit, origin : P, t : Double) -> Fit {
  let components = (h : Fit) => {
    let n = h.axis
    if h.uniform {
      (h.isotropic + h.drop, h.isotropic + h.drop, 0.0)
    } else {
      (
        h.isotropic + h.drop * n.x * n.x,
        h.isotropic + h.drop * n.y * n.y,
        h.drop * n.x * n.y,
      )
    }
  }
  let a = components(f)
  let b = components(g)
  let xx = a.0 + t * (b.0 - a.0)
  let yy = a.1 + t * (b.1 - a.1)
  let xy = a.2 + t * (b.2 - a.2)
  let radius = ((xx - yy) * (xx - yy) + 4 * xy * xy).sqrt()
  let iso = ((xx + yy - radius) / 2).max(0)
  let high = (xx + yy + radius) / 2
  let axis = if radius < 1.0e-12 {
    P::{ x: 1, y: 0, }
  } else if xx >= yy {
    unit({ x: high - yy, y: xy, })
  } else {
    unit({ x: xy, y: high - xx, })
  }
  {
    mode: "contact-window",
    origin,
    shift: minus(mix(f.at(origin), g.at(origin), t), origin),
    axis,
    drop: radius,
    isotropic: iso,
    uniform: false,
  }
}

///|
fn sweep_neighbours(
  net : Net,
  state : Array[Int32],
  previous : Score,
) -> Int32 raise {
  let mut best = evaluate(net, state)
  let limit = best
  let mut tries = 0
  for pass in 0..<3 {
    let old_score = best
    let groups = groups_for(net, state, 0)
    let seen_groups : Array[Array[Int32]] = []
    for members in groups {
      let labs = Set(members.map(i => state[i]))
      for k in labs {
        let g = members.filter(i => state[i] == k)
        if !seen_groups.contains(g) {
          seen_groups.push(g)
        }
      }
    }
    let problems : Array[Issue] = []
    ignore(evaluate(net, state, events=Some(problems)))
    for e in problems {
      for i in e.roads {
        if !net.roads[i].eligible {
          continue
        }
        let cohort = net.roads
          .mapi((j, r) => {
            if r.eligible && state[j] != 0 && state[j] == state[i] {
              j
            } else {
              -1
            }
          })
          .filter(j => j >= 0)
        if !cohort.is_empty() && !seen_groups.contains(cohort) {
          seen_groups.push(cohort)
        }
      }
    }
    for g in seen_groups {
      let key = state[g[0]]
      if !g.all(i => state[i] == key) {
        continue
      }
      let active = Set(g)
      let view = pocket(net, state, active)
      let f = net.fits[key]
      let issues : Array[Issue] = []
      let links : Array[Link] = []
      let seed_score = evaluate(
        view,
        state,
        events=Some(issues),
        links_out=Some(links),
      )
      let relevant = issues.filter(e => e.roads.any(i => active.contains(i)))
      if relevant.is_empty() {
        continue
      }
      let dw = best.tieWet - seed_score.tieWet
      let dc = best.added - seed_score.added
      let dl = best.lost - seed_score.lost
      let position = relevant[0].at
      let targets = Set([0, state[net.roads.search_by(r => r.inner).unwrap()]])
      for s in net.sockets {
        if s.owners.any(i => active.contains(i)) {
          for i in s.owners {
            targets.add(state[i])
          }
        }
      }
      let alts = targets.to_array().map(k => net.fits[k])
      for degree in 0..<12 {
        let theta = degree.to_double() * 3.141592653589793 / 6
        alts.push({
          ..f,
          origin: position,
          shift: {
            x: f.at(position).x - position.x + 2.0 * @math.cos(theta),
            y: f.at(position).y - position.y + 2.0 * @math.sin(theta),
          },
        })
      }
      let mut pick = key
      for target in alts {
        let ts = [0.0, 0.125, 0.375, 0.625, 0.875, 1.0]
        let track = (r : Int32, i : Int32) => {
          let p = net.roads[r].ps[i]
          let q = net.fits[state[r]].at(p)
          Track::{ p: q, q: if active.contains(r) { target.at(p) } else { q }, }
        }
        for pair in view.pairs {
          if active.contains(pair.a) == active.contains(pair.b) {
            continue
          }
          let a = net.roads[pair.a]
          let b = net.roads[pair.b]
          if !relevant.any(e => {
              near(a.box.lo, a.box.hi, e.at, e.at, 8) &&
              near(b.box.lo, b.box.hi, e.at, e.at, 8)
            }) {
            continue
          }
          for (i, j) in pair.edges {
            let p = track(pair.a, i - 1)
            let q = track(pair.a, i)
            if !relevant.any(e => near(p.p, q.p, e.at, e.at, 5)) {
              continue
            }
            let u = track(pair.b, j - 1)
            let v = track(pair.b, j)
            if !near(p.p, q.p, u.p, v.p, 5) {
              continue
            }
            contact_times(p, q, u, ts)
            contact_times(p, q, v, ts)
            contact_times(u, v, p, ts)
            contact_times(u, v, q, ts)
          }
        }
        for link in links {
          let s = net.sockets[link.socket]
          let shift = (k : Int32, p : P) => {
            if s.owners.any(i => active.contains(i) && state[i] == k) {
              target.at(s.p)
            } else {
              p
            }
          }
          let a = Track::{ p: link.a, q: shift(link.from_fit, link.a), }
          let b = Track::{ p: link.b, q: shift(link.to_fit, link.b), }
          for (r, j) in s.around {
            if !(active.contains(r) || s.owners.any(i => active.contains(i))) {
              continue
            }
            let c = track(r, j - 1)
            let d = track(r, j)
            contact_times(a, b, c, ts)
            contact_times(a, b, d, ts)
            contact_times(c, d, a, ts)
            contact_times(c, d, b, ts)
          }
        }
        ts.sort()
        let mut last = 0.0
        for hi in ts {
          if hi - last < 0.0002 {
            continue
          }
          let lo = last
          last = hi
          for weight in [0.035, 0.5, 0.965] {
            let t = lo + (hi - lo) * weight
            let fit = blend_fit(f, target, position, t)
            if g.any(i => net.roads[i].ps.any(p => distance(fit.at(p), p) > 5)) {
              continue
            }
            let k = add_fit(net, fit)
            if g.any(i => net.wet(i, 0) < 0.00001 && net.wet(i, k) > 0.00001) {
              continue
            }
            for i in g {
              state[i] = k
            }
            let sub = evaluate(view, state)
            let result = {
              ..sub,
              added: sub.added + dc,
              lost: sub.lost + dl,
              tieWet: sub.tieWet + dw,
            }
            tries += 1
            if result.added <= limit.added &&
              result.lost <= limit.lost &&
              result.waterChange + result.tieWet <=
              previous.waterChange + previous.tieWet + 0.00001 &&
              prefer(result, best) {
              best = result
              pick = k
            }
            for i in g {
              state[i] = key
            }
            if net.polylines.length() > 50000 {
              net.polylines.clear()
            }
            if view.interactions.length() > 80000 {
              view.interactions.clear()
            }
          }
        }
      }
      for i in g {
        state[i] = pick
      }
      let check = evaluate(net, state)
      assert_eq((check.added, check.lost), (best.added, best.lost))
      assert_true(check.bridges_ok)
      best = check
    }
    println(
      "Crossing event sweeps \{pass}: \{best.added}/\{best.lost} in \{tries} placements",
    )
    if old_score.added == best.added &&
      old_score.lost == best.lost &&
      old_score.travel == best.travel {
      break
    }
  }
  tries
}

///|
fn fuse_districts(net : Net, state : Array[Int32], previous : Score) -> Int32 {
  let mut tries = 0
  let mut best = evaluate(net, state)
  let limit = best
  for round in 0..<2 {
    let entry = best
    let issues : Array[Issue] = []
    ignore(evaluate(net, state, events=Some(issues)))
    let sources = Set(state).to_array()
    for alpha in sources {
      let affected = issues.filter(e => {
        !e.lost && e.roads.any(i => net.roads[i].eligible)
      })
      let forced : Array[Array[Int32]] = [[]]
      for e in affected {
        let ids = e.roads.filter(i => net.roads[i].eligible && state[i] != alpha)
        if !ids.is_empty() && !forced.contains(ids) {
          forced.push(ids)
        }
      }
      for ids in forced {
        for seam in [0.05, 0.55, 1.5] {
          let candidate = cut_groups(net, state, alpha, seam, 0.3, force=ids)
          if candidate == state {
            continue
          }
          let s = evaluate(net, candidate)
          tries += 1
          if s.lost <= limit.lost &&
            s.added <= limit.added &&
            prefer(s, best) &&
            s.waterChange + s.tieWet <=
            previous.waterChange + previous.tieWet + 0.00001 {
            best = s
            for i, k in candidate {
              state[i] = k
            }
          }
        }
      }
      if net.interactions.length() > 200000 {
        net.interactions.clear()
      }
    }
    println("Regional fusion \{round}: \{best.added}/\{best.lost}")
    if best.added == entry.added &&
      best.lost == entry.lost &&
      best.travel == entry.travel {
      break
    }
  }
  tries
}

///|
// A crossing can move from a deck to its existing approach. Keep both
// measured events; record the adjacent geometry for the next inspection.
struct HeadCrossing {
  deck : Double
  crossingWay : Double
  junction : Double
  point : P
  distanceFromOriginal : Double
} derive(ToJson)

///|
// Match a lost bridge crossing to an actual intersection at that deck's surveyed
// endpoint. A connection across its surface tie still counts as a missing deck crossing.
fn bridgehead_crossings(
  net : Net,
  state : Array[Int32],
  issues : Array[Issue],
  links : Array[Link],
) -> Array[HeadCrossing] {
  let hits : Array[HeadCrossing] = []
  for e in issues {
    if !e.lost {
      continue
    }
    let spans = e.roads.filter(i => net.roads[i].structure)
    let core = e.roads.filter(i => net.roads[i].inner)
    if spans.length() != 1 || core.length() != 1 {
      continue
    }
    let deck = net.roads[spans[0]]
    let road = net.roads[core[0]]
    let ps = net.points(core[0], state[core[0]])
    for link in links {
      let node = net.sockets[link.socket].node
      if node != deck.nodes[0] && node != deck.nodes[deck.nodes.length() - 1] {
        continue
      }
      for j in 1..<ps.length() {
        if !crosses(link.a, link.b, ps[j - 1], ps[j]) {
          continue
        }
        let p = contact_point(link.a, link.b, ps[j - 1], ps[j])
        let gap = distance(p, e.at)
        if gap <= 5 && !hits.any(h => h.deck == deck.id && h.point == p) {
          hits.push({
            deck: deck.id,
            crossingWay: road.id,
            junction: node,
            point: p,
            distanceFromOriginal: gap,
          })
        }
      }
    }
  }
  hits
}

///|
fn adjacent_approaches(net : Net, issues : Array[Issue]) -> Array[Json] {
  let moved : Array[Json] = []
  for e in issues {
    if !e.lost {
      continue
    }
    let spans = e.roads.filter(i => net.roads[i].structure)
    let core = e.roads.filter(i => net.roads[i].inner)
    if spans.length() != 1 || core.length() != 1 {
      continue
    }
    let deck = net.roads[spans[0]]
    for candidate in issues {
      if candidate.lost ||
        !candidate.key.has_prefix("r/") ||
        !candidate.roads.contains(core[0]) ||
        distance(e.at, candidate.at) > 5 {
        continue
      }
      let j = candidate.roads.filter(i => i != core[0])[0]
      let road = net.roads[j]
      if road.structure ||
        road.highway != deck.highway ||
        (road.name != "" && deck.name != "" && road.name != deck.name) {
        continue
      }
      for end in [0, deck.nodes.length() - 1] {
        let id = deck.nodes[end]
        let next = if end == 0 { 1 } else { end - 1 }
        let forward = unit(minus(deck.ps[end], deck.ps[next]))
        for n, node in road.nodes {
          if node != id {
            continue
          }
          let along = [n - 1, n + 1].any(m => {
            m >= 0 &&
            m < road.nodes.length() &&
            dot(unit(minus(road.ps[m], road.ps[n])), forward) > 0.85
          })
          if along {
            moved.push({
              "deck": deck.id,
              "approach": road.id,
              "junction": id,
              "crossingWay": net.roads[core[0]].id,
              "distance": distance(e.at, candidate.at),
            })
          }
        }
      }
    }
  }
  moved
}

///|
fn check_junction_math() -> Unit raise {
  let a : Pin = { p: { x: 0, y: 0, }, target: { x: 2, y: 1, }, priority: 0, }
  let b : Pin = { p: { x: 10, y: 0, }, target: { x: 11, y: 1, }, priority: 0, }
  let f = pin_fit(a, b, 0.0).unwrap()
  assert_true(
    distance(f.at(a.p), a.target) < 1.0e-9 &&
    distance(f.at(b.p), b.target) < 1.0e-9,
  )
  assert_true(pin_fit(a, { ..b, target: { x: 13, y: 1, }, }, 0) is None)
  let square = [
    P::{ x: 0, y: 0, },
    P::{ x: 2, y: 0, },
    P::{ x: 2, y: 2, },
    P::{ x: 0, y: 2, },
  ]
  assert_true(
    (area(clip_window(square, { x: 1, y: 0, }, 1.5)) - 1).abs() < 1.0e-9,
  )
  let ts : Array[Double] = []
  contact_times(
    { p: { x: 0, y: 0, }, q: { x: 0, y: 1, }, },
    { p: { x: 2, y: 0, }, q: { x: 2, y: 1, }, },
    { p: { x: 1, y: 0.5, }, q: { x: 1, y: 0.5, }, },
    ts,
  )
  assert_eq(ts, [0.5])
  let g = {
    ..f,
    origin: { x: 4, y: 3, },
    axis: { x: 0.6, y: 0.8, },
    isotropic: 0.005,
  }
  let midpoint = blend_fit(f, g, b.p, 0.37)
  for p in square {
    assert_true(distance(midpoint.at(p), mix(f.at(p), g.at(p), 0.37)) < 1.0e-8)
  }
}

///|
// Keep alternatives with distinct vertex placements, even when a single
// street would temporarily make a crossing that its neighbour can remove.
struct Placement {
  k : Int32
  score : Score
  tie_length : Double
}

///|
struct Assignment {
  ks : Array[Int32]
  score : Score
  tie_length : Double
}

///|
fn rank_state(a : Score, b : Score, gap_a : Double, gap_b : Double) -> Int32 {
  let x = (a.added + a.lost).compare(b.added + b.lost)
  if x != 0 {
    return x
  }
  let l = a.lost.compare(b.lost)
  if l != 0 {
    return l
  }
  let wet_band = (s : Score) => ((s.waterChange + s.tieWet) / 0.015).round()
  let w = wet_band(a).compare(wet_band(b))
  if w != 0 {
    return w
  }
  let d = gap_a.compare(gap_b)
  if d != 0 {
    return d
  }
  a.travel.compare(b.travel)
}

///|
fn legal_choice(net : Net, r : Int32, k : Int32) -> Bool {
  let f = net.fits[k]
  let way = net.roads[r]
  way.ps.all(p => distance(f.at(p), p) <= 5.0) &&
  !(net.wet(r, 0) < 0.00001 && net.wet(r, k) > 0.00001) &&
  lost_to_frame(net.points(r, 0), net.points(r, k), net.water, way.pad) <
  0.000001
}

///|
fn neighbourhood_search(
  net : Net,
  state : Array[Int32],
  previous : Score,
) -> Int32 raise {
  let mut best = evaluate(net, state)
  let mut tries = 0
  let ceiling = previous.waterChange + previous.tieWet
  for pass in 0..<3 {
    let start = best
    let events : Array[Issue] = []
    ignore(evaluate(net, state, events=Some(events)))
    let sites : Array[P] = []
    for e in events {
      if !e.lost && !sites.any(p => distance(p, e.at) < 1.8) {
        sites.push(e.at)
      }
    }
    for site in sites {
      let obstacles = events.filter(e => !e.lost && distance(e.at, site) < 4.5)
      let rank = net.roads
        .mapi((i, r) => {
          if !r.eligible || !near(r.box.lo, r.box.hi, site, site, 11) {
            (-1, 1.0e9)
          } else {
            let ps = net.points(i, state[i])
            let mut d = 10000.0
            for j in 1..<ps.length() {
              d = d.min(point_edge(site, ps[j - 1], ps[j]))
            }
            let hits = obstacles.filter(e => e.roads.contains(i)).length()
            (i, d - 2.0 * hits.to_double())
          }
        })
        .filter(t => t.0 >= 0 && t.1 < 4.5)
      rank.sort_by((a, b) => {
        if a.1 == b.1 {
          a.0.compare(b.0)
        } else {
          a.1.compare(b.1)
        }
      })
      let ids = rank[:rank.length().min(9)].map(v => v.0)
      if ids.is_empty() {
        continue
      }
      if pass == 1 {
        for j in 0..<(ids.length() / 2) {
          let k = ids.length() - 1 - j
          let hold = ids[j]
          ids[j] = ids[k]
          ids[k] = hold
        }
      }
      let view = pocket(net, state, Set(ids))
      let root = state.copy()
      let sub = evaluate(view, state)
      let da = best.added - sub.added
      let dl = best.lost - sub.lost
      let dw = best.tieWet - sub.tieWet
      fn eval() -> (Score, Double) {
        let links : Array[Link] = []
        let s = evaluate(view, state, links_out=Some(links))
        tries += 1
        (
          {
            ..s,
            added: s.added + da,
            lost: s.lost + dl,
            tieWet: s.tieWet + dw,
          },
          links.fold(init=0.0, (v, l) => v + distance(l.a, l.b)),
        )
      }
      let menus : Array[Array[Int32]] = []
      for i in ids {
        let current = root[i]
        let way = net.roads[i]
        let f = net.fits[current]
        let near_sockets = net.sockets.filter(s => s.owners.contains(i))
        let pins : Array[Pin] = []
        let labels = Set([
          0,
          current,
          root[net.roads.search_by(r => r.inner).unwrap()],
        ])
        for j in ids {
          labels.add(root[j])
        }
        for s in near_sockets {
          for j in s.owners {
            let g = root[j]
            labels.add(g)
            let p = net.fits[g].at(s.p)
            if !pins.any(v => v.p == s.p && distance(v.target, p) < 0.00001) {
              pins.push({ p: s.p, target: p, priority: distance(s.p, site), })
            }
          }
        }
        let candidates = labels.to_array()
        for s in near_sockets {
          let dirs = if s.deck.is_empty() {
            [unit(minus(way.ps.last().unwrap(), way.ps[0]))]
          } else {
            s.deck
          }
          for v in dirs {
            if !(dot(v, v) > 0.99) {
              continue
            }
            for angle in [-0.20, 0.0, 0.20] {
              let dir : P = {
                x: v.x * @math.cos(angle) - v.y * @math.sin(angle),
                y: v.x * @math.sin(angle) + v.y * @math.cos(angle),
              }
              for t in [0.12, 0.6, 1.3, 2.7, 3.9] {
                let aim : Pin = {
                  p: s.p,
                  target: { x: s.p.x + t * dir.x, y: s.p.y + t * dir.y, },
                  priority: 0,
                }
                candidates.push(
                  add_fit(net, {
                    ..f,
                    mode: "axis-at-junction",
                    origin: s.p,
                    shift: minus(aim.target, s.p),
                  }),
                )
                for q in pins {
                  if pin_fit(aim, q, 0.0) is Some(g) {
                    candidates.push(add_fit(net, g))
                  }
                }
              }
            }
          }
        }
        let ranked : Array[Placement] = []
        for k in candidates {
          if !legal_choice(net, i, k) {
            continue
          }
          state[i] = k
          let (s, d) = eval()
          if s.bridges_ok && s.added + s.lost <= best.added + best.lost + 15 {
            ranked.push({ k, score: s, tie_length: d, })
          }
        }
        state[i] = current
        ranked.sort_by((a, b) => {
          rank_state(a.score, b.score, a.tie_length, b.tie_length)
        })
        let variants = [current]
        let c = way.ps[way.ps.length() / 2]
        for a in ranked {
          let trial = net.fits[a.k]
          if variants.all(k => {
              let g = net.fits[k]
              distance(g.at(c), trial.at(c)) +
              distance(g.at(way.ps[0]), trial.at(way.ps[0])) +
              distance(
                g.at(way.ps.last().unwrap()),
                trial.at(way.ps.last().unwrap()),
              ) >
              0.19
            }) {
            variants.push(a.k)
            if variants.length() >= 12 {
              break
            }
          }
        }
        for k in labels {
          if !variants.contains(k) && legal_choice(net, i, k) {
            variants.push(k)
          }
        }
        menus.push(variants)
      }
      let (s0, d0) = eval()
      let mut beam = [
        Assignment::{ ks: ids.map(i => root[i]), score: s0, tie_length: d0, },
      ]
      let mut selected = beam[0]
      for j in 0..<ids.length() {
        let pool : Array[Assignment] = []
        for node in beam {
          for h, id in ids {
            state[id] = node.ks[h]
          }
          for k in menus[j] {
            state[ids[j]] = k
            let (s, d) = eval()
            if !s.bridges_ok || s.added + s.lost > best.added + best.lost + 7 {
              continue
            }
            let ks = node.ks.copy()
            ks[j] = k
            let next : Assignment = { ks, score: s, tie_length: d, }
            pool.push(next)
            if s.added <= previous.added &&
              s.lost <= previous.lost &&
              s.waterChange + s.tieWet <= ceiling + 0.00001 &&
              prefer(s, selected.score) {
              selected = next
            }
          }
        }
        pool.sort_by((a, b) => {
          rank_state(a.score, b.score, a.tie_length, b.tie_length)
        })
        beam = pool[:pool.length().min(18)].to_owned()
        if beam.is_empty() {
          break
        }
      }
      for j, i in ids {
        state[i] = selected.ks[j]
      }
      let check = evaluate(net, state)
      assert_eq(
        (check.added, check.lost),
        (selected.score.added, selected.score.lost),
      )
      assert_true(check.bridges_ok)
      if prefer(check, best) {
        best = check
      } else {
        for i in ids {
          state[i] = root[i]
        }
      }
      if net.polylines.length() > 60000 {
        net.polylines.clear()
      }
    }
    println(
      "Coupled neighbourhoods pass \{pass}: \{best.added}/\{best.lost} after \{tries} evaluations.",
    )
    if best.travel == start.travel &&
      best.added == start.added &&
      best.lost == start.lost {
      break
    }
  }
  tries
}

///|
// Feasible half-space n · x >= b for coupled road group displacement and compression.
struct Plane {
  n : Array[Double]
  b : Double
}

///|
// Find the smallest maximum change from the seed. The translation and
// compression variables are shifted to nonnegative simplex coordinates.
fn closest_fit(planes : Array[Plane], seed : Array[Double]) -> Array[Double]? {
  let dim = seed.length()
  let n = dim + 1
  let m = planes.length() + 2 * dim
  let t = Array::makei(m + 2, _ => Array::make(n + 2, 0.0))
  let basis = Array::makei(m, i => n + i)
  let free = Array::makei(n + 1, i => if i == n { -1 } else { i })
  let offset = seed.map(x => x - 32.0)
  for i, h in planes {
    let mut rhs = -h.b
    for j in 0..<dim {
      t[i][j] = -h.n[j]
      rhs += h.n[j] * offset[j]
    }
    t[i][n + 1] = rhs
  }
  for j in 0..<dim {
    let i = planes.length() + 2 * j
    t[i][j] = 1
    t[i][dim] = -1
    t[i][n + 1] = 32
    t[i + 1][j] = -1
    t[i + 1][dim] = -1
    t[i + 1][n + 1] = -32
  }
  for i in 0..<m {
    t[i][n] = -1
  }
  t[m][dim] = 1
  t[m + 1][n] = 1
  fn pivot(r : Int32, s : Int32) -> Unit {
    let v = 1.0 / t[r][s]
    for i in 0..<(m + 2) {
      if i != r && t[i][s] != 0 {
        let f = t[i][s] * v
        for j in 0..<(n + 2) {
          if j != s {
            t[i][j] -= t[r][j] * f
          }
        }
        t[i][s] = -f
      }
    }
    for j in 0..<(n + 2) {
      if j != s {
        t[r][j] *= v
      }
    }
    t[r][s] = v
    let old = basis[r]
    basis[r] = free[s]
    free[s] = old
  }
  fn solve(row : Int32) -> Bool {
    for _ in 0..<500 {
      let mut col = -1
      for j in 0..<=n {
        if row == m && free[j] == -1 {
          continue
        }
        if t[row][j] < -0.000000001 && (col < 0 || free[j] < free[col]) {
          col = j
        }
      }
      if col < 0 {
        return true
      }
      let mut r = -1
      let mut ratio = 1.0e100
      for i in 0..<m {
        if t[i][col] > 0.000000001 {
          let z = t[i][n + 1] / t[i][col]
          if z < ratio - 1.0e-9 ||
            ((z - ratio).abs() <= 1.0e-9 && (r < 0 || basis[i] < basis[r])) {
            r = i
            ratio = z
          }
        }
      }
      if r < 0 {
        return false
      }
      pivot(r, col)
    }
    false
  }
  let mut min_row = 0
  for i in 1..<m {
    if t[i][n + 1] < t[min_row][n + 1] {
      min_row = i
    }
  }
  if t[min_row][n + 1] < -1.0e-9 {
    pivot(min_row, n)
    if !solve(m + 1) || t[m + 1][n + 1] < -1.0e-7 {
      return None
    }
    if basis.search_by(v => v == -1) is Some(r) {
      let mut s = -1
      for j in 0..<=n {
        if t[r][j].abs() > 1.0e-9 && (s < 0 || free[j] < free[s]) {
          s = j
        }
      }
      if s >= 0 {
        pivot(r, s)
      }
    }
  }
  if !solve(m) {
    return None
  }
  let x = offset.copy()
  for i, j in basis {
    if j >= 0 && j < dim {
      x[j] += t[i][n + 1]
    }
  }
  Some(x)
}

///|
fn check_joint_solver() -> Unit raise {
  let one = closest_fit([{ n: [1], b: 2, }, { n: [-1], b: -3, }], [0]).unwrap()
  assert_true((one[0] - 2).abs() < 1.0e-7)
  assert_true(
    closest_fit([{ n: [1], b: 4, }, { n: [-1], b: -3, }], [0]) is None,
  )
  let coupled = closest_fit([{ n: [1, -1], b: 2, }], [0, 0]).unwrap()
  assert_true(
    (coupled[0] - 1).abs() < 1.0e-7 && (coupled[1] + 1).abs() < 1.0e-7,
  )
}

///|
fn socket_tree(
  net : Net,
  m : Array[Int32],
  socket : Socket,
  ks : Array[Int32],
  anchor : Int32,
) -> Array[(Int32, Int32)] {
  let out : Array[(Int32, Int32)] = []
  if net.routing.get(socket.node) is Some(pairs) {
    let ps = socket.owners.map(i => snap(net.fits[m[i]].at(socket.p)))
    let roots = Array::makei(ps.length(), i => {
      ps.search_by(p => p == ps[i]).unwrap()
    })
    fn root(i : Int32) -> Int32 {
      let mut k = i
      while roots[k] != k {
        k = roots[k]
      }
      k
    }
    for (a, b) in pairs {
      let i = socket.owners.search_by(r => r == a).unwrap()
      let j = socket.owners.search_by(r => r == b).unwrap()
      let u = root(i)
      let v = root(j)
      if u != v {
        out.push((m[a], m[b]))
        roots[u] = v
      }
    }
    if !roots.all(i => root(i) == root(0)) {
      abort("junction plan leaves a road endpoint disconnected")
    }
  } else {
    let used = [snap(net.fits[anchor].at(socket.p))]
    for k in ks {
      let p = snap(net.fits[k].at(socket.p))
      if !used.contains(p) {
        used.push(p)
        out.push((anchor, k))
      }
    }
  }
  out
}

///|
struct TreeRecord {
  node : Double
  betweenWays : Array[(Double, Double)]
} derive(FromJson)

///|
fn load_routes(net : Net, file : String) -> Unit raise {
  let json = @json.parse(@fs.read_file_to_string(file))
  if json is { "junctionTrees": field, .. } {
    let records : Array[TreeRecord] = @json.from_json(field)
    for record in records {
      let socket = net.sockets[net.sockets
        .search_by(s => s.node == record.node)
        .unwrap()]
      assert_true(socket.deck.is_empty())
      let ids = record.betweenWays.map(pair => {
        (
          socket.owners[socket.owners
          .search_by(i => net.roads[i].id == pair.0)
          .unwrap()],
          socket.owners[socket.owners
          .search_by(i => net.roads[i].id == pair.1)
          .unwrap()],
        )
      })
      assert_eq(ids.length(), socket.owners.length() - 1)
      let connected = Set([socket.owners[0]])
      for _ in 0..<ids.length() {
        for (a, b) in ids {
          if connected.contains(a) || connected.contains(b) {
            connected.add(a)
            connected.add(b)
          }
        }
      }
      assert_eq(connected.length(), socket.owners.length())
      net.routing[record.node] = ids
    }
  }
}

///|
fn optimize_trees(net : Net, state : Array[Int32], previous : Score) -> Int32 {
  let mut tries = 0
  let mut best = evaluate(net, state)
  for si, socket in net.sockets {
    let owners = socket.owners
    let n = owners.length()
    if !socket.deck.is_empty() ||
      n < 3 ||
      n > 5 ||
      Set(
        owners.map(i => Json(snap(net.fits[state[i]].at(socket.p))).stringify()),
      ).length() <
      3 {
      continue
    }
    let ls : Array[Link] = []
    ignore(evaluate(net, state, links_out=Some(ls)))
    let length = ls
      .filter(l => l.socket == si)
      .fold(init=0.0, (acc, l) => acc + distance(l.a, l.b))
    let mut pick = net.routing.get(socket.node)
    let mut record = best
    let mut shortest = length
    // Prüfer sequences enumerate each possible tree over the actual road ends.
    let mut count = 1
    for _ in 0..<(n - 2) {
      count *= n
    }
    for code in 0..<count {
      let mut digits = code
      let seq = Array::makei(n - 2, _ => {
        let x = digits % n
        digits = digits / n
        x
      })
      let degrees = Array::make(n, 1)
      for i in seq {
        degrees[i] += 1
      }
      let tree : Array[(Int32, Int32)] = []
      for i in seq {
        let leaf = degrees.search_by(v => v == 1).unwrap()
        tree.push((owners[leaf], owners[i]))
        degrees[leaf] -= 1
        degrees[i] -= 1
      }
      let final_nodes = owners
        .mapi((i, r) => if degrees[i] == 1 { r } else { -1 })
        .filter(r => r >= 0)
      tree.push((final_nodes[0], final_nodes[1]))
      net.routing[socket.node] = tree
      let links = socket_tree(net, state, socket, [], 0)
      let total = links.fold(init=0.0, (a, p) => {
        a + distance(net.fits[p.0].at(socket.p), net.fits[p.1].at(socket.p))
      })
      if total > length * 1.20 + 0.0001 {
        continue
      }
      let score = evaluate(net, state)
      tries += 1
      if score.bridges_ok &&
        score.added <= previous.added &&
        score.lost <= previous.lost &&
        score.waterChange + score.tieWet <=
        previous.waterChange + previous.tieWet + 0.00001 &&
        (
          prefer(score, record) ||
          (
            score.added == record.added &&
            score.lost == record.lost &&
            score.tieWet <= record.tieWet + 0.00001 &&
            total < shortest - 0.01
          )
        ) {
        pick = Some(tree)
        record = score
        shortest = total
      }
    }
    match pick {
      Some(t) => net.routing[socket.node] = t
      None => net.routing.remove(socket.node)
    }
    best = record
  }
  println(
    "Junction spanning trees: \{tries} candidates, \{best.added}/\{best.lost}",
  )
  tries
}

///|
struct Vertex {
  r : Int32
  p : P
}

///|
struct Hit {
  a : Vertex
  b : Vertex
  c : Vertex
  d : Vertex
}

///|
struct Body {
  r : Int32
  members : Set[Int32]
  o : P
  u : P
  v : P
  l : Double
}

///|
fn vertex(net : Net, m : Array[Int32], v : Vertex) -> P {
  net.fits[m[v.r]].at(v.p)
}

///|
fn face(
  net : Net,
  m : Array[Int32],
  vars : Array[Body],
  p : Vertex,
  q : Vertex,
  n : P,
  margin : Double,
) -> Plane {
  let coeff = Array::make(vars.length() * 4, 0.0)
  let mut value = 0.0
  for (w, s) in [(p, 1.0), (q, -1.0)] {
    match vars.search_by(b => b.members.contains(w.r)) {
      Some(i) => {
        let b = vars[i]
        let v = minus(w.p, b.o)
        coeff[i * 4] += s * n.x
        coeff[i * 4 + 1] += s * n.y
        coeff[i * 4 + 2] -= s * dot(n, b.u) * dot(v, b.u) / b.l
        coeff[i * 4 + 3] -= s * dot(n, b.v) * dot(v, b.v) / b.l
        value += s * dot(n, w.p)
      }
      None => value += s * dot(n, if w.r < 0 { w.p } else { vertex(net, m, w) })
    }
  }
  { n: coeff, b: margin - value, }
}

///|
fn hit_at(
  net : Net,
  state : Array[Int32],
  e : Issue,
  links : Array[Link],
) -> Hit? {
  if e.key.has_prefix("r/") {
    let i = e.roads[0]
    let j = e.roads[1]
    let p = net.points(i, state[i])
    let q = net.points(j, state[j])
    for x in 1..<p.length() {
      if point_edge(e.at, p[x - 1], p[x]) > 0.0002 {
        continue
      }
      for y in 1..<q.length() {
        if point_edge(e.at, q[y - 1], q[y]) < 0.0002 {
          return Some({
            a: { r: i, p: net.roads[i].ps[x - 1], },
            b: { r: i, p: net.roads[i].ps[x], },
            c: { r: j, p: net.roads[j].ps[y - 1], },
            d: { r: j, p: net.roads[j].ps[y], },
          })
        }
      }
    }
  } else {
    for l in links {
      let s = net.sockets[l.socket]
      if !e.key.has_prefix("j/" + s.node.to_string() + "/") ||
        point_edge(e.at, l.a, l.b) > 0.0002 {
        continue
      }
      let i = s.owners[s.owners.search_by(i => state[i] == l.from_fit).unwrap()]
      let h = s.owners[s.owners.search_by(i => state[i] == l.to_fit).unwrap()]
      for (r, j) in s.around {
        if e.key ==
          "j/" +
          s.node.to_string() +
          "/" +
          net.roads[r].id.to_string() +
          "/" +
          j.to_string() {
          return Some({
            a: { r: i, p: s.p, },
            b: { r: h, p: s.p, },
            c: { r, p: net.roads[r].ps[j - 1], },
            d: { r, p: net.roads[r].ps[j], },
          })
        }
      }
    }
  }
  None
}

///|
fn directions(net : Net, state : Array[Int32], hit : Hit) -> Array[P] {
  let a = vertex(net, state, hit.a)
  let b = vertex(net, state, hit.b)
  let c = vertex(net, state, hit.c)
  let d = vertex(net, state, hit.d)
  let ns : Array[P] = []
  for
    edge in [
      minus(b, a),
      minus(d, c),
      minus(hit.b.p, hit.a.p),
      minus(hit.d.p, hit.c.p),
    ] {
    if dot(edge, edge) < 0.0000001 {
      continue
    }
    let u = unit({ x: -edge.y, y: edge.x, })
    for n in [u, { x: -u.x, y: -u.y, }] {
      if !ns.any(v => dot(v, n) > 0.9998) {
        ns.push(n)
      }
    }
  }
  let deficit = (n : P) => dot(c, n).max(dot(d, n)) - dot(a, n).min(dot(b, n))
  ns.sort_by((v, w) => deficit(v).compare(deficit(w)))
  ns
}

///|
fn resolve_hit(
  net : Net,
  m : Array[Int32],
  vars : Array[Body],
  cs : Array[Plane],
  h : Hit,
  n : P,
  margin : Double,
) -> Unit {
  for a in [h.a, h.b] {
    for b in [h.c, h.d] {
      cs.push(face(net, m, vars, a, b, n, margin))
    }
  }
}

///|
fn joint_site(
  net : Net,
  state : Array[Int32],
  ids : Array[Int32],
  hits : Array[Hit],
  site : P,
  previous : Score,
  axis_choice : Int32,
  hops~ : Map[String, Hop]? = None,
) -> Int32 raise {
  let old = state.copy()
  let all_ids = if axis_choice < 3 {
    ids
  } else {
    net.roads
    .mapi((i, r) => {
      if ids.contains(i) ||
        (r.eligible && state[i] != 0 && ids.any(j => state[j] == state[i])) {
        i
      } else {
        -1
      }
    })
    .filter(i => i >= 0)
  }
  let active = Set(all_ids)
  let view = pocket(net, state, active)
  let bound = evaluate(net, state)
  let mut best = bound
  let sub = evaluate(view, state)
  let add = best.added - sub.added
  let loss = best.lost - sub.lost
  let delta = best.tieWet - sub.tieWet
  let mut best_ids = all_ids.map(i => state[i])
  let mut trials = 0
  let vars : Array[Body] = []
  let seed : Array[Double] = []
  for i in ids {
    let r = net.roads[i]
    let f = net.fits[state[i]]
    let o = mix(r.box.lo, r.box.hi, 0.5)
    let chord = minus(r.ps.last().unwrap(), r.ps[0])
    let dir = match axis_choice % 3 {
      1 => if dot(chord, chord) > 1.0e-6 { unit(chord) } else { f.axis }
      2 => P::{ x: 1, y: 0, }
      _ => f.axis
    }
    let v = P::{ x: -dir.y, y: dir.x, }
    let l = distance(r.box.lo, r.box.hi).clamp(min=1, max=30)
    if vars.any(b => b.members.contains(i)) {
      continue
    }
    let members = Set(
      if axis_choice >= 3 && state[i] != 0 {
        all_ids.filter(j => state[j] == state[i])
      } else {
        [i]
      },
    )
    vars.push({ r: i, members, o, u: dir, v, l, })
    let at = minus(f.at(o), o)
    for
      n in [
        at.x,
        at.y,
        l *
        (
          f.isotropic +
          f.drop *
          (if f.uniform { 1.0 } else { dot(f.axis, dir) * dot(f.axis, dir) })
        ),
        l *
        (
          f.isotropic +
          f.drop *
          (if f.uniform { 1.0 } else { dot(f.axis, v) * dot(f.axis, v) })
        ),
      ] {
      seed.push(n)
    }
  }
  let planes : Array[Plane] = []
  for i, b in vars {
    for j in [2, 3] {
      let p = Array::make(vars.length() * 4, 0.0)
      p[4 * i + j] = 1
      planes.push({ n: p, b: 0, })
      let q = Array::make(vars.length() * 4, 0.0)
      q[4 * i + j] = -1
      planes.push({ n: q, b: -0.24 * b.l, })
    }
  }
  let nearby = net.sockets.filter(s => s.owners.any(i => active.contains(i)))
  for s in nearby {
    for r in s.owners {
      if !active.contains(r) {
        continue
      }
      for d in s.deck {
        for v in [-1.0, 1.0] {
          let n = P::{
            x: 0.257 * d.x + v * 0.966 * d.y,
            y: 0.257 * d.y - v * 0.966 * d.x,
          }
          planes.push(
            face(net, old, vars, { r, p: s.p, }, { r: -1, p: s.p, }, n, 0),
          )
        }
      }
    }
  }
  let suggestions : Array[Array[Plane]] = [[]]
  for s in nearby {
    if distance(s.p, site) > 7.5 {
      continue
    }
    let eqs : Array[Plane] = []
    for j in 1..<s.owners.length() {
      for
        n in [
          P::{ x: 1, y: 0, },
          { x: -1, y: 0, },
          { x: 0, y: 1, },
          { x: 0, y: -1, },
        ] {
        eqs.push(
          face(
            net,
            old,
            vars,
            { r: s.owners[j], p: s.p, },
            { r: s.owners[0], p: s.p, },
            n,
            -0.000001,
          ),
        )
      }
    }
    suggestions.push(eqs)
  }
  if suggestions.length() > 2 {
    let all : Array[Plane] = []
    for eqs in suggestions {
      for eq in eqs {
        all.push(eq)
      }
    }
    suggestions.push(all)
  }
  let options = hits.map(h => directions(net, old, h))
  let original_issues : Array[Issue] = []
  ignore(evaluate(view, old, events=Some(original_issues)))
  let original_counts : Map[String, Int32] = Map([])
  for e in original_issues {
    original_counts[e.key] = original_counts.get(e.key).unwrap_or(0) + 1
  }
  fn attempt(extra : Array[Plane]) -> Unit {
    let cs = planes + extra
    let cut_keys : Set[String] = Set([])
    for _ in 0..<14 {
      guard closest_fit(cs, seed) is Some(x) else { return }
      let keys : Array[Int32] = []
      let mut needs_clip = false
      for i, b in vars {
        let ku = (x[4 * i + 2] / b.l).clamp(min=0, max=0.24)
        let kv = (x[4 * i + 3] / b.l).clamp(min=0, max=0.24)
        let f : Fit = {
          mode: "joint-halfplane",
          origin: b.o,
          axis: if ku >= kv {
            b.u
          } else {
            b.v
          },
          isotropic: ku.min(kv),
          drop: (ku - kv).abs(),
          shift: { x: x[4 * i], y: x[4 * i + 1], },
          uniform: false,
        }
        for ri in b.members {
          for p in net.roads[ri].ps {
            let pos = f.at(p)
            if distance(pos, p) > 5.000001 {
              let n = unit(minus(p, pos))
              cs.push(
                face(net, old, vars, { r: b.r, p, }, { r: -1, p, }, n, -4.995),
              )
              needs_clip = true
            }
          }
        }
        keys.push(add_fit(net, f))
      }
      if needs_clip {
        continue
      }
      let byway = all_ids.map(r => {
        keys[vars.search_by(b => b.members.contains(r)).unwrap()]
      })
      if all_ids.mapi((j, i) => !legal_choice(net, i, byway[j])).any(x => x) {
        return
      }
      for j, i in all_ids {
        state[i] = byway[j]
      }
      let issues : Array[Issue] = []
      let ties : Array[Link] = []
      let s = evaluate(view, state, events=Some(issues), links_out=Some(ties))
      trials += 1
      let full = {
        ..s,
        added: s.added + add,
        lost: s.lost + loss,
        tieWet: s.tieWet + delta,
      }
      if hops is Some(archive) {
        candidates_from(state, previous, original_counts, issues, full, archive)
      }
      let improved = full.added <= bound.added &&
        full.lost <= bound.lost &&
        full.waterChange + full.tieWet <=
        previous.waterChange + previous.tieWet + 0.00001 &&
        prefer(full, best)
      if improved {
        best = full
        best_ids = byway
      }
      let mut added_cut = false
      if !improved &&
        !extra.is_empty() &&
        full.added + full.lost <= bound.added + bound.lost + 28 {
        let seen = original_counts.copy()
        for issue in issues {
          let count = seen.get(issue.key).unwrap_or(0)
          if count > 0 {
            seen[issue.key] = count - 1
            continue
          }
          if cut_keys.contains(issue.key) {
            continue
          }
          if issue.lost && issue.key.has_prefix("r/") {
            let i = issue.roads[0]
            let j = issue.roads[1]
            let r = net.roads[i]
            let u = net.roads[j]
            let p = net.points(i, old[i])
            let q = net.points(j, old[j])
            let fixed = for x in 1..<p.length() {
              let done = for y in 1..<q.length() {
                if crosses(p[x - 1], p[x], q[y - 1], q[y]) {
                  let z = contact_point(p[x - 1], p[x], q[y - 1], q[y])
                  let a : Vertex = {
                    r: i,
                    p: mix(r.ps[x - 1], r.ps[x], station(z, p[x - 1], p[x])),
                  }
                  let b : Vertex = {
                    r: j,
                    p: mix(u.ps[y - 1], u.ps[y], station(z, q[y - 1], q[y])),
                  }
                  for
                    n in [
                      P::{ x: 1, y: 0, },
                      { x: -1, y: 0, },
                      { x: 0, y: 1, },
                      { x: 0, y: -1, },
                    ] {
                    cs.push(face(net, old, vars, a, b, n, -0.001))
                  }
                  break true
                }
              } nobreak {
                false
              }
              if done {
                break true
              }
            } nobreak {
              false
            }
            if fixed {
              added_cut = true
              cut_keys.add(issue.key)
            }
          } else if hit_at(view, state, issue, ties) is Some(h) {
            let an = vertex(net, old, h.a)
            let bn = vertex(net, old, h.b)
            let cn = vertex(net, old, h.c)
            let dn = vertex(net, old, h.d)
            let dirs = directions(net, old, h)
            if dirs.is_empty() {
              continue
            }
            let n = dirs[0]
            let gap = dot(n, an).min(dot(n, bn)) - dot(n, cn).max(dot(n, dn))
            if gap >= -0.001 {
              resolve_hit(
                net,
                old,
                vars,
                cs,
                h,
                n,
                if gap < 0.004 {
                  0.0
                } else {
                  0.002
                },
              )
              cut_keys.add(issue.key)
              added_cut = true
            }
          }
        }
      }
      for i in all_ids {
        state[i] = old[i]
      }
      if view.interactions.length() > 85000 {
        view.interactions.clear()
      }
      if net.polylines.length() > 60000 {
        net.polylines.clear()
      }
      if !added_cut {
        return
      }
    }
  }
  for eqs in suggestions {
    attempt(eqs)
    for i in 0..<hits.length() {
      for n in options[i] {
        for margin in [0.004, 0.4, 1.4] {
          let extra = eqs.copy()
          resolve_hit(net, old, vars, extra, hits[i], n, margin)
          attempt(extra)
        }
      }
    }
  }
  for j in 1..<hits.length() {
    for i in 0..<j {
      let ns = options[i]
      let ms = options[j]
      for n in ns[:ns.length().min(3)] {
        for m in ms[:ms.length().min(3)] {
          let extra : Array[Plane] = []
          resolve_hit(net, old, vars, extra, hits[i], n, 0.008)
          resolve_hit(net, old, vars, extra, hits[j], m, 0.008)
          attempt(extra)
        }
      }
    }
  }
  for i, id in all_ids {
    state[id] = best_ids[i]
  }
  let accepted = evaluate(net, state)
  assert_eq((accepted.added, accepted.lost), (best.added, best.lost))
  assert_true(accepted.bridges_ok)
  trials
}

///|
fn fit_streets(
  net : Net,
  state : Array[Int32],
  previous : Score,
  hops~ : Map[String, Hop]? = None,
) -> Int32 raise {
  let mut tries = 0
  for pass in 0..<6 {
    let ev : Array[Issue] = []
    let links : Array[Link] = []
    ignore(evaluate(net, state, events=Some(ev), links_out=Some(links)))
    let sites : Array[P] = []
    for e in ev {
      if !e.lost && !sites.any(p => distance(p, e.at) < 2.5) {
        sites.push(e.at)
      }
    }
    for site in sites {
      let issues : Array[Issue] = []
      let ties : Array[Link] = []
      ignore(evaluate(net, state, events=Some(issues), links_out=Some(ties)))
      let local_hits = issues.filter(e => !e.lost && distance(e.at, site) < 4.0)
      let choices : Map[Int32, Int32] = Map([])
      let hits : Array[Hit] = []
      for e in local_hits {
        if hit_at(net, state, e, ties) is Some(h) {
          hits.push(h)
        }
        for r in e.roads {
          if net.roads[r].eligible {
            choices[r] = choices.get(r).unwrap_or(0) + 1
          }
        }
      }
      if hits.is_empty() || choices.is_empty() {
        continue
      }
      let rs = choices.keys().collect()
      rs.sort_by((a, b) => {
        if choices[a] == choices[b] {
          a.compare(b)
        } else {
          choices[b].compare(choices[a])
        }
      })
      let targets = rs[:rs.length().min(5)].to_owned()
      let groups = [targets]
      for i in targets {
        groups.push([i])
      }
      for ids in groups {
        tries += joint_site(net, state, ids, hits, site, previous, pass, hops~)
      }
    }
    let best = evaluate(net, state)
    println(
      "Joint affine fit pass \{pass}: \{best.added}/\{best.lost}, \{tries} valid trials",
    )
  }
  tries
}

///|
struct SeamMeasure {
  score : Score
  count : Int32
  length : Double
  outer : Int32
}

///|
fn seam_measure(net : Net, state : Array[Int32]) -> SeamMeasure {
  let links : Array[Link] = []
  let score = evaluate(net, state, links_out=Some(links))
  {
    score,
    count: links.length(),
    length: links.fold(init=0.0, (a, l) => a + distance(l.a, l.b)),
    outer: net.roads
    .mapi((i, r) => if !r.inner && state[i] != 0 { 1 } else { 0 })
    .fold(init=0, (a, b) => a + b),
  }
}

///|
fn compact_seams(
  net : Net,
  state : Array[Int32],
  initial : Score,
) -> Int32 raise {
  let mut best = seam_measure(net, state)
  let mut tries = 0
  let limit = best
  let mut selected = state.copy()
  fn consider(candidate : Array[Int32]) -> Unit {
    let value = seam_measure(net, candidate)
    tries += 1
    if !value.score.bridges_ok ||
      value.score.added > limit.score.added ||
      value.score.lost > limit.score.lost ||
      value.score.waterChange + value.score.tieWet >
      initial.waterChange + initial.tieWet + 0.00001 {
      return
    }
    if value.count > limit.count || value.length > limit.length + 0.0001 {
      return
    }
    let cmp = (
      value.score.added + value.score.lost,
      value.score.lost,
      value.count,
    ).compare((best.score.added + best.score.lost, best.score.lost, best.count))
    if cmp < 0 ||
      (
        cmp == 0 &&
        (
          value.length < best.length - 0.0001 ||
          (
            (value.length - best.length).abs() <= 0.0001 &&
            value.outer < best.outer
          )
        )
      ) {
      best = value
      selected = candidate.copy()
    }
  }
  for round in 0..<5 {
    let begin = best
    let ks = Set(state).to_array()
    for label in ks {
      let root = selected
      for seam in [0.5, 2.0, 6.0, 16.0] {
        let m = cut_groups(
          net,
          root,
          label,
          seam,
          if label == 0 {
            0.08
          } else {
            0.6
          },
        )
        if m != root {
          consider(m)
        }
      }
    }
    for i, k in selected {
      state[i] = k
    }
    let moves = Set(state).to_array()
    let proposals : Array[Array[Int32]] = []
    fn group(g : Array[Int32]) -> Unit {
      if !g.is_empty() && !proposals.contains(g) {
        proposals.push(g)
      }
    }
    for a in moves {
      if a == 0 {
        continue
      }
      let ids = net.roads
        .mapi((i, r) => if r.eligible && state[i] == a { i } else { -1 })
        .filter(i => i >= 0)
      group(ids)
      let rest = Set(ids)
      while !rest.is_empty() {
        let i = rest.to_array()[0]
        let q = [i]
        rest.remove(i)
        let mut j = 0
        while j < q.length() {
          let v = q[j]
          j += 1
          for s in net.sockets {
            if s.owners.contains(v) {
              for n in s.owners {
                if rest.contains(n) {
                  rest.remove(n)
                  q.push(n)
                }
              }
            }
          }
        }
        group(q)
      }
    }
    for s in net.sockets {
      let gs = Set(s.owners.map(i => state[i])).to_array()
      if gs.length() < 2 {
        continue
      }
      let ids = s.owners.filter(i => net.roads[i].eligible)
      group(ids)
      for i in ids {
        group([i])
      }
    }
    for ids in proposals {
      let source = selected
      let labels = Set([0])
      for s in net.sockets {
        if s.owners.any(i => ids.contains(i)) {
          for i in s.owners {
            labels.add(source[i])
          }
        }
      }
      for k in labels {
        if ids.all(i => source[i] == k) ||
          ids.any(i => !legal_choice(net, i, k)) {
          continue
        }
        let m = source.copy()
        for i in ids {
          m[i] = k
        }
        consider(m)
      }
    }
    for i, k in selected {
      state[i] = k
    }
    println(
      "Seam minimization \{round}: \{best.score.added}/\{best.score.lost} / \{best.count} links / \{best.length} cells",
    )
    if begin.count == best.count &&
      begin.length == best.length &&
      begin.score.added == best.score.added {
      break
    }
  }
  let actual = seam_measure(net, state)
  assert_eq(actual.count, best.count)
  assert_true(actual.score.bridges_ok)
  tries
}

///|
struct Hop {
  state : Array[Int32]
  score : Score
  cleared : Int32
}

///|
fn candidates_from(
  state : Array[Int32],
  baseline : Score,
  original : Map[String, Int32],
  issues : Array[Issue],
  s : Score,
  archive : Map[String, Hop],
) -> Unit {
  if !s.bridges_ok ||
    s.lost > baseline.lost ||
    s.added > baseline.added + 5 ||
    s.waterChange + s.tieWet > baseline.waterChange + baseline.tieWet + 0.25 {
    return
  }
  let counts : Map[String, Int32] = Map([])
  for e in issues {
    counts[e.key] = counts.get(e.key).unwrap_or(0) + 1
  }
  let keys : Array[String] = []
  let mut restored = 0
  for key, n in original {
    let k = counts.get(key).unwrap_or(0)
    if k < n {
      keys.push(key)
      restored += n - k
    }
  }
  if restored == 0 {
    return
  }
  keys.sort()
  let signature = Json(keys).stringify()
  if archive.get(signature) is Some(old) && !prefer(s, old.score) {
    return
  }
  archive[signature] = { state: state.copy(), score: s, cleared: restored, }
}

///|
fn escape_pass(
  net : Net,
  state : Array[Int32],
  previous : Score,
  limit : Int32,
) -> Int32 raise {
  let anchor = state.copy()
  let mut best = evaluate(net, state)
  let mut winner = state.copy()
  let archive : Map[String, Hop] = Map([])
  let mut tries = fit_streets(net, state, previous, hops=Some(archive))
  let entry = evaluate(net, state)
  if prefer(entry, best) {
    best = entry
    winner = state.copy()
  }
  let choices = archive.values().collect()
  choices.sort_by((a, b) => {
    let x = (a.score.added - 2 * a.cleared).compare(
      b.score.added - 2 * b.cleared,
    )
    if x == 0 {
      a.score.travel.compare(b.score.travel)
    } else {
      x
    }
  })
  let mut taken = 0
  let mut gates = 0
  for h in choices {
    if taken >= limit {
      break
    }
    taken += 1
    for i, k in h.state {
      state[i] = k
    }
    for pass in 0..<3 {
      let scores : Array[Issue] = []
      let before = evaluate(net, state, events=Some(scores))
      let groups = groups_for(net, state, 0)
      for i, r in net.roads {
        if state[i] != anchor[i] && r.eligible {
          let depend = scores.filter(e => e.roads.contains(i))
          for e in depend {
            for j in e.roads {
              if j != i && net.roads[j].eligible {
                groups.push([i, j])
                groups.push([j])
              }
            }
          }
        }
      }
      let labels = Set(state).to_array()
      for ids in groups {
        let v = pocket(net, state, Set(ids))
        let orig = ids.map(i => state[i])
        let old = evaluate(v, state)
        let full = evaluate(net, state)
        let a = full.added - old.added
        let l = full.lost - old.lost
        let w = full.tieWet - old.tieWet
        let mut local_best = full
        let mut picked = -1
        let ks = labels.copy()
        for i in ids {
          if !ks.contains(anchor[i]) {
            ks.push(anchor[i])
          }
        }
        for k in ks {
          if orig.all(j => j == k) || ids.any(i => !legal_choice(net, i, k)) {
            continue
          }
          for i in ids {
            state[i] = k
          }
          let score = evaluate(v, state)
          tries += 1
          let s = {
            ..score,
            added: a + score.added,
            lost: l + score.lost,
            tieWet: w + score.tieWet,
          }
          if prefer(s, local_best) &&
            s.waterChange + s.tieWet <=
            previous.waterChange + previous.tieWet + 0.25 {
            local_best = s
            picked = k
          }
        }
        for j, i in ids {
          state[i] = if picked < 0 { orig[j] } else { picked }
        }
      }
      let s = evaluate(net, state)
      if s.bridges_ok &&
        s.added <= previous.added &&
        s.lost <= previous.lost &&
        s.waterChange + s.tieWet <=
        previous.waterChange + previous.tieWet + 0.00001 &&
        prefer(s, best) {
        best = s
        winner = state.copy()
        gates += 1
      }
      if pass == 0 && s.added > best.added + 4 {
        break
      }
      if s.added == before.added && s.travel == before.travel {
        break
      }
    }
  }
  for i, k in winner {
    state[i] = k
  }
  println(
    "Basin search: \{choices.length()} alternatives, \{taken} repaired, \{gates} improvements, \{best.added}/\{best.lost}",
  )
  tries
}

///|
fn plan_qinbei(net : Net) -> Fit {
  let i = net.roads.search_by(r => r.id == 47518657).unwrap()
  let pixels = [P::{ x: 1175, y: 457, }, { x: 1191, y: 437, }]
  let picks = pixels.map(p => P::{ x: p.x * 256 / 1672, y: p.y * 144 / 941, })
  let src = net.roads[i].ps
  let shift = minus(mix(picks[0], picks[1], 0.5), mix(src[0], src[1], 0.5))
  { ..net.fits[0], mode: "qinbei-design-translation", shift, }
}

///|
fn head_placements(net : Net, state : Array[Int32]) -> Int32 {
  let d = net.roads.search_by(r => r.id == 47518902).unwrap()
  let q = net.roads.search_by(r => r.id == 47518657).unwrap()
  let a = net.sockets[net.sockets.search_by(s => s.node == 605039789).unwrap()]
  let b = net.sockets[net.sockets.search_by(s => s.node == 3351127195).unwrap()]
  let reg = plan_qinbei(net)
  let j = add_fit(net, reg)
  let qother = net.roads.search_by(r => r.id == 47518656).unwrap()
  state[q] = j
  let qt = fit_southern_approach(net, qother, j)
  state[qother] = qt
  let unit_a = a.deck[0]
  let unit_b = b.deck[0]
  let aa = a.p
  let bb = b.p
  let length = distance(aa, bb)
  let u = unit(minus(bb, aa))
  let v = P::{ x: -u.y, y: u.x, }
  let inner = net.roads
    .mapi((i, r) => if r.inner { i } else { -1 })
    .filter(i => i >= 0)
  let src = net.roads[d].ps
  let pts : Array[P] = []
  for i in inner {
    for p in net.roads[i].ps {
      pts.push(p)
    }
  }
  let h = hull(pts)
  let base = state.copy()
  let mut best = 1000000
  let mut bestwet = 100.0
  let mut win = base.copy()
  let mut tries = 0
  let mut dry = 0
  let mut full = 0
  let mut bridges = 0
  let rels = net.pairs.filter(p => {
    p.original > 0 &&
    (
      (net.roads[p.a].structure && net.roads[p.b].inner) ||
      (net.roads[p.b].structure && net.roads[p.a].inner)
    )
  })
  let mut minloss = 100
  let land = net.water
  for k in 0..<1300000 {
    let an = (radical(k + 1, 2) - 0.5) * 0.52355
    let bn = (radical(k + 1, 3) - 0.5) * 0.52355
    let al = radical(k + 1, 5) * 5.4
    let bl = if k % 4 == 0 { 0.0 } else { radical(k + 1, 7) * 5.4 }
    let da = P::{
      x: al * (unit_a.x * @math.cos(an) - unit_a.y * @math.sin(an)),
      y: al * (unit_a.y * @math.cos(an) + unit_a.x * @math.sin(an)),
    }
    let db = P::{
      x: reg.shift.x +
      bl * (unit_b.x * @math.cos(bn) - unit_b.y * @math.sin(bn)),
      y: reg.shift.y +
      bl * (unit_b.y * @math.cos(bn) + unit_b.x * @math.sin(bn)),
    }
    let diff = minus(da, db)
    let m00 = dot(diff, u) / length
    let m01 = dot(diff, v) / length
    if m00 < 0.0000001 {
      continue
    }
    let low = m01 * m01 / m00
    if low > 0.4 {
      continue
    }
    let m11 = low + radical(k + 1, 11) * 0.145
    let spread = ((m00 - m11) * (m00 - m11) + 4 * m01 * m01).sqrt()
    let iso = ((m00 + m11 - spread) * 0.5).max(0)
    let alpha = 0.5 * @math.atan2(2 * m01, m00 - m11)
    let axis = P::{
      x: u.x * @math.cos(alpha) + v.x * @math.sin(alpha),
      y: u.y * @math.cos(alpha) + v.y * @math.sin(alpha),
    }
    let f = {
      ..net.fits[0],
      mode: "bridgehead-contraction",
      axis,
      drop: spread,
      isotropic: iso,
      origin: aa,
      shift: da,
    }
    if h.any(p => distance(f.at(p), p) > 5) {
      continue
    }
    if measure(snap(aa), snap(f.at(aa)), land, 0.12) > 0 {
      continue
    }
    tries += 1
    let line = src.map(p => snap(f.at(p)))
    let wet = for n in 1..<line.length() {
      if measure(line[n - 1], line[n], land, 0.12) > 0 {
        break true
      }
    } nobreak {
      false
    }
    if wet {
      continue
    }
    dry += 1
    let mut missing = 0
    for pair in rels {
      let ai = if net.roads[pair.a].inner { pair.a } else { pair.b }
      let bi = if ai == pair.a { pair.b } else { pair.a }
      let ap = if ai == d {
        line
      } else {
        net.roads[ai].ps.map(p => snap(f.at(p)))
      }
      let bp = net.points(bi, state[bi])
      let mut hits = 0
      for (ar, br) in pair.edges {
        let an = if ai == pair.a { ar } else { br }
        let bn = if ai == pair.a { br } else { ar }
        if crosses(ap[an - 1], ap[an], bp[bn - 1], bp[bn]) {
          hits += 1
        }
      }
      missing += (pair.original - hits).max(0)
    }
    if missing > minloss + 1 {
      continue
    }
    minloss = minloss.min(missing)
    let id = add_fit(net, f)
    for i in inner {
      state[i] = id
    }
    let s = evaluate(net, state)
    full += 1
    if s.bridges_ok {
      bridges += 1
    }
    let wet = s.waterChange + s.tieWet
    let rating = s.added + 3 * s.lost
    if s.bridges_ok &&
      (rating < best || (rating == best && wet < bestwet)) &&
      (net.wet(qother, 0) > 0.00001 || net.wet(qother, qt) <= 0.00001) {
      best = rating
      win = state.copy()
      bestwet = wet
      println(
        "Registered fit \{s.added}/\{s.lost}, water \{wet}, core \{Json(f).stringify()}",
      )
    }
    if net.polylines.length() > 30000 {
      net.polylines.clear()
    }
    if net.interactions.length() > 60000 {
      net.interactions.clear()
    }
  }
  println(
    "Head search: \{tries} bounded, \{dry} dry, \{minloss} minimum core losses, \{full} full, \{bridges} joined; coarse rating \{best}.",
  )
  if best == 1000000 {
    for i in 0..<state.length() {
      state[i] = base[i]
    }
    state[q] = 0
    state[qother] = 0
    abort("No valid design registration in sweep")
  }
  for i, k in win {
    state[i] = k
  }
  full
}

///|
fn fit_southern_approach(net : Net, road : Int32, deck : Int32) -> Int32 {
  let r = net.roads[road]
  let s0 = net.sockets[net.sockets.search_by(s => s.node == r.nodes[0]).unwrap()]
  let s1 = net.sockets[net.sockets
    .search_by(s => s.node == r.nodes.last().unwrap())
    .unwrap()]
  let far = s0.p
  let near = s1.p
  let origwet = net.wet(road, 0)
  let wetmax = if origwet < 0.00001 { 0.00001 } else { origwet }
  let mut score = 1.0e8
  let mut winner = -1
  let mut count = 0
  fn offset(p : P, n : P, len : Double, angle : Double) -> P {
    let c = @math.cos(angle) * len
    let s = @math.sin(angle) * len
    { x: p.x + n.x * c - n.y * s, y: p.y + n.y * c + n.x * s, }
  }
  for k in 0..<180000 {
    let a = offset(
      far,
      s0.deck[0],
      radical(k + 1, 2) * 3.8,
      (radical(k + 1, 3) - 0.5) * 0.512,
    )
    let b = offset(
      net.fits[deck].at(near),
      s1.deck[0],
      radical(k + 1, 5) * 4.8,
      (radical(k + 1, 7) - 0.5) * 0.512,
    )
    let src = minus(near, far)
    let out = minus(b, a)
    let diff = minus(src, out)
    let sq = dot(diff, diff)
    let v = dot(diff, src)
    if v <= 0 || sq / v >= 0.6 {
      continue
    }
    let f = {
      ..net.fits[0],
      origin: far,
      axis: unit(diff),
      shift: minus(a, far),
      drop: sq / v,
      mode: "district-approach",
    }
    if r.ps.any(p => distance(f.at(p), p) > 5) {
      continue
    }
    let ls = r.ps.map(p => snap(f.at(p)))
    let mut wet = 0.0
    for i in 1..<ls.length() {
      wet += measure(ls[i - 1], ls[i], net.water, r.pad)
    }
    if wet > wetmax {
      continue
    }
    let wa = measure(snap(far), ls[0], net.water, r.pad)
    let wb = measure(
      snap(net.fits[deck].at(near)),
      ls.last().unwrap(),
      net.water,
      r.pad,
    )
    let cost = (wa + wb + wet) * 100 +
      distance(far, a) +
      distance(b, net.fits[deck].at(near))
    if cost < score {
      score = cost
      winner = add_fit(net, f)
      count += 1
    }
  }
  println(
    "Southern Qinbei approach wet before \{origwet}, planned fit score \{score} updates \{count}",
  )
  if winner < 0 {
    0
  } else {
    winner
  }
}

///|
fn coupled_bank(net : Net, state : Array[Int32], prior : Score) -> Int32 {
  let outer_limit = prior.waterChange + prior.tieWet
  let d = net.roads.search_by(r => r.id == 47518902).unwrap()
  let head = net.sockets[net.sockets
    .search_by(s => s.node == 605039789)
    .unwrap()].p
  let groups = net.roads
    .mapi((i, r) => if r.inner { i } else { -1 })
    .filter(i => i >= 0)
  let pts : Array[P] = []
  for i in groups {
    for p in net.roads[i].ps {
      pts.push(p)
    }
  }
  let corners = hull(pts)
  let src = net.roads[d].ps
  let mut best = evaluate(net, state)
  let mut tries = 0
  let mut best_ground = best.waterChange + best.tieWet
  for pass in 0..<6 {
    let base = state.copy()
    let orig = net.fits[state[d]]
    let mut winner = state.copy()
    let anchors = [orig.origin, head, src[25], src[50], src.last().unwrap()]
    let tied = Set(groups)
    for s in net.sockets {
      if s.owners.any(i => net.roads[i].inner) {
        for i in s.owners {
          if net.roads[i].eligible && state[i] == base[d] {
            tied.add(i)
          }
        }
      }
    }
    for n in 1..<=10000 {
      let pivot = anchors[n % anchors.length()]
      let z = [0.001, 0.015, 0.06, 0.2, 0.63, 1.65][n / 5 % 6] *
        [1.0, 0.7, 0.4][pass % 3]
      let t = (radical(n + pass * 10001, 2) - 0.5) * z * 0.8
      let shift = minus(orig.at(pivot), pivot)
      let fit = {
        ..orig,
        origin: pivot,
        mode: "dike-district",
        shift: {
          x: shift.x + (radical(n, 3) - 0.5) * z,
          y: shift.y + (radical(n, 5) - 0.5) * z,
        },
        axis: {
          x: orig.axis.x * @math.cos(t) - orig.axis.y * @math.sin(t),
          y: orig.axis.y * @math.cos(t) + orig.axis.x * @math.sin(t),
        },
        drop: (orig.drop + (radical(n, 7) - 0.5) * 0.025 * z).max(0),
        isotropic: (orig.isotropic + (radical(n, 11) - 0.35) * 0.018 * z).max(0),
      }
      if corners.any(p => distance(fit.at(p), p) > 5) {
        continue
      }
      if measure(snap(head), snap(fit.at(head)), net.water, 0.12) > 0 {
        continue
      }
      let line = src.map(p => snap(fit.at(p)))
      let wet = for i in 1..<line.length() {
        if measure(line[i - 1], line[i], net.water, 0.12) > 0 {
          break true
        }
      } nobreak {
        false
      }
      if wet {
        continue
      }
      let key = add_fit(net, fit)
      for pattern in 0..<2 {
        for i in groups {
          state[i] = key
        }
        if pattern == 1 {
          for i in tied {
            state[i] = key
          }
        }
        let score = evaluate(net, state)
        tries += 1
        let ground = score.waterChange + score.tieWet
        if score.bridges_ok &&
          ground <= outer_limit + 1.0e-8 &&
          score.added <= best.added &&
          score.lost <= best.lost &&
          (
            score.added < best.added ||
            score.lost < best.lost ||
            ground < best_ground - 0.000001
          ) {
          best = score
          best_ground = ground
          winner = state.copy()
        }
      }
      for i in tied {
        state[i] = base[i]
      }
      if net.interactions.length() > 70000 {
        net.interactions.clear()
      }
      if net.polylines.length() > 30000 {
        net.polylines.clear()
      }
    }
    for i, k in winner {
      state[i] = k
    }
    println(
      "Whole core \{pass}: \{best.added}/\{best.lost} ground \{best_ground}, \{tries} trials.",
    )
  }
  tries
}

///|
fn improve_road_groups(
  net : Net,
  state : Array[Int32],
  prior : Score,
) -> Int32 raise {
  let mut best = evaluate(net, state)
  let ceiling = prior.waterChange + prior.tieWet
  let mut tries = 0
  for pass in 0..<4 {
    let issues : Array[Issue] = []
    let ties : Array[Link] = []
    ignore(evaluate(net, state, events=Some(issues), links_out=Some(ties)))
    let groups : Array[Array[Int32]] = []
    fn add(ids : Array[Int32]) -> Unit {
      let ids = ids.filter(i => net.roads[i].eligible)
      ids.sort()
      if !ids.is_empty() && !groups.contains(ids) {
        groups.push(ids)
      }
    }
    for e in issues {
      if !e.lost {
        let involved = e.roads.filter(i => net.roads[i].eligible)
        for i in involved {
          add([i])
        }
        add(involved)
        for i in involved {
          let same = net.roads
            .mapi((j, r) => {
              if r.eligible && state[j] != 0 && state[j] == state[i] {
                j
              } else {
                -1
              }
            })
            .filter(k => k >= 0)
          add(same)
          for s in net.sockets {
            if s.owners.contains(i) && distance(s.p, e.at) < 7 {
              add(s.owners)
              let cluster = Set(s.owners.filter(k => net.roads[k].eligible))
              for v in net.sockets {
                if distance(v.p, s.p) < 4 &&
                  v.owners.any(k => cluster.contains(k)) {
                  for k in v.owners {
                    if net.roads[k].eligible {
                      cluster.add(k)
                    }
                  }
                }
              }
              add(cluster.to_array())
            }
          }
        }
      }
    }
    for l in ties {
      if measure(l.a, l.b, net.water, l.pad) > 0 {
        add(net.sockets[l.socket].owners)
      }
    }
    for ids in groups {
      let old = ids.map(i => state[i])
      let view = pocket(net, state, Set(ids))
      let sub = evaluate(view, state)
      let da = best.added - sub.added
      let dl = best.lost - sub.lost
      let dw = best.tieWet - sub.tieWet
      let mut pick = old.copy()
      let pins : Array[P] = []
      for s in net.sockets {
        if s.owners.any(i => ids.contains(i)) &&
          !s.owners.all(i => ids.contains(i)) {
          pins.push(s.p)
        }
      }
      if pins.is_empty() {
        pins.push(net.roads[ids[0]].ps[0])
      }
      for n in 1..<=1200 {
        let pivot = pins[n % pins.length()]
        let z = [0.004, 0.05, 0.25, 0.9, 2.4, 4.8][n / pins.length() % 6]
        let dx = z * (radical(n + pass * 1200, 2) - 0.5)
        let dy = z * (radical(n + pass * 1200, 3) - 0.5)
        let theta = (radical(n, 5) - 0.5) * z * 0.9
        let drop = (radical(n, 7) - 0.5) * z * 0.095
        let iso = (radical(n, 11) - 0.4) * z * 0.05
        let chosen : Map[Int32, Int32] = Map([])
        let mut legal = true
        for j, i in ids {
          let k = chosen.get_or_init(old[j], () => {
            let f = net.fits[old[j]]
            let s = minus(f.at(pivot), pivot)
            let trial = {
              ..f,
              mode: "district-compression",
              shift: { x: s.x + dx, y: s.y + dy, },
              origin: pivot,
              axis: {
                x: f.axis.x * @math.cos(theta) - f.axis.y * @math.sin(theta),
                y: f.axis.y * @math.cos(theta) + f.axis.x * @math.sin(theta),
              },
              drop: (f.drop + drop).max(0),
              isotropic: (f.isotropic + iso).max(0),
            }
            add_fit(net, trial)
          })
          if !legal_choice(net, i, k) {
            legal = false
            break
          }
          state[i] = k
        }
        if legal {
          let s = evaluate(view, state)
          tries += 1
          let ground = s.waterChange + s.tieWet + dw
          let old_ground = best.waterChange + best.tieWet
          if s.bridges_ok &&
            s.added + da <= best.added &&
            s.lost + dl <= best.lost &&
            ground <= ceiling + 0.000001 &&
            (
              s.added + da < best.added ||
              s.lost + dl < best.lost ||
              ground < old_ground - 0.00002
            ) {
            let full = evaluate(net, state)
            if full.bridges_ok {
              assert_eq((s.added + da, s.lost + dl), (full.added, full.lost))
              best = full
              pick = ids.map(i => state[i])
            }
          }
        }
        for j, i in ids {
          state[i] = old[j]
        }
        if net.interactions.length() > 80000 {
          net.interactions.clear()
        }
        if net.polylines.length() > 25000 {
          net.polylines.clear()
        }
        if view.interactions.length() > 60000 {
          view.interactions.clear()
        }
      }
      for j, i in ids {
        state[i] = pick[j]
      }
    }
    println(
      "Peripheral stress repair \{pass}: \{best.added}/\{best.lost}, water \{best.waterChange+best.tieWet}, \{tries} placements",
    )
  }
  tries
}

///|
fn binary_assignment(
  clauses : Array[Array[Int32]],
  count : Int32,
) -> Array[Int32]? {
  fn solve(a : Array[Int32]) -> Array[Int32]? {
    for ;; {
      let mut changed = false
      let mut next = -1
      let mut small = count + 2
      for clause in clauses {
        let mut open = 0
        let mut unknown = 0
        let mut hit = false
        for literal in clause {
          let value = a[literal.abs() - 1]
          if value < 0 {
            open += 1
            unknown = literal
          } else if (value == 1) == (literal > 0) {
            hit = true
            break
          }
        }
        if hit {
          continue
        }
        if open == 0 {
          return None
        }
        if open == 1 {
          a[unknown.abs() - 1] = if unknown > 0 { 1 } else { 0 }
          changed = true
        }
        if open < small {
          small = open
          next = unknown.abs() - 1
        }
      }
      if changed {
        continue
      }
      if next < 0 {
        return Some(a.map(k => if k < 0 { 0 } else { k }))
      }
      let t = a.copy()
      t[next] = 0
      if solve(t) is Some(m) {
        return Some(m)
      }
      a[next] = 1
    }
  }
  solve(Array::make(count, -1))
}

///|
struct RoadCandidate {
  fit : Fit
  wet : Double
  travel : Double
}

///|
fn major_corridors(
  net : Net,
  state : Array[Int32],
  linked~ : Bool = false,
) -> Int32 {
  let mut runs = 0
  for pass in 0..<3 {
    let wet_ids = net.roads
      .mapi((i, r) => {
        if r.eligible &&
          !r.inner &&
          net.wet(i, state[i]) > (if pass == 0 { 4.0 } else { 1.8 }) {
          i
        } else {
          -1
        }
      })
      .filter(i => i >= 0)
    wet_ids.sort_by((i, j) => {
      (net.wet(j, state[j]) * net.roads[j].pad).compare(
        net.wet(i, state[i]) * net.roads[i].pad,
      )
    })
    let groups : Array[Array[Int32]] = []
    for i in wet_ids {
      let r = net.roads[i]
      if r.name != "" {
        let peers = net.sockets
          .filter(s => s.owners.contains(i))
          .map(s => s.owners)
        let same = Set([i])
        for group in peers {
          for j in group {
            if net.roads[j].eligible &&
              !net.roads[j].inner &&
              net.roads[j].name == r.name &&
              net.wet(j, state[j]) > 0 {
              same.add(j)
            }
          }
        }
        let ids = same.to_array()
        ids.sort()
        if ids.length() > 1 && !groups.contains(ids) {
          groups.push(ids)
        }
      }
      groups.push([i])
    }
    let mut changes = 0
    for ids in groups {
      let old = ids.map(i => state[i])
      let raw : Array[P] = []
      for i in ids {
        for p in net.roads[i].ps {
          raw.push(p)
        }
      }
      let corners = hull(raw)
      let box = bounds(raw)
      let o = mix(box.lo, box.hi, 0.5)
      let nearheads = net.sockets.filter(s => {
        s.owners.any(i => ids.contains(i)) && !s.deck.is_empty()
      })
      let anchors = [o, raw[0], raw.last().unwrap()]
      for s in nearheads {
        if !anchors.contains(s.p) {
          anchors.push(s.p)
        }
      }
      let chord = minus(raw.last().unwrap(), raw[0])
      let along = if dot(chord, chord).sqrt() > 0.000001 {
        unit(chord)
      } else {
        P::{ x: 1, y: 0, }
      }
      let across = P::{ x: -along.y, y: along.x, }
      let start_wet = ids.fold(init=0.0, (n, i) => {
        n + net.wet(i, state[i]) * net.roads[i].pad * 2
      })
      let source_f = net.fits[old[0]]
      let options : Map[(Int32, Int32, Int32), RoadCandidate] = Map([])
      for n in 0..<(if linked { 3800 } else { 1550 }) {
        let pivot = if nearheads.length() > 0 && n % 3 != 0 {
          nearheads[n % nearheads.length()].p
        } else {
          anchors[n % anchors.length()]
        }
        let t = radical(n + 1 + pass * 1551, 2) * 6.283185307
        let magnitude = if n % 5 == 0 {
          0.0
        } else {
          radical(n + 1, 3) * [4.95, 2.6, 1.25][pass]
        }
        let dir = if nearheads.length() > 0 && n % 3 == 1 {
          nearheads[n % nearheads.length()].deck[0]
        } else {
          P::{ x: @math.cos(t), y: @math.sin(t), }
        }
        let v = minus(source_f.at(pivot), pivot)
        let angle = radical(n + 1, 5) * 3.1415926536
        let axis = if n % 4 == 0 {
          across
        } else if n % 4 == 1 {
          along
        } else {
          { x: @math.cos(angle), y: @math.sin(angle), }
        }
        let k = if n % 3 == 0 { 0.0 } else { radical(n + 1, 7) * 0.19 }
        let default_fit = if n % 3 == 0 {
          {
            ..source_f,
            origin: pivot,
            shift: { x: v.x + magnitude * dir.x, y: v.y + magnitude * dir.y, },
            mode: "bank-translation",
          }
        } else {
          {
            ..net.fits[0],
            axis,
            drop: k,
            origin: pivot,
            shift: { x: v.x + magnitude * dir.x, y: v.y + magnitude * dir.y, },
            mode: "bank-compression",
          }
        }
        let f = if linked && nearheads.length() > 1 && n % 2 == 0 {
          let first = nearheads[n / 2 % nearheads.length()]
          let second = nearheads[(n / 2 + 1) % nearheads.length()]
          fn target(s : Socket, len : Double) -> P {
            { x: s.p.x + s.deck[0].x * len, y: s.p.y + s.deck[0].y * len, }
          }
          let a = if n % 7 < 4 { 0.0 } else { radical(n + 1, 3) * 4 }
          let b = if n % 5 < 3 { 0.0 } else { radical(n + 1, 7) * 4 }
          let f = fit_two_heads(
            first.p,
            second.p,
            target(first, a),
            target(second, b),
            radical(n + 1, 11) * 0.37,
          )
          guard f is Some(f) else { continue }
          f
        } else {
          default_fit
        }
        let travel = corners.fold(init=0.0, (v, p) => {
          v.max(distance(p, f.at(p)))
        })
        if travel > 5.0 ||
          nearheads.any(s => {
            let delta = minus(snap(f.at(s.p)), snap(s.p))
            s.deck.any(v => {
              dot(delta, v) < dot(delta, delta).sqrt() * 0.965925826 - 0.00011
            })
          }) {
          continue
        }
        let mut wet = 0.0
        let mut penalize = false
        for i in ids {
          let r = net.roads[i]
          let ps = r.ps.map(p => snap(f.at(p)))
          let mut w = 0.0
          for j in 1..<ps.length() {
            w += measure(ps[j - 1], ps[j], net.water, r.pad)
          }
          if w > net.wet(i, state[i]) + 0.000005 ||
            lost_to_frame(net.points(i, state[i]), ps, net.water, r.pad) >
            0.000001 ||
            lost_to_frame(net.points(i, 0), ps, net.water, r.pad) > 0.000001 {
            penalize = true
            break
          }
          wet += w * r.pad * 2
        }
        if penalize || wet > start_wet - 0.015 {
          continue
        }
        let bin = ((f.at(o).x - o.x) * 2).round().to_int()
        let row = ((f.at(o).y - o.y) * 2).round().to_int()
        let key = (bin, row, (f.drop * 20).round().to_int())
        let rank = wet + travel * 0.003
        if options.get(key) is Some(c) && c.wet + c.travel * 0.003 <= rank {
          continue
        }
        options[key] = { fit: f, wet, travel, }
      }
      let opts = options.values().collect()
      opts.sort_by((a, b) => {
        (a.wet + a.travel * 0.003).compare(b.wet + b.travel * 0.003)
      })
      let view = pocket(net, state, Set(ids))
      let before = evaluate(view, state)
      let mut best = before
      let mut winner = -1
      let mut gain = 0.0
      let mut group_winner = state.copy()
      let snapshot = state.copy()
      if linked {
        let head_count = nearheads.length()
        println(
          "Priority " +
          net.roads[ids[0]].id.to_string() +
          " wet " +
          start_wet.to_string() +
          " bridge sockets " +
          head_count.to_string() +
          " viable geometries " +
          opts.length().to_string(),
        )
        for
          c in opts[:opts.length().min(if start_wet >= 2.0 { 85 } else { 15 })] {
          let k = add_fit(net, c.fit)
          runs += 1
          if adopt_corridor(net, ids, k, snapshot) is Some((m, benefit)) {
            if benefit > gain {
              gain = benefit
              winner = k
              group_winner = m
            }
          }
        }
      } else {
        for c in opts {
          let k = add_fit(net, c.fit)
          for i in ids {
            state[i] = k
          }
          let sc = evaluate(view, state)
          runs += 1
          let delta = start_wet -
            c.wet -
            (sc.tieWet - before.tieWet).max(0) * 0.24
          if sc.bridges_ok &&
            sc.lost <= before.lost &&
            sc.added <= before.added &&
            sc.waterChange + sc.tieWet <
            before.waterChange + before.tieWet - 0.05 &&
            (delta > gain + 0.00001 || (delta >= gain && prefer(sc, best))) {
            winner = k
            gain = delta
            best = sc
          }
        }
      }
      if linked {
        for i, k in group_winner {
          state[i] = k
        }
      } else {
        for j, i in ids {
          state[i] = if winner >= 0 { winner } else { old[j] }
        }
      }
      if winner >= 0 {
        changes += 1
        println(
          "Bank road \{net.roads[ids[0]].id} \{net.roads[ids[0]].name} : \{start_wet} -> \{ids.fold(init=0.0,(w,i)=>w+2*net.roads[i].pad*net.wet(i,state[i]))}, group \{ids.length()}",
        )
      }
      if net.interactions.length() > 100000 {
        net.interactions.clear()
      }
      if net.polylines.length() > 45000 {
        net.polylines.clear()
      }
    }
    println(
      "Bank pass \{pass}: \{changes} improved / \{runs} network candidates, \{Json(evaluate(net,state)).stringify()}",
    )
    if changes == 0 {
      break
    }
  }
  runs
}

///|
struct WetRun {
  length : Double
  points : Array[P]
} derive(ToJson)

///|
fn wet_runs(ps : Array[P], water : Array[Bool], pad : Double) -> Array[WetRun] {
  let out : Array[WetRun] = []
  for i in 1..<ps.length() {
    let a = ps[i - 1]
    let b = ps[i]
    for (start, end) in intervals(a, b, water, pad) {
      let left = mix(a, b, start)
      let right = mix(a, b, end)
      let delta = distance(left, right)
      if delta <= 0.00000001 {
        continue
      }
      if out.last() is Some(last) &&
        distance(last.points.last().unwrap(), left) < 0.0000001 {
        last.points.push(right)
        out[out.length() - 1] = { ..last, length: last.length + delta, }
      } else {
        out.push({ length: delta, points: [left, right], })
      }
    }
  }
  out
}

///|
struct MarkedRoad {
  id : String
  name : String
  kind : String
  ways : Array[Double]
  junction : Double?
  width : Double
  before : Double
  after : Double
  longest : Double
  priority : Double
  point : P
  oldRuns : Array[WetRun]
  runs : Array[WetRun]
} derive(ToJson)

///|
fn summary_road(
  id : String,
  name : String,
  kind : String,
  ways : Array[Double],
  junction : Double?,
  pad : Double,
  old : Array[WetRun],
  now : Array[WetRun],
) -> MarkedRoad {
  let sum = (rs : Array[WetRun]) => rs.fold(init=0.0, (w, r) => w + r.length)
  let here = if now.is_empty() { old } else { now }
  let sorted = here.copy()
  sorted.sort_by((a, b) => b.length.compare(a.length))
  let run = sorted[0]
  let halfway = run.length / 2
  let mut used = 0.0
  let mut p = run.points[0]
  for i in 1..<run.points.length() {
    let a = run.points[i - 1]
    let b = run.points[i]
    let len = distance(a, b)
    if used + len >= halfway {
      p = mix(a, b, (halfway - used) / len)
      break
    }
    used += len
  }
  let max_after = if now.is_empty() { 0.0 } else { run.length }
  {
    id,
    name,
    kind,
    ways,
    junction,
    width: pad * 2,
    before: sum(old),
    after: sum(now),
    longest: max_after,
    priority: max_after * pad * 2,
    point: p,
    oldRuns: old,
    runs: now,
  }
}

///|
fn html_esc(s : String) -> String {
  s
  .replace_all(old="&", new="&amp;")
  .replace_all(old="<", new="&lt;")
  .replace_all(old=">", new="&gt;")
  .replace_all(old="\"", new="&quot;")
}

///|
fn hundredths(v : Double) -> String {
  ((v * 100).round() / 100).to_string()
}

///|
fn town_water_board(
  net : Net,
  before : Net,
  state : Array[Int32],
  base : Array[Int32],
  dir : String,
) -> Unit raise {
  let records : Array[MarkedRoad] = []
  let moved_off_map : Array[Json] = []
  let old_issues : Array[Issue] = []
  let issues : Array[Issue] = []
  let old_links : Array[Link] = []
  let links : Array[Link] = []
  let old_score = evaluate(
    before,
    base,
    events=Some(old_issues),
    links_out=Some(old_links),
  )
  let score = evaluate(net, state, events=Some(issues), links_out=Some(links))
  for i, r in net.roads {
    if r.structure {
      continue
    }
    let old = wet_runs(net.points(i, base[i]), net.water, r.pad)
    let now = wet_runs(net.points(i, state[i]), net.water, r.pad)
    if !old.is_empty() && base[i] != state[i] {
      let off = lost_to_frame(
        net.points(i, base[i]),
        net.points(i, state[i]),
        net.water,
        r.pad,
      )
      if off > 0.00001 {
        moved_off_map.push({ "way": Json(r.id), "originalWetLength": Json(off) })
      }
    }
    if now.is_empty() && old.is_empty() {
      continue
    }
    records.push(
      summary_road(
        "w" + r.id.to_string(),
        if r.name == "" {
          "未命名道路"
        } else {
          r.name
        },
        r.highway,
        [r.id],
        None,
        r.pad,
        old,
        now,
      ),
    )
  }
  fn tie_runs(ls : Array[Link]) -> Map[Int32, Array[WetRun]] {
    let m : Map[Int32, Array[WetRun]] = Map([])
    for l in ls {
      let rs = wet_runs([l.a, l.b], net.water, l.pad)
      for r in rs {
        m.get_or_init(l.socket, () => []).push(r)
      }
    }
    m
  }
  let old_ties = tie_runs(old_links)
  let new_ties = tie_runs(links)
  for si, s in net.sockets {
    let old = old_ties.get(si).unwrap_or([])
    let now = new_ties.get(si).unwrap_or([])
    if old.is_empty() && now.is_empty() {
      continue
    }
    let owners = s.owners.map(i => net.roads[i].id)
    let names = s.owners.map(i => net.roads[i].name).filter(n => n != "")
    let name = if names.is_empty() {
      "路口接线"
    } else {
      names[0] + "接线"
    }
    let pad = (old_links + links)
      .filter(l => l.socket == si)
      .fold(init=0.0, (w, l) => w.max(l.pad))
    records.push(
      summary_road(
        "n" + s.node.to_string(),
        name,
        "junction",
        owners,
        Some(s.node),
        pad,
        old,
        now,
      ),
    )
  }
  records.sort_by((a, b) => {
    let x = b.priority.compare(a.priority)
    if x != 0 {
      x
    } else {
      a.id.compare(b.id)
    }
  })
  let sum = (next : Bool) => {
    records.fold(init=0.0, (w, r) => w + (if next { r.after } else { r.before }))
  }
  let road_sum = (next : Bool) => {
    records
    .filter(r => r.kind != "junction")
    .fold(init=0.0, (w, r) => w + (if next { r.after } else { r.before }))
  }
  let big = (next : Bool) => {
    records
    .filter(r => {
      r.kind != "junction" &&
      (if next {
        r.longest
      } else {
        r.oldRuns.fold(init=0.0, (v, run) => v.max(run.length))
      }) >=
      5
    })
    .length()
  }
  let long = (next : Bool) => {
    records.fold(init=0.0, (v, r) => {
      v.max(
        if next {
          r.longest
        } else {
          r.oldRuns.fold(init=0.0, (v, run) => v.max(run.length))
        },
      )
    })
  }
  let area = (m : Array[Int32], ls : Array[Link]) => {
    let mut total = 0.0
    for i, r in net.roads {
      if !r.structure {
        total += 2 * r.pad * net.wet(i, m[i])
      }
    }
    total +
    ls.fold(init=0.0, (w, l) => {
      w + 2 * l.pad * measure(l.a, l.b, net.water, l.pad)
    })
  }
  assert_true((sum(true) - road_sum(true) - score.tieWet).abs() < 0.000001)
  assert_true(
    (sum(false) - road_sum(false) - old_score.tieWet).abs() < 0.000001,
  )
  let delta = sum(false) - sum(true)
  assert_true(
    (delta -
    (
      old_score.waterChange +
      old_score.tieWet -
      score.waterChange -
      score.tieWet
    )).abs() <
    0.001,
  )
  let changes = records.filter(r => {
    r.before - r.after > 0.01 && r.kind != "junction"
  })
  changes.sort_by((a, b) => {
    (b.width * (b.before - b.after)).compare(a.width * (a.before - a.after))
  })
  let marks = issues.map(e => {
    Json::object({
      "key": Json(e.key),
      "missing": Json(e.lost),
      "point": Json(e.at),
      "ways": Json(e.roads.map(i => net.roads[i].id)),
    })
  })
  let witnesses : Map[String, Json] = Map([])
  for r in records {
    if r.kind == "junction" || r.longest < 5 {
      continue
    }
    let i = net.roads.search_by(w => w.id == r.ways[0]).unwrap()
    let ps = net.points(i, 0)
    let mut depth = 0.0
    let mut center = ps[0]
    for j in 1..<ps.length() {
      let l = distance(ps[j - 1], ps[j])
      let n = (l * 2).ceil().to_int().max(1)
      for k in 0..<=n {
        let p = mix(ps[j - 1], ps[j], k.to_double() / n.to_double())
        let dist = dry_distance(p, net.water)
        if dist > depth {
          depth = dist
          center = p
        }
      }
    }
    if depth > 5.0002 {
      witnesses[r.id] = {
        "point": Json(center),
        "distanceToDryCell": Json(depth),
        "maximumTrialDisplacement": 5,
      }
    }
  }
  assert_true(moved_off_map.is_empty())
  let stats : Json = {
    "sourceWays": Json(net.roads.length()),
    "ordinaryWays": Json(net.roads.filter(r => !r.structure).length()),
    "beforeLength": sum(false),
    "afterLength": sum(true),
    "beforeRoadLength": road_sum(false),
    "afterRoadLength": road_sum(true),
    "beforeTieLengthOnWater": old_score.tieWet,
    "afterTieLengthOnWater": score.tieWet,
    "beforeAreaIndex": area(base, old_links),
    "afterAreaIndex": area(state, links),
    "beforeWaysWithContinuous5": big(false),
    "afterWaysWithContinuous5": big(true),
    "beforeLongestRun": long(false),
    "afterLongestRun": long(true),
    "oldWetStationsMovedOutOfFrame": Json(moved_off_map),
    "beforeConflicts": old_score.added,
    "afterConflicts": score.added,
    "beforeMissing": old_score.lost,
    "afterMissing": score.lost,
  }
  let data : Json = {
    "schema": "moontown.wenyu-manual-shore-review.v1",
    "coordinateSystem": "256 x 144 design grid; x right, y down; lengths in grid cells; area index = affected length times rendered width, including ordinary ties",
    "summary": stats,
    "waterDepthWitnesses": Json(witnesses),
    "features": Json(records),
    "topology": Json(marks),
  }
  @fs.write_string_to_file(
    dir + "/manual-review.json",
    data.stringify(indent=2),
  )
  let defs = StringBuilder()
  defs.write_string(
    "<defs><g id='terrain'><rect width='256' height='144' fill='#eaece0'/>",
  )
  let labels : Labels = @json.from_json(
    @json.parse(
      @fs.read_file_to_string(
        "src/ui/assets/tilemap/wenyu_reference_labels.json",
      ),
    ),
  )
  for y in 0..<144 {
    let mut x = 0
    while x < 256 {
      let left = x
      let c = labels.rows[y][x]
      x += 1
      while x < 256 && labels.rows[y][x] == c {
        x += 1
      }
      let color = match c {
        'r' | 'l' => "#9cced1"
        'w' => "#cddece"
        'G' => "#d7e3cd"
        _ => ""
      }
      if color != "" {
        defs.write_string(
          "<rect x='\{left}' y='\{y}' width='\{x-left}' height='1' fill='\{color}'/>",
        )
      }
    }
  }
  defs.write_string("</g>")
  for k, m in [base, state] {
    defs.write_string(
      "<g id='map\{k}' fill='none' stroke-linecap='round' stroke-linejoin='round'><use href='#terrain'/>",
    )
    for i, r in net.roads {
      if !near(r.box.lo, r.box.hi, { x: 0, y: 0, }, { x: 256, y: 144, }, 5) {
        continue
      }
      let ps = net.points(i, m[i])
      defs.write_string(
        "<path d='\{path(ps)}' stroke='\{if r.structure{"#756989"}else if r.highway=="construction"{"#ad986c"}else if r.pad<0.1{"#bac2b7"}else{"#87968c"}}' stroke-width='\{r.pad*1.8}'/>",
      )
    }
    for l in (if k == 0 { old_links } else { links }) {
      defs.write_string(
        "<path d='\{path([l.a,l.b])}' stroke='#87968c' stroke-width='\{l.pad*1.8}'/>",
      )
    }
    for r in records {
      if k == 1 && r.kind != "junction" && r.before - r.after > 0.4 {
        let i = net.roads.search_by(w => w.id == r.ways[0]).unwrap()
        defs.write_string(
          "<path d='\{path(net.points(i,m[i]))}' stroke='#288371' opacity='.86' stroke-width='\{r.width.max(0.25)*1.35}'/>",
        )
      }
      for run in (if k == 0 { r.oldRuns } else { r.runs }) {
        defs.write_string(
          "<path d='\{path(run.points)}' stroke='#c94c29' stroke-width='\{r.width.max(0.22)*1.65}'/>",
        )
      }
    }
    defs.write_string("</g>")
  }
  defs.write_string("</defs>")
  let shapes = defs.to_string()
  let number = (n : Int32) => {
    if n < 9 {
      "0" + (n + 1).to_string()
    } else {
      (n + 1).to_string()
    }
  }
  let thumb = StringBuilder()
  thumb.write_string(
    "<svg xmlns='http://www.w3.org/2000/svg' width='1080' height='850' viewBox='0 0 1080 850'><title>温榆河 · 全镇道路压水对比</title>\{shapes}<rect width='1080' height='850' fill='#faf8f0'/><g font-family='system-ui,sans-serif' fill='#244239'><text x='24' y='38' font-size='25' font-weight='650'>温榆河 · 大面积压水路段</text><text x='1056' y='36' text-anchor='end' font-size='14'>橙红　压水路面　　 绿　已改善道路</text>",
  )
  let zoom = if changes.is_empty() { records[0] } else { changes[0] }
  let selected = net.roads[net.roads
    .search_by(r => r.id == zoom.ways[0])
    .unwrap()]
  let center = mix(selected.box.lo, selected.box.hi, 0.5)
  let zoom_w = (selected.box.hi.x - selected.box.lo.x + 8)
    .max((selected.box.hi.y - selected.box.lo.y + 8) * 2.1)
    .clamp(min=18, max=160)
  for k in 0..<2 {
    let left = 24 + k * 522
    thumb.write_string(
      "<text x='\{left}' y='80' font-size='18'>\{if k==0{"调整前"}else{"调整后"}}　\{hundredths(sum(k==1))} 格</text><svg x='\{left}' y='89' width='510' height='287' viewBox='0 0 256 144'><use href='#map\{k}'/></svg><text x='\{left}' y='421' font-size='16'>\{html_esc(zoom.name)}　\{hundredths(if k==0{zoom.before}else{zoom.after})} 格</text><svg x='\{left}' y='438' width='510' height='247' viewBox='\{center.x-zoom_w/2} \{center.y-zoom_w/4.2} \{zoom_w} \{zoom_w/2.1}'><use href='#map\{k}'/></svg>",
    )
  }
  thumb.write_string(
    "<text x='24' y='726' font-size='16'>待复核 · 按最长连续压水段及路宽排列</text>",
  )
  for i, r in records[:records.length().min(4)] {
    let line = 753 + 23 * i
    thumb.write_string(
      "<text x='24' y='\{line}' font-size='14'>\{number(i)}　\{html_esc(r.name)}　·　\{r.id}　　最长连续 \{hundredths(r.longest)} 格</text>",
    )
  }
  thumb.write_string("</g></svg>")
  @fs.write_string_to_file(dir + "/coverage.svg", thumb.to_string())
  let html = StringBuilder()
  html.write_string(
    "<!doctype html><html lang='zh-CN'><meta charset='utf-8'><meta name='viewport' content='width=device-width,initial-scale=1'><title>温榆河 · 道路复核</title><style>*{box-sizing:border-box}body{margin:0;background:#f6f5ed;color:#193e33;font:15px system-ui,sans-serif}header,main{max-width:1280px;margin:auto;padding:18px 24px}header{display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid #d1d8cd}h1{font-size:22px;margin:0}h2{font-size:19px;margin:0 0 12px}a{color:#146451}main{display:grid;grid-template-columns:minmax(0,2.4fr) minmax(260px,1fr);gap:20px}aside{max-height:79vh;overflow:auto}nav a{padding:8px 5px;display:flex;justify-content:space-between;gap:10px;border-bottom:1px solid #dae1d6;text-decoration:none}nav a:hover,nav a:focus{background:#dceadc}small{color:#546958;font-size:13px}svg{width:100%;height:auto;background:#eceee4}.panel{display:none}.panel:target{display:block}main:not(:has(.panel:target)) #town-summary{display:block}.maps{display:grid;grid-template-columns:1fr 1fr;gap:8px}figure{margin:5px 0}figcaption{margin:5px 0;color:#516957}.remarks{margin:12px 0}details{margin:18px 0}summary{cursor:pointer;font-weight:600}.legend{color:#a23d22}a:focus-visible,summary:focus-visible{outline:2px solid #287865}@media(max-width:780px){main{grid-template-columns:1fr}aside{max-height:52vh}.maps{gap:5px}header,main{padding:12px}h1{font-size:19px}}</style><header><h1>温榆河 · 道路复核</h1><a href='manual-review.json' download>下载标记</a></header><svg aria-hidden='true' style='position:absolute;width:0;height:0'>\{shapes}</svg><main><article><section class='panel' id='town-summary'><h2>全镇　\{hundredths(sum(false))} → \{hundredths(sum(true))} 格</h2><svg viewBox='0 0 256 144' aria-label='全镇调整后道路'><use href='#map1'/>",
  )
  for i, r in records {
    if r.kind == "junction" || r.longest < 5 {
      continue
    }
    let p = r.point
    html.write_string(
      "<a href='#\{r.id}' aria-label='\{html_esc(r.name)} \{number(i)}'><circle cx='\{p.x}' cy='\{p.y}' r='1.65' fill='#fff9ea' stroke='#993e27' stroke-width='.2'/><text x='\{p.x}' y='\{p.y+0.5}' text-anchor='middle' font-size='1.55' fill='#84321d'>\{number(i)}</text></a>",
    )
  }
  html.write_string(
    "</svg><p class='remarks'><span class='legend'>橙红　压水</span>　　 绿　已改善　　 紫　桥涵　　 赭　OSM 施工道路</p><a href='coverage.svg'>前后对比图 ↗</a></section>",
  )
  fn detail(
    id : String,
    title : String,
    info : String,
    p : P,
    extent : Double,
    guide0 : String,
    guide1 : String,
  ) -> Unit {
    html.write_string(
      "<section class='panel' id='\{id}'><h2>\{html_esc(title)}</h2><p>\{html_esc(info)}</p><div class='maps'>",
    )
    for k in 0..<2 {
      html.write_string(
        "<figure><figcaption>\{if k==0{"调整前"}else{"调整后"}}</figcaption><svg aria-label='\{html_esc(title)}' viewBox='\{p.x-extent/2} \{p.y-extent*0.39} \{extent} \{extent*0.78}'><use href='#map\{k}'/>\{if k==0{guide0}else{guide1}}</svg></figure>",
      )
    }
    html.write_string(
      "</div><a href='#town-summary'>全镇总览</a></section>",
    )
  }
  for r in records {
    let w = (r.longest * 1.65 + 6).clamp(min=12, max=45)
    let guide = (rs : Array[WetRun]) => {
      rs
      .map(t => {
        "<path fill='none' stroke='#b13220' stroke-linecap='round' stroke-width='.6' d='" +
        path(t.points) +
        "'/>"
      })
      .join("")
    }
    detail(
      r.id,
      r.name + " · " + r.id,
      (if r.kind == "construction" { "OSM 标注施工　｜　" } else { "" }) +
      "路面压水 " +
      hundredths(r.before) +
      " → " +
      hundredths(r.after) +
      " 格　｜　最长连续 " +
      hundredths(r.longest) +
      " 格　｜　网格 (" +
      hundredths(r.point.x) +
      ", " +
      hundredths(r.point.y) +
      ")" +
      (if witnesses.contains(r.id) {
        "　｜　存在距岸超过 5 格的位置"
      } else {
        ""
      }),
      r.point,
      w,
      guide(r.oldRuns),
      guide(r.runs),
    )
  }
  for i, e in issues {
    let id = "t" + i.to_string()
    let p = e.at
    let names = e.roads.map(i => net.roads[i].id.to_string()).join(" / ")
    let guide = "<circle cx='\{p.x}' cy='\{p.y}' r='.34' fill='none' stroke='#773e85' stroke-width='.12'/>"
    let near_old = old_issues.filter(v => v.key == e.key)
    let prior = if near_old.is_empty() {
      ""
    } else {
      "<circle cx='\{near_old[0].at.x}' cy='\{near_old[0].at.y}' r='.34' fill='none' stroke='#773e85' stroke-width='.12'/>"
    }
    detail(
      id,
      if e.lost {
        "缺失原交叉"
      } else {
        "交叉或接触"
      },
      names +
      "　｜　网格 (" +
      hundredths(p.x) +
      ", " +
      hundredths(p.y) +
      ")",
      p,
      9.0,
      prior,
      guide,
    )
  }
  let short_count = records
    .filter(r => r.after > 0 && (r.kind == "junction" || r.longest < 5))
    .length()
  html.write_string(
    "</article><aside><h2>连续压水 ≥ 5 格 · \{big(true)}</h2><nav>",
  )
  for short in [false, true] {
    if short {
      html.write_string(
        "</nav><details><summary>短段与接线 · \{short_count}</summary><nav>",
      )
    }
    for i, r in records {
      if r.after > 0 && (r.kind == "junction" || r.longest < 5) == short {
        html.write_string(
          "<a href='#\{r.id}'><span>\{number(i)}　\{html_esc(r.name)}</span><small>\{hundredths(r.longest)} 格</small></a>",
        )
      }
    }
  }
  html.write_string(
    "</nav></details><details><summary>交叉与接触 · \{issues.length()}</summary><nav>",
  )
  for i, e in issues {
    html.write_string(
      "<a href='#t\{i}'><span>\{if e.lost{"缺失原交叉"}else{"交叉或接触"}}　\{i+1}</span><small>\{net.roads[e.roads[0]].id}</small></a>",
    )
  }
  html.write_string(
    "</nav></details><details><summary>已清除压水</summary><nav>",
  )
  for r in records {
    if r.after == 0 {
      html.write_string(
        "<a href='#\{r.id}'><span>\{html_esc(r.name)}</span><small>\{r.id}</small></a>",
      )
    }
  }
  html.write_string("</nav></details></aside></main></html>")
  @fs.write_string_to_file(dir + "/index.html", html.to_string())
  println("Town pavement " + stats.stringify())
}

///|
fn fit_two_heads(a : P, b : P, ta : P, tb : P, extra : Double) -> Fit? {
  let len = distance(a, b)
  if len < 0.02 {
    return None
  }
  let u = unit(minus(b, a))
  let v = P::{ x: -u.y, y: u.x, }
  let da = minus(ta, a)
  let db = minus(tb, b)
  let dif = minus(da, db)
  let xx = dot(dif, u) / len
  let xy = dot(dif, v) / len
  if xx < -0.00000001 || (xx < 1.0e-9 && xy.abs() > 1.0e-9) {
    return None
  }
  let yy = (if xx > 1.0e-9 { xy * xy / xx } else { 0.0 }) + extra
  let diff = ((xx - yy) * (xx - yy) + 4 * xy * xy).sqrt()
  let iso = ((xx + yy - diff) / 2).max(0)
  if iso + diff > 0.45 {
    return None
  }
  let angle = 0.5 * @math.atan2(2 * xy, xx - yy)
  Some({
    mode: "two-head-compression",
    origin: a,
    shift: da,
    axis: {
      x: u.x * @math.cos(angle) + v.x * @math.sin(angle),
      y: u.y * @math.cos(angle) + v.y * @math.sin(angle),
    },
    drop: diff,
    isotropic: iso,
    uniform: false,
  })
}

///|
fn adopt_corridor(
  net : Net,
  ids : Array[Int32],
  label : Int32,
  snapshot : Array[Int32],
) -> (Array[Int32], Double)? {
  let pool = Set(ids)
  let stations : Map[Int32, P] = Map([])
  let first_ring : Set[Int32] = Set([])
  for s in net.sockets {
    if s.owners.any(i => pool.contains(i)) {
      for i in s.owners {
        if net.roads[i].eligible && !ids.contains(i) {
          first_ring.add(i)
          stations[i] = s.p
        }
      }
    }
  }
  let extra = Set(first_ring.to_array())
  for s in net.sockets {
    if s.owners.any(i => first_ring.contains(i)) {
      for i in s.owners {
        if net.roads[i].eligible && !ids.contains(i) && !extra.contains(i) {
          extra.add(i)
          stations[i] = s.p
        }
      }
    }
  }
  for i in extra {
    pool.add(i)
  }
  let panel = pocket(net, snapshot, pool)
  let original : Array[Issue] = []
  let before = evaluate(panel, snapshot, events=Some(original))
  let orig_keys = Set(original.map(e => e.key))
  let before_ties : Array[Link] = []
  ignore(evaluate(panel, snapshot, links_out=Some(before_ties)))
  let size = net.roads.length()
  let assignment = Array::make(size, 0)
  let vars = Array::make(size, false)
  for i in extra {
    let r = net.roads[i]
    let f = net.fits[label]
    let old = net.fits[snapshot[i]]
    let p = stations[i]
    let v = minus(f.at(p), p)
    let branch_fit = if legal_choice(net, i, label) {
      label
    } else {
      add_fit(net, { ..old, mode: "branch-translation", origin: p, shift: v, })
    }
    if branch_fit != snapshot[i] &&
      legal_choice(net, i, branch_fit) &&
      net.wet(i, branch_fit) <= net.wet(i, snapshot[i]) + 0.000001 &&
      r.ps.all(p => distance(net.fits[branch_fit].at(p), p) <= 5) {
      assignment[i] = branch_fit
      vars[i] = true
    }
  }
  let clauses : Array[Array[Int32]] = []
  let visited : Set[String] = Set([])
  let mut result : (Array[Int32], Double)? = None
  for variant in 0..<26 {
    let bits = if variant == 0 {
      Array::make(size, 0)
    } else if variant == 1 {
      Array::makei(size, i => if first_ring.contains(i) { 1 } else { 0 })
    } else if variant == 2 {
      Array::make(size, 1)
    } else {
      guard binary_assignment(clauses, size) is Some(b) else { break }
      b
    }
    let m = snapshot.copy()
    for i in ids {
      m[i] = label
    }
    for i in extra {
      if vars[i] && bits[i] == 1 {
        m[i] = assignment[i]
      }
    }
    let events : Array[Issue] = []
    let links : Array[Link] = []
    let score = evaluate(panel, m, events=Some(events), links_out=Some(links))
    let delta = before.waterChange +
      before.tieWet -
      score.waterChange -
      score.tieWet
    if score.bridges_ok &&
      score.added <= before.added &&
      score.lost <= before.lost &&
      events.all(e => orig_keys.contains(e.key)) &&
      delta > 0.15 {
      let extra_length = links.fold(init=0.0, (w, l) => w + distance(l.a, l.b)) -
        before_ties.fold(init=0.0, (w, l) => w + distance(l.a, l.b))
      let road_gain = pool
        .to_array()
        .fold(init=0.0, (w, i) => {
          w +
          net.roads[i].pad * 2 * (net.wet(i, snapshot[i]) - net.wet(i, m[i]))
        })
      let link_area = (ls : Array[Link]) => {
        ls.fold(init=0.0, (w, l) => {
          w + 2 * l.pad * measure(l.a, l.b, net.water, l.pad)
        })
      }
      let area = road_gain + link_area(before_ties) - link_area(links)
      let value = area - extra_length.max(0) * 0.006
      if area > 0.015 &&
        value > 0 &&
        (result is None || result.unwrap().1 < value) {
        result = Some((m, value))
      }
    }
    fn reject(rs : Array[Int32]) -> Unit {
      let vs = Set(rs.filter(i => vars[i])).to_array()
      vs.sort()
      let c = vs.map(i => if bits[i] == 1 { -(i + 1) } else { i + 1 })
      let key = Json(c).stringify()
      if !visited.contains(key) {
        visited.add(key)
        clauses.push(c)
      }
    }
    let count = clauses.length()
    for e in events {
      if !orig_keys.contains(e.key) {
        reject(e.roads)
      }
    }
    if !score.bridges_ok {
      for l in links {
        let s = panel.sockets[l.socket]
        if s.deck.any(v => {
            dot(minus(l.b, l.a), v) < distance(l.a, l.b) * 0.965925826 - 0.00011
          }) {
          reject(s.owners)
        }
      }
    }
    if variant >= 3 &&
      (count == clauses.length() || clauses.any(c => c.is_empty())) {
      break
    }
  }
  result
}

///|
fn lost_to_frame(
  before : Array[P],
  after : Array[P],
  water : Array[Bool],
  pad : Double,
) -> Double {
  let mut sum = 0.0
  for i in 1..<before.length() {
    let a = after[i - 1]
    let b = after[i]
    if a.x >= 0 &&
      a.x < 256 &&
      a.y >= 0 &&
      a.y < 144 &&
      b.x >= 0 &&
      b.x < 256 &&
      b.y >= 0 &&
      b.y < 144 {
      continue
    }
    let x = slab(a.x, b.x - a.x, 0, 256)
    let y = slab(a.y, b.y - a.y, 0, 144)
    let x0 = slab(before[i - 1].x, before[i].x - before[i - 1].x, 0, 256)
    let y0 = slab(before[i - 1].y, before[i].y - before[i - 1].y, 0, 144)
    for (u, v) in intervals(before[i - 1], before[i], water, pad) {
      let l = u.max(x0.0).max(y0.0)
      let h = v.min(x0.1).min(y0.1)
      if h <= l {
        continue
      }
      let retained = (h.min(x.1).min(y.1) - l.max(x.0).max(y.0)).max(0.0)
      sum += (h - l - retained) * distance(before[i - 1], before[i])
    }
  }
  sum
}

///|
// Additional symmetric contraction around the line through two surveyed
// junctions. Both keep their current fitted positions and the whole way
// retains a single affine transform.
fn squeeze_between(f : Fit, a : P, b : P, k : Double) -> Fit {
  let u = unit(minus(b, a))
  let ox = f.axis
  let n = P::{ x: -u.y, y: u.x, }
  let xx = f.isotropic +
    f.drop * (if f.uniform { 1.0 } else { ox.x * ox.x }) +
    k * n.x * n.x
  let yy = f.isotropic +
    f.drop * (if f.uniform { 1.0 } else { ox.y * ox.y }) +
    k * n.y * n.y
  let xy = (if f.uniform { 0.0 } else { f.drop * ox.x * ox.y }) + k * n.x * n.y
  let rad = ((xx - yy) * (xx - yy) + 4 * xy * xy).sqrt()
  let angle = 0.5 * @math.atan2(2 * xy, xx - yy)
  {
    origin: a,
    shift: minus(f.at(a), a),
    mode: "frontage-junctions",
    uniform: false,
    axis: { x: @math.cos(angle), y: @math.sin(angle), },
    drop: rad,
    isotropic: ((xx + yy - rad) / 2).max(0),
  }
}

///|
fn pin_streets(net : Net, state : Array[Int32]) -> Int32 {
  let mut trials = 0
  for _ in 0..<2 {
    let roads = net.roads
      .mapi((i, r) => {
        if r.eligible && net.wet(i, state[i]) > 1.8 {
          i
        } else {
          -1
        }
      })
      .filter(i => i >= 0)
    roads.sort_by((i, j) => {
      (net.wet(j, state[j]) * net.roads[j].pad).compare(
        net.wet(i, state[i]) * net.roads[i].pad,
      )
    })
    for i in roads {
      let before = state[i]
      let r = net.roads[i]
      let f = net.fits[before]
      let view = pocket(net, state, Set([i]))
      let old = evaluate(view, state)
      let old_wet = net.wet(i, before)
      let shared = net.sockets.filter(s => s.owners.contains(i))
      let ps = shared.map(s => s.p)
      if !ps.contains(r.ps[0]) {
        ps.push(r.ps[0])
      }
      if !ps.contains(r.ps.last().unwrap()) {
        ps.push(r.ps.last().unwrap())
      }
      if ps.length() == 1 {
        continue
      }
      let mut winner = before
      let mut best = 0.05
      for j in 1..<ps.length() {
        for a in ps[:j] {
          let b = ps[j]
          if distance(a, b) < 0.06 {
            continue
          }
          let max_move = r.ps.fold(init=0.001, (w, p) => {
            w.max(det(unit(minus(b, a)), minus(p, a)).abs())
          })
          let max_scale = (4.9 / max_move).min(0.30)
          for
            k in [0.009, 0.023, 0.055, 0.104, 0.19, 0.32, 0.5, 0.71, 0.89, 1.0] {
            let cand = squeeze_between(f, a, b, k * max_scale)
            if cand.isotropic + cand.drop >= 0.5 ||
              r.ps.any(p => distance(p, cand.at(p)) > 5) {
              continue
            }
            let key = add_fit(net, cand)
            state[i] = key
            if net.wet(i, key) > old_wet - 0.05 ||
              lost_to_frame(
                net.points(i, 0),
                net.points(i, key),
                net.water,
                r.pad,
              ) >
              0.000001 ||
              lost_to_frame(
                net.points(i, before),
                net.points(i, key),
                net.water,
                r.pad,
              ) >
              0.000001 {
              continue
            }
            let s = evaluate(view, state)
            trials += 1
            let gain = (old_wet - net.wet(i, key)) * 2 * r.pad -
              (s.tieWet - old.tieWet).max(0) * 0.24
            if s.bridges_ok &&
              s.lost <= old.lost &&
              s.added <= old.added &&
              gain > best &&
              s.waterChange + s.tieWet < old.waterChange + old.tieWet - 0.05 {
              best = gain
              winner = key
            }
          }
        }
      }
      state[i] = winner
      if net.polylines.length() > 25000 {
        net.polylines.clear()
      }
      if net.wet_cache.length() > 300000 {
        net.wet_cache.clear()
      }
      if winner != before {
        println(
          "Real junction line " +
          r.id.to_string() +
          " " +
          old_wet.to_string() +
          " -> " +
          net.wet(i, winner).to_string(),
        )
      }
    }
  }
  trials
}

///|
fn check_shore_intervals() -> Unit raise {
  let water = Array::make(256 * 144, false)
  water[0] = true
  water[1] = true
  let source = [
    P::{ x: 0.25, y: 0.5, },
    { x: 1.0, y: 0.5, },
    { x: 2.25, y: 0.5, },
  ]
  let runs = wet_runs(source, water, 0)
  assert_eq(runs.length(), 1)
  assert_true((runs[0].length - 1.75).abs() < 1.0e-8)
  let escape = source.map(p => P::{ x: p.x, y: -0.25, })
  assert_true((lost_to_frame(source, escape, water, 0) - 1.75).abs() < 1.0e-8)
  assert_eq(
    lost_to_frame(source, source.map(p => P::{ x: p.x, y: 2, }), water, 0),
    0,
  )
  let a = P::{ x: 5, y: 3, }
  let b = P::{ x: 7, y: 8, }
  let f = fit_two_heads(a, b, a, b, 0.12).unwrap()
  assert_true(distance(f.at(a), a) < 1.0e-8 && distance(f.at(b), b) < 1.0e-8)
}

///|
// Distance from a sampled original station to the nearest dry-cell rectangle
// or edge of the finite plan. Hence this is a conservative lower bound on
// how far that specific station must travel before its pavement can be dry.
fn dry_distance(p : P, water : Array[Bool]) -> Double {
  let x = p.x.floor().to_int()
  let y = p.y.floor().to_int()
  if x < 0 || x >= 256 || y < 0 || y >= 144 || !water[y * 256 + x] {
    return 0
  }
  let mut best = p.x.min(256 - p.x).min(p.y).min(144 - p.y)
  for step in 1..<257 {
    if (step - 1).to_double() > best {
      break
    }
    for yy in (y - step).max(0)..<=(y + step).min(143) {
      for xx in (x - step).max(0)..<=(x + step).min(255) {
        if (xx - x).abs().max((yy - y).abs()) != step || water[yy * 256 + xx] {
          continue
        }
        let dx = (xx.to_double() - p.x).max(p.x - xx.to_double() - 1).max(0)
        let dy = (yy.to_double() - p.y).max(p.y - yy.to_double() - 1).max(0)
        best = best.min((dx * dx + dy * dy).sqrt())
      }
    }
  }
  best
}

///|
// Keep the original identity on the stationary approach (or deck). Separate
// positions of one OSM junction receive distinct graph nodes. Only the saved
// junction-tree edges join them; coincident crossings never invent a turn.
fn export_town_roads(net : Net, state : Array[Int], links : Array[Link], graph : Json) -> Unit raise {
  let raw : Source = @json.from_json(@json.parse(@fs.read_file_to_string("docs/project/wenyu-lower-perspective.json")))
  assert_eq(raw.ways.length(),net.roads.length())
  let junctions : Map[Double,Array[P]] = Map([])
  let serial : Map[Double,Int] = Map([])
  for socket in net.sockets {
    let ps : Array[P] = []
    for i in socket.owners {
      let p = snap(net.fits[state[i]].at(socket.p))
      if !ps.contains(p) { ps.push(p) }
    }
    if ps.length()>1 {
      let fixed = snap(socket.p)
      if ps.search_by(p=>p==fixed) is Some(k) { let tmp=ps[0];ps[0]=fixed;ps[k]=tmp }
      assert_true(ps.length()<100)
      serial[socket.node]=junctions.length()+1
      junctions[socket.node]=ps
    }
  }
  let node_id = (osm : Double, pt : P) => {
    match junctions.get(osm) {
      None => osm
      Some(ps) => { let slot=ps.search_by(p=>p==snap(pt)).unwrap()
        if slot==0 { osm } else { -(serial[osm]*100+slot).to_double() }
      }
    }
  }
  let ways : Array[Json] = []
  let positions : Map[Double,P] = Map([])
  for i,r in net.roads {
    let w=raw.ways[i]
    assert_eq(w.osmWayId,r.id)
    let line=if state[i]==0 { r.ps } else { net.points(i,state[i]) }
    let ids=r.nodes.mapi((k,n)=>node_id(n,line[k]))
    let ground=line.mapi((k,p)=>positions.get_or_init(ids[k],()=>p))
    ways.push({"osmWayId":r.id,"nodes":Json(ids),"sourceNodes":Json(w.nodes),"geometryWgs84":Json(w.geometryWgs84),"ground":Json(ground),"tags":Json(w.tags)})
  }
  let walkable=(w : SourceWay)=> {
    ["secondary","tertiary","residential","unclassified","service","footway","path","pedestrian","steps","cycleway"].contains(w.tags.get("highway").unwrap_or("")) &&
    !(w.tags.get("access") is Some("no"|"private")) && w.tags.get("foot")!=Some("no") && !grade(w,"tunnel")
  }
  for i,l in links {
    let s=net.sockets[l.socket]
    let from=node_id(s.node,l.a)
    let to=node_id(s.node,l.b)
    guard from!=to else { fail("Collapsed junction connection") }
    let w=raw.ways[s.owners[0]]
    let g=w.geometryWgs84[w.nodes.search_by(n=>n==s.node).unwrap()]
    let foot=[l.from_fit,l.to_fit].all(k=>s.owners.any(j=>state[j]==k && walkable(raw.ways[j])))
    let tags : Map[String,String]={"highway":if l.pad<0.1 {"footway"}else{"unclassified"},"moontown:link":"yes"}
    if !foot {tags["foot"]="no"}
    assert_eq(snap(positions[from]),l.a)
    assert_eq(snap(positions[to]),l.b)
    ways.push({"osmWayId":-(i+1),"nodes":[from,to],"geometryWgs84":Json([g,g]),"ground":Json([positions[from],positions[to]]),"tags":Json(tags)})
  }
  if !@fs.path_exists("output/wenyu-road-town") { @fs.create_dir("output/wenyu-road-town") }
  let doc : Json = {"layout":"major-road-fit","ways":Json(ways),"graph":graph}
  @fs.write_string_to_file("output/wenyu-road-town/roads.json",doc.stringify())
  println("Registered town source: \{raw.ways.length()} OSM ways and \{links.length()} junction links.")
}
