///|
import {
  "moonbitlang/x@0.5.5/fs",
  "moonbitlang/core/json",
}

///|
fn field(j : Json, k : String) -> Json {
  match j {
    Object(m) => m.get(k).unwrap_or(Json::null())
    _ => Json::null()
  }
}

///|
fn num(j : Json) -> Double {
  match j {
    Number(n, ..) => n
    _ => abort("number required")
  }
}

///|
fn str(j : Json) -> String {
  match j {
    String(s) => s
    _ => ""
  }
}

///|
fn arr(j : Json) -> Array[Json] {
  match j {
    Array(a) => a
    _ => abort("array required")
  }
}

///|
fn copy_tree(source : String, target : String) -> Unit raise {
  if !@fs.path_exists(target) {
    @fs.create_dir(target)
  }
  for name in @fs.read_dir(source) {
    // The original floor-plan photograph is private review material. Never
    // publish it through the town's static asset tree.
    if name == "interior-reference.jpg" {
      continue
    }
    let from = source + "/" + name
    let to = target + "/" + name
    if @fs.is_dir(from) {
      copy_tree(from, to)
    } else {
      @fs.write_bytes_to_file(to, @fs.read_file_to_bytes(from))
    }
  }
}

///|
fn main raise {
  // Original studies remain untouched. Product copies are generated inputs to
  // the existing hashed/verified static asset assembly, not new source models.
  let target = "src/ui/assets/landmark-studio"
  let stale_private_reference = target + "/interior-reference.jpg"
  if @fs.path_exists(stale_private_reference) {
    @fs.remove_file(stale_private_reference)
  }
  let old_campus_tile = target + "/town-projections/center.png"
  if @fs.path_exists(old_campus_tile) {
    @fs.remove_file(old_campus_tile)
  }
  copy_tree("src/ui/landmark-studio/web", target)
  let source = @json.parse(
    @fs.read_file_to_string("output/wenyu-road-town/roads.json"),
  )
  let nodes : Map[String, Json] = Map([])
  let edges : Array[Json] = []
  for way in arr(field(source, "ways")) {
    let tags = field(way, "tags")
    let kind = str(field(tags, "highway"))
    if ![
        "secondary", "tertiary", "residential", "unclassified", "service", "footway",
        "path", "pedestrian", "steps", "cycleway",
      ].contains(kind) ||
      ["no", "private"].contains(str(field(tags, "access"))) ||
      str(field(tags, "foot")) == "no" ||
      str(field(tags, "tunnel")) == "yes" {
      continue
    }
    let geo = arr(field(way, "geometryWgs84"))
    if !geo.all(p => {
        num(field(p, "lon")) > 116.457 &&
        num(field(p, "lon")) < 116.483 &&
        num(field(p, "lat")) > 40.108 &&
        num(field(p, "lat")) < 40.135
      }) {
      continue
    }
    let path = arr(field(way, "ground"))
    let ids = arr(field(way, "nodes"))
    assert_eq(path.length(), ids.length())
    for i, p in path {
      let id = ids[i].stringify()
      nodes[id] = if num(ids[i]) <= -5000000000.0 {
        {"id":id,"x":(num(field(p,"x"))*10000).round()/10000,"y":(num(field(p,"y"))*10000).round()/10000}
      } else { { "id": id, "x": field(p,"x"), "y": field(p,"y") } }
      if i > 0 {
        edges.push({
          "a": ids[i - 1].stringify(),
          "b": id,
          "way": field(way, "osmWayId"),
          "bridge": str(field(tags, "bridge")) == "yes",
        })
      }
    }
  }
  // Validate the site against the graph we actually ship, after walk-access
  // and geographic filters. A street boundary can contain excluded nodes.
  let site = @json.parse(@fs.read_file_to_string("docs/project/wenyu-future-center-site.json"))
  let arrivals = [field(field(site,"forecourt"),"arrival").stringify()]
  for block in arr(field(site,"blocks")) {
    for building in arr(field(block,"buildings")) {
      arrivals.push(field(building,"arrival").stringify())
    }
  }
  let neighbors : Map[String,Array[String]] = Map([])
  for edge in edges {
    let a=str(field(edge,"a"))
    let b=str(field(edge,"b"))
    neighbors.get_or_init(a,()=>[]).push(b)
    neighbors.get_or_init(b,()=>[]).push(a)
  }
  let reached : Map[String,Bool] = Map([])
  let queue = [arrivals[0]]
  reached[arrivals[0]]=true
  for i=0; i<queue.length(); i=i+1 {
    for next in neighbors.get(queue[i]).unwrap_or([]) {
      if !reached.contains(next) { reached[next]=true; queue.push(next) }
    }
  }
  let district_audit = @json.parse(@fs.read_file_to_string("docs/project/science-city-placement-audit.json"))
  // The nearest geometric endpoint may be in a disconnected service-road component.
  let candidates : Map[String,Map[String,Double]] = @json.from_json(field(district_audit,"streetCandidates"))
  let stops : Map[String,String]=Map([])
  for project, choices in candidates {
    let mut best=1.0
    for node, distance in choices {
      if reached.contains(node) && nodes.contains(node) && (distance<best || (distance==best && node<stops.get(project).unwrap_or("~"))) {
        best=distance;stops[project]=node
      }
    }
  }
  let keys=stops.keys().collect()
  keys.sort()
  @fs.write_string_to_file("src/ui/rabbita-town/main/science_city_arrivals.mbt","///|\n// Generated from reachable public street nodes at reviewed site boundaries.\nlet town_district_arrivals : Map[String, String] = {\n"+keys.map(k=>"  \"district:"+k+"\": \""+stops[k]+"\",\n").join("")+"}\n")
  for id in arrivals {
    guard nodes.contains(id) && reached.contains(id) else { fail("Unreachable Future Center street arrival " + id) }
  }
  let ns : Array[Json] = []
  for _, n in nodes {
    ns.push(n)
  }
  ns.sort_by((a, b) => str(field(a, "id")).compare(str(field(b, "id"))))
  let graph : Json = {
    "schema": "moontown.landmark-navigation.v1",
    "authority": "local navigation simulation; not live runtime assignment",
    "attribution": "© OpenStreetMap contributors, ODbL",
    "source": "Wenyu reviewed major-road fit and junction links",
    "nodes": ns,
    "edges": edges,
  }
  @fs.write_string_to_file(target + "/navigation.json", graph.stringify())
  println(
    "Preserved studio copied; \{ns.length()} shared-node route vertices, \{edges.length()} edges",
  )
}
