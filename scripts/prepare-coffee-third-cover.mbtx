}

///|
let base = "src/ui/coffee-display"

///|
let assets = "src/ui/coffee-display/assets"

///|
let generated = "/Users/kq/.codex/generated_images/01a10af2-c8fb-7663-b4df-2fd1b2c9d71c/"

///|
let media : ReadOnlyArray[String] = [
  "siamese-cover.webp", "siamese-cover-mobile.webp", "banxing-logo-20261112.png",
  "company-wordmark.png", "group-mark-raster-v5.png", "vector-sticker-wordmark.svg",
  "participate-week03.svg", "community-qr.png", "prizes-v1.webp", "prize-figure-real.png",
  "prize-figure-real.webp", "prize-tote-real.png", "prize-tote-real.webp", "work-autumn.png",
  "work-autumn-thumb.webp", "work-spoon.png", "work-spoon-thumb.webp", "work-forest.png",
  "work-forest-thumb.webp", "award-second-ink.png", "award-second-ink-thumb.webp",
  "award-second-op.png", "award-second-op-thumb.webp", "award-third-line.png", "award-third-line-thumb.webp",
  "week02-winner.png", "week02-winner-thumb.webp", "week02-refraction.png", "week02-refraction-thumb.webp",
  "week02-butterfly.png", "week02-butterfly-thumb.webp", "week02-storm.png", "week02-storm-thumb.webp",
  "week02-cyanotype.png", "week02-cyanotype-thumb.webp", "week02-origami.png", "week02-origami-thumb.webp",
