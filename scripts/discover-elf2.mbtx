----
import {
  "moonbitlang/async@0.22.4",
  "moonbitlang/async@0.22.4/shell",
  "moonbitlang/core/env",
}
----

///|
async fn main {
  // User-authorized discovery: only SSH port on the cluster's local /24.
  let tasks : Array[async () -> Unit] = []
  for number in 2..<255 {
    let ip = "192.168.2.\{number}"
    for
      port in (if @env.args().length() > 1 {
        [80, 2222, 3389, 5900]
      } else {
        [22]
      }) {
      tasks.push(async fn() {
        try {
          @shell.Cmd("nc", ["-z", "-w", "1", ip, port.to_string()])
          .output()
          .check()
          println(ip + ":" + port.to_string())
        } catch {
          _ => ()
        }
      })
    }
  }
  ignore(@async.all(tasks[:], max_concurrent=24))
}
