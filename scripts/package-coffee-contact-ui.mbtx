///|
import {
  "moonbitlang/async@0.22.4",
  "moonbitlang/async@0.22.4/fs",
  "moonbitlang/async@0.22.4/shell",
  "moonbitlang/core/json",
  "moonbitlang/x@0.5.5/crypto",
}

///|
async fn main {
  let root = "/home/HwHiAiUser/coffee-contact-20261109"
  let parent = "/home/HwHiAiUser/coffee-auth-queue-20261107"
  let moon = "/home/HwHiAiUser/.moon-new/bin/moon"
  if !@fs.exists(root + "/ui") {
    @shell.Cmd("cp", ["-a", parent + "/participation-20261109/ui", root + "/ui"]).run()
    @shell.Cmd("tar", ["-xzf", root + "/ui.tgz", "-C", root + "/ui"]).run()
    for
      name in ["coffee-auth.js", "coffee-acquisition.js", "coffee-contest.html"] {
      let path = root + "/ui/" + name
      if @fs.exists(path + ".gz") {
        @fs.remove(path + ".gz")
      }
      @fs.write_file(
        path + ".etag",
        "\"" +
        @crypto.bytes_to_hex_string(
          @crypto.sha256(@fs.read_file(path).binary()),
        ) +
        "\"",
        create_mode=CreateOrTruncate,
      )
      @shell.Cmd("gzip", ["-n", "-9", "-k", path]).run()
    }
  }
  guard @fs.read_file(root + "/ui/coffee-contest.html")
    .text()
    .contains("手机号或邮箱") else {
    fail("Unexpected staged UI")
  }
  @shell.Cmd(moon, [
    "run",
    parent + "/package-account-ui.mbtx",
    "--",
    parent + "/ui-original-recovery-oci.oci.tar",
    root + "/ui",
    root + "/ui-oci-qualified",
    "account-binding-coffee-contact-20261109",
  ]).run()
  @shell.Cmd(moon, [
    "run",
    "/home/HwHiAiUser/image-runtime-20261107/publish-account-gateway.mbtx",
    "--",
    root + "/ui-oci-qualified",
    "https://lunanexa-registry.lunanexa-registry.svc.cluster.local:5000",
    "moon/moontown-account-ui",
    "account-binding-coffee-contact-20261109",
    "/etc/ssl/certs/ca-certificates.crt",
  ]).run()
  guard @json.parse(@fs.read_file(root + "/ui-oci-qualified/index.json").text())
    is { "manifests": [{ "digest": String(digest), .. }], .. } else {
    fail("Missing UI digest")
  }
  @fs.write_file(
    root + "/ui-release.json",
    ({ "ui": digest } : Json).stringify(),
    permission=0o600,
    create_mode=CreateNew,
  )
  println("Packaged UI " + digest + "; no deployment changed")
}
