+/* GTK owns the main thread during gtk_main(). MoonBit's async signal handler
+ * cannot unwind that blocking call, so route stop signals through GMainContext.
+ * The callback borrows its stack context only until sources are removed below. */
+static int lepusa_linux_stop_gui_on_signal(void *data) {
+  LepusaLinuxBridgeContext *context = data;
+  while (context->window_count > 0) {
+    int before = context->window_count;
+    context->api->gtk_widget_destroy(context->windows[0].window);
+    if (context->window_count >= before) {
+      context->api->gtk_main_quit();
+      break;
+    }
+  }
+  return 1; /* Keep the source alive until explicit main-loop cleanup. */
 }
 
