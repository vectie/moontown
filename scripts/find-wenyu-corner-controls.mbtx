import {
  "moonbitlang/x@0.4.40/fs",
  "moonbitlang/core/json",
  "moonbitlang/core/env",
  "moonbitlang/core/encoding/base64",
}

///|
struct Geo { lon : Double; lat : Double } derive(ToJson, Debug)

///|
struct Way { id : Double; name : String; geometry : Array[Geo] }

///|
fn field(j : Json, key : String) -> Json { match j { Object(m) => m.get(key).unwrap_or(Json::null()); _ => Json::null() } }

///|
fn arr(j : Json) -> Array[Json] { match j { Array(a) => a; _ => [] } }

///|
fn num(j : Json) -> Double { match j { Number(n, ..) => n; _ => abort("Expected numeric coordinate") } }

///|
fn str(j : Json) -> String { match j { String(s) => s; _ => "" } }

///|
fn cross(a : Geo,b : Geo,c : Geo,d : Geo) -> Geo? {
  let ux = b.lon-a.lon
  let uy = b.lat-a.lat
  let vx = d.lon-c.lon
  let vy = d.lat-c.lat
  let det = ux*vy-uy*vx
  if det.abs() < 0.000000000000001 { return None }
  let dx = c.lon-a.lon
  let dy = c.lat-a.lat
  let t = (dx*vy-dy*vx)/det
  let s = (dx*uy-dy*ux)/det
  if t < 0.0 || t > 1.0 || s < 0.0 || s > 1.0 { return None }
  Some({lon:a.lon+t*ux,lat:a.lat+t*uy})
}

///|
fn main raise {
  assert_true(cross({lon:0.0,lat:0.0},{lon:2.0,lat:2.0},{lon:0.0,lat:2.0},{lon:2.0,lat:0.0}) is Some({lon:1.0,lat:1.0}))
  let reference_path = @env.get_env_var("WENYU_OSM_REFERENCE").unwrap_or("docs/project/wenyu-corner-osm-reference.json")
  let raw_text = @fs.read_file_to_string(reference_path)
  let raw = @json.parse(raw_text)
  let ways : Array[Way] = arr(field(raw,"elements")).map(j=>{
    let name = str(field(field(j,"tags"),"name"))
    let geometry : Array[Geo] = arr(field(j,"geometry")).map(p=>{lon:num(field(p,"lon")),lat:num(field(p,"lat"))})
    {id:num(field(j,"id")),name,geometry}
  })
  let pairs = [("立汤路","温榆河"),("立汤路","北沙河"),("立汤路","定泗路"),("立汤路","北清路"),("京承高速","顺于路"),("京承高速","机场北线"),("京承高速","首都机场北线高速公路"),("立汤路","顺于路")]
  let results : Array[Json] = []
  for pair in pairs {
    let (one,two) = pair
    for a in ways.filter(w=>w.name==one) {
      for b in ways.filter(w=>w.name==two) {
        for i in 1..<a.geometry.length() {
          for j in 1..<b.geometry.length() {
            if cross(a.geometry[i-1],a.geometry[i],b.geometry[j-1],b.geometry[j]) is Some(p) {
              let result : Json = {"roads":[one,two],"ways":[a.id,b.id],"coordinate":p.to_json()}
              results.push(result)
            }
          }
        }
      }
    }
  }
  let report : Json = {"method":"2D crossings of named OSM way centerlines; grade-separated crossings are not routing junctions", "intersections":results,"osmBase":field(field(raw,"osm3s"),"timestamp_osm_base")}
  println(report.stringify(indent=2))
  @fs.write_string_to_file("docs/project/wenyu-corner-osm-intersections.json",report.stringify(indent=2))
  if @env.get_env_var("WENYU_INTERSECTIONS_ONLY") is Some("1") { return }
  @fs.write_string_to_file("docs/project/wenyu-corner-osm-reference.json",raw_text)
  let definitions = [
    ("NW", "立汤路", "温榆河", [106616524.0,106616542.0], 1060, 147, 728, 37, 8, 4),
    ("NE", "京承高速", "顺于路", [158054660.0,158054718.0], 1882, 614, 1503, 416, 8, 5),
    ("SE", "京承高速", "机场北线", [126860126.0,158054613.0], 1738, 971, 1430, 722, 18, 12),
    ("SW", "立汤路", "定泗路", [1250750580.0,1250776519.0,1257119855.0,1257123252.0], 630, 403, 548, 439, 12, 8),
  ]
  let controls : Array[Json] = []
  for def in definitions {
    let (id,one,two,allowed,ox,oy,gx,gy,ou,gu) = def
    let points : Array[Geo] = []
    let evidence : Array[Json] = []
    for j in results {
      let names = arr(field(j,"roads"))
      let ids = arr(field(j,"ways"))
      if str(names[0])!=one || str(names[1])!=two || !allowed.contains(num(ids[0])) { continue }
      let q = field(j,"coordinate")
      let p : Geo = {lon:num(field(q,"lon")),lat:num(field(q,"lat"))}
      if points.any(q=>(p.lon-q.lon).abs() < 0.0000000001 && (p.lat-q.lat).abs() < 0.0000000001) { continue }
      points.push(p); evidence.push(j)
    }
    assert_eq(points.length(),if id=="NW" || id=="NE" {2} else {4})
    let lon = points.fold(init=0.0,(s,p)=>s+p.lon)/points.length().to_double()
    let lat = points.fold(init=0.0,(s,p)=>s+p.lat)/points.length().to_double()
    let j : Json = {"id":id,"name":one+" × "+two,"role":"fit","weight":1,"reviewStatus":if id=="SW" {"corrected-candidate-topology-reviewed-not-surveyed"} else {"visually-reviewed-not-surveyed"},
      "wgs84":{"lon":lon,"lat":lat},"original":{"x":ox,"y":oy},"generated":{"x":gx,"y":gy},
      "originalPickRadiusPixels":ou,"generatedPickRadiusPixels":gu,
      "osmPointDefinition":"Mean of unique crossings of the selected main carriageway centerlines; grade separation does not imply a connected routing junction.",
      "evidenceCrossings":evidence}
    controls.push(j)
  }
  // Ordered NW, NE, SE, SW form a convex perimeter, not a bridge chain.
  let coverage : Array[Json] = []
  for tuple in [("original",2274.0,1280.0),("generated",1672.0,941.0)] {
    let (which,width,height) = tuple
    let mut area = 0.0
    let mut sign = 0.0
    for i in 0..<4 {
      let p = field(controls[i],which)
      let q = field(controls[(i+1)%4],which)
      let r = field(controls[(i+2)%4],which)
      let px = num(field(p,"x")); let py = num(field(p,"y"))
      let qx = num(field(q,"x")); let qy = num(field(q,"y"))
      let rx = num(field(r,"x")); let ry = num(field(r,"y"))
      assert_true(px>=0.0 && px<width && py>=0.0 && py<height)
      let turn = (qx-px)*(ry-qy)-(qy-py)*(rx-qx)
      if i==0 {sign=turn} else {assert_true(turn*sign>0.0)}
      area += px*qy-py*qx
    }
    let fraction = area.abs()/2.0/(width*height)
    // Identity takes precedence over maximizing canvas coverage. Moving the
    // rejected southern junction north necessarily shrinks this hull.
    assert_true(fraction>0.0 && fraction<1.0)
    coverage.push({"image":which,"controlHullFraction":fraction})
  }
  let manifest : Json = {"schema":"moontown.wenyu_four_corner_controls.v1","runtimeEligible":false,
    "fourCornerSetReady":true,
    "status":"Four provisional controls available for diagnostic fitting; SW image correspondence corrected, not survey-validated or runtime-approved",
    "swCorrection":{"osmAnchorChanged":false,"rejectedOriginal":{"x":175,"y":694},"rejectedGenerated":{"x":410,"y":760},"correctedOriginal":{"x":630,"y":403},"correctedGenerated":{"x":548,"y":439},"reason":"Keep Litang–Dingsi OSM junction fixed. Move both raster picks to the northern large Litang crossroad whose eastbound corridor runs north of the central wetland toward the southeast airport interchange. The old picks were a different junction farther south.","confidence":"Topological/manual candidate, not a surveyed correspondence; published road labels establish Litang and Jingcheng but do not directly label this raster junction as Dingsi."},
    "cornerMeaning":"Corners of the shared Litang–Jingcheng site footprint, not the literal image canvas corners; north/east labels are geographic.",
    "coordinateSource":"Fresh OSM named-way geometry, not the previous authority-table or map-click coordinates.",
    "osmSnapshot":"docs/project/wenyu-corner-osm-reference.json","osmBase":field(field(raw,"osm3s"),"timestamp_osm_base"),
    "sourceEndpoint":"https://overpass-api.de/api/interpreter","sourceBounds":[116.375,40.075,116.51,40.175],
    "sourceQuery":"[out:json][timeout:35];(way[highway][name~\"立汤|定泗|北清|京承|机场北|顺于|北六环\"](40.075,116.375,40.175,116.51);way[waterway=river](40.075,116.375,40.175,116.51););out geom;",
    "labelEvidence":"https://www.kechuangfuwu.com/ueditor/fileupload/file/20210304/1614839499074030180.jpg",
    "imageMatchingEvidence":"Trace the labeled Litang west boundary from the river bridge to the large crossroad north of the central wetland, not the lower crossroad below that wetland. Its eastbound corridor passes north of the wetland toward the southeast airport interchange, matching the OSM Dingsi corridor ordering. Trace Jingcheng to the crossroad above the east-bank campus and the large interchange below its river crossing. Picks are independent visual candidates, not fitted predictions.",
    "caution":"The 2021 design and AI-generated terrain can simplify or change junction geometry. Exact OSM vector intersections do not eliminate manual raster uncertainty; the southeast interchange has the widest pick radius.",
    "coverageMeaning":"Current provisional control hull as a fraction of image canvas; coverage is reported, not maximized by choosing a different junction.",
    "coverage":coverage,"controls":controls}
  assert_eq(controls.filter(j=>str(field(j,"role"))=="fit").length(),4)
  assert_eq(str(field(controls[3],"reviewStatus")),"corrected-candidate-topology-reviewed-not-surveyed")
  let sw = controls[3]
  assert_true((num(field(field(sw,"wgs84"),"lon"))-116.405675675).abs()<0.000000001)
  assert_true((num(field(field(sw,"wgs84"),"lat"))-40.11513705).abs()<0.000000001)
  assert_eq(num(field(field(sw,"original"),"x")),630.0)
  assert_eq(num(field(field(sw,"original"),"y")),403.0)
  assert_eq(num(field(field(sw,"generated"),"x")),548.0)
  assert_eq(num(field(field(sw,"generated"),"y")),439.0)
  @fs.write_string_to_file("docs/project/wenyu-four-corner-controls.json",manifest.stringify(indent=2))
  println(manifest.stringify(indent=2))
  let source = @env.get_env_var("WENYU_REFERENCE_IMAGE").unwrap_or("")
  if source == "" { fail("set WENYU_REFERENCE_IMAGE to the private planning image") }
  let jpg = @base64.encode(@fs.read_file_to_bytes(source))
  let png = @base64.encode(@fs.read_file_to_bytes("src/ui/assets/tilemap/wenyu_topdown_semantic.png"))
  let svg = StringBuilder()
  svg.write_string("<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 1800 1230'><rect width='1800' height='1230' fill='#182a29'/><style>text{font-family:system-ui,sans-serif;fill:#f6f3e9}.title{font-size:28px;font-weight:650}.note{font-size:20px}.small{font-size:17px}.pin{font-size:32px;font-weight:750;paint-order:stroke;stroke:#182a29;stroke-width:5px}</style><defs><marker id='arrow' viewBox='0 0 10 10' refX='9' refY='5' markerWidth='7' markerHeight='7' orient='auto-start-reverse'><path d='M0,0 L10,5 L0,10Z' fill='#63f2c2'/></marker></defs><text x='30' y='44' class='title'>SW corrected candidate · same 立汤路 × 定泗路 junction</text><text x='30' y='80' class='note'>OSM anchor unchanged. Move both image pins north: green SW = new pick; red × = rejected pick. Manual review, no runtime edits.</text>")
  for i in 0..<2 {
    let which = if i==0 {"original"} else {"generated"}
    let left = 30+i*900
    let width = if i==0 {2274} else {1672}
    let height = if i==0 {1280} else {941}
    let mime = if i==0 {"jpeg"} else {"png"}
    let bytes = if i==0 {jpg} else {png}
    svg.write_string("<text x='\{left}' y='126' class='note'>\{if i==0 {"Original plan · 2274 × 1280"} else {"Generated terrain · 1672 × 941"}}</text><svg x='\{left}' y='145' width='840' height='473' viewBox='0 0 \{width} \{height}'><image href='data:image/\{mime};base64,\{bytes}' width='\{width}' height='\{height}'/>")
    let polygon = controls.map(j=>{
      let p = field(j,which)
      "\{num(field(p,"x"))},\{num(field(p,"y"))}"
    }).join(" ")
    svg.write_string("<polygon points='\{polygon}' fill='none' stroke='#b9bdba' stroke-opacity='0.55' stroke-width='4' stroke-dasharray='12 9'/>")
    for j in controls {
      let p = field(j,which)
      let x = num(field(p,"x")); let y = num(field(p,"y"))
      let label = str(field(j,"id"))
      let color = if label=="SW" {"#63f2c2"} else {"#ff386c"}
      if label=="SW" {
        let oldx = if i==0 {175.0} else {410.0}
        let oldy = if i==0 {694.0} else {760.0}
        svg.write_string("<path d='M\{oldx+24},\{oldy-24}L\{x-24},\{y+24}' stroke='#63f2c2' stroke-width='4' stroke-dasharray='12 8' marker-end='url(#arrow)'/><path d='M\{oldx-16},\{oldy-16}l32,32m-32,0l32,-32' stroke='#ff386c' stroke-width='7'/><text x='\{oldx+22}' y='\{oldy+35}' class='pin'>old SW ×</text>")
      }
      svg.write_string("<circle cx='\{x}' cy='\{y}' r='13' fill='none' stroke='\{color}' stroke-width='5'/><path d='M\{x-20},\{y}h40M\{x},\{y-20}v40' stroke='\{color}' stroke-width='3'/><text x='\{x+24}' y='\{y+30}' class='pin'>\{label}</text>")
    }
    svg.write_string("</svg>")
  }
  svg.write_string("<text x='30' y='667' class='note'>OSM geographic reference · named perimeter roads + rivers · north up</text><svg x='30' y='690' width='840' height='480' viewBox='0 0 840 480'><rect width='840' height='480' fill='#2b403b'/>")
  for w in ways {
    let d = StringBuilder()
    for i,p in w.geometry {d.write_string("\{if i==0 {"M"} else {"L"}}\{(p.lon-116.39)*8400.0},\{(40.157-p.lat)*10980.0} ")}
    let river = w.name=="温榆河" || w.name=="北沙河" || w.name=="蔺沟河"
    svg.write_string("<path d='\{d.to_string()}' fill='none' stroke='\{if river {"#67c9cf"} else {"#dcb56c"}}' stroke-width='\{if river {3} else {1}}'/>")
  }
  let poly = controls.map(j=>{
    let p = field(j,"wgs84")
    "\{(num(field(p,"lon"))-116.39)*8400.0},\{(40.157-num(field(p,"lat")))*10980.0}"
  }).join(" ")
  svg.write_string("<polygon points='\{poly}' fill='none' stroke='#b9bdba' stroke-opacity='0.55' stroke-width='2' stroke-dasharray='8 6'/>")
  for j in controls {
    let p = field(j,"wgs84")
    let x = (num(field(p,"lon"))-116.39)*8400.0
    let y = (40.157-num(field(p,"lat")))*10980.0
    let label = if str(field(j,"id"))=="SW" {"SW · unchanged"} else {str(field(j,"id"))}
    let color = if str(field(j,"id"))=="SW" {"#63f2c2"} else {"#ff386c"}
    svg.write_string("<circle cx='\{x}' cy='\{y}' r='6' fill='\{color}' stroke='white' stroke-width='2'/><text x='\{x+12}' y='\{y-12}' class='note'>\{label}</text>")
  }
  svg.write_string("<text x='776' y='28' class='note'>N ↑</text></svg>")
  for i,j in controls {
    let y = 706+i*105
    let p = field(j,"original"); let q = field(j,"generated")
    svg.write_string("<text x='930' y='\{y}' class='note'>\{str(field(j,"id"))} · \{str(field(j,"name"))}</text><text x='930' y='\{y+31}' class='small'>Original (\{num(field(p,"x"))}, \{num(field(p,"y"))}) px · terrain (\{num(field(q,"x"))}, \{num(field(q,"y"))}) px</text><text x='930' y='\{y+58}' class='small'>Pick radius: original ±\{num(field(j,"originalPickRadiusPixels"))} px · terrain ±\{num(field(j,"generatedPickRadiusPixels"))} px</text>")
  }
  svg.write_string("<text x='930' y='1144' class='small'>OSM centers computed from selected carriageway crossings.</text><text x='930' y='1174' class='small'>Manual image picks remain reviewable; no runtime map edits.</text><text x='30' y='1210' class='small'>© OpenStreetMap contributors · ODbL 1.0 · snapshot 2026-09-05 16:18 UTC · reference subset, not a replacement road network</text></svg>")
  @fs.write_string_to_file("docs/project/wenyu-four-corners.svg",svg.to_string())
  @fs.write_string_to_file("src/ui/rabbita-town/dist/wenyu-four-corners.svg",svg.to_string())
}
