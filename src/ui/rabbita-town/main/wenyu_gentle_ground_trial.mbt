///|
/// Explicit presentation-only trial. No change to semantic roads or navigation.
extern "js" fn wenyu_gentle_ground_trial_requested() -> Bool =
  #| () => new URLSearchParams(globalThis.location?.search || '').get('road-trial') === 'gentle'

///|
extern "js" fn wenyu_gentle_bank_requested() -> Bool =
  #| () => new URLSearchParams(globalThis.location?.search || '').get('shore') === '1'

///|
/// Start this explicit review at whole-map scale; subsequent pan/zoom is free.
extern "js" fn wenyu_gentle_ground_trial_fit_camera(
  width : Int32,
  height : Int32,
) -> Unit =
  #| (width, height) => {
  #|   const camera = globalThis.__moontownGoldenValleyCamera;
  #|   if (!camera || camera.livingRoom || camera.gentleTrialFramed) return;
  #|   camera.x = 32 * (128 - 72);
  #|   camera.y = 16 * (128 + 72);
  #|   camera.z = Math.max(0.03, Math.min((width - 100) / 12800, (height - 220) / 6400));
  #|   camera.gentleTrialFramed = true;
  #| }

