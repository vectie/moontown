///|
/// Explicit presentation-only trial. No change to semantic roads or navigation.
extern "js" fn wenyu_gentle_ground_trial_requested() -> Bool =
  #| () => new URLSearchParams(globalThis.location?.search || '').get('road-trial') === 'gentle'

///|
extern "js" fn wenyu_gentle_bank_requested() -> Bool =
  #| () => new URLSearchParams(globalThis.location?.search || '').get('shore') === '1'

///|
/// Start this explicit review at whole-map scale; subsequent pan/zoom is free.
extern "js" fn wenyu_gentle_ground_trial_fit_camera(
  width : Int,
  height : Int,
) -> Unit =
  #| (width, height) => {
  #|   const camera = globalThis.__moontownGoldenValleyCamera;
  #|   if (!camera || camera.gentleTrialFramed) return;
  #|   camera.x = 32 * (128 - 72);
  #|   camera.y = 16 * (128 + 72);
  #|   camera.z = Math.max(0.03, Math.min((width - 100) / 12800, (height - 220) / 6400));
  #|   camera.gentleTrialFramed = true;
  #| }

///|
/// Browser image transport only. Calibration and clipping are generated by the
/// MoonBit authoring script; this boundary must never apply a second road fit.
extern "js" fn wenyu_gentle_ground_overlay(
  context : @dom.CanvasRenderingContext2D,
  camera_x : Double,
  camera_y : Double,
  zoom : Double,
  width : Int,
  height : Int,
) -> Unit =
  #| (context, cameraX, cameraY, zoom, width, height) => {
  #|   const params = new URLSearchParams(globalThis.location?.search || '');
  #|   const shore = Boolean(globalThis.location) && (!params.has('road-trial') || params.get('shore') === '1');
  #|   let asset = globalThis.__wenyuGentleGroundOverlay;
  #|   if (!asset || Boolean(asset.shore) !== shore) {
  #|     const image = new Image();
  #|     asset = { image, state: 'loading', shore };
  #|     globalThis.__wenyuGentleGroundOverlay = asset;
  #|     const complete = state => {
  #|       asset.state = state;
  #|       if (globalThis.__wenyuGentleGroundOverlay === asset)
  #|         globalThis.__moontownGoldenValleyRender?.('road-overlay');
  #|     };
  #|     image.onload = () => complete('ready');
  #|     image.onerror = () => complete('error');
  #|     image.src = 'tilemap/wenyu-unshifted-road-overlay.svg';
  #|   }
  #|   context.save();
  #|   context.transform(32 * zoom, 16 * zoom, -32 * zoom, 16 * zoom,
  #|     width / 2 - cameraX * zoom, height / 2 - cameraY * zoom);
  #|   if (asset.state === 'ready') context.drawImage(asset.image, 0, 0, 256, 144);
  #|   context.restore();
  #|   const root = globalThis.document?.documentElement;
  #|   if (root) {
  #|     root.dataset.wenyuGentleGroundTrial = asset.state;
  #|     root.dataset.wenyuGentleGroundVariant = shore ? 'gentle-unshifted-scene' : 'gentle';
  #|     root.dataset.wenyuRiversideShiftsApplied = 'false';
  #|     root.dataset.wenyuGentleGroundRoutingAuthority = 'false';
  #|   }
  #|   if (!params.has('road-trial')) return;
  #|   context.save();
  #|   context.fillStyle = '#182a29';
  #|   context.fillRect(16, height - 76, Math.min(width - 32, 680), 60);
  #|   context.fillStyle = '#f6f3e9';
  #|   context.font = '14px system-ui';
  #|   context.textAlign = 'left'; context.textBaseline = 'alphabetic';
  #|   context.fillText(shore ? '地块与建筑共址 · 绿脊随绿道 · 桥梁 / 水系固定' : '地形投影试验 · gentle 0.01 / 0.01 · 地形不变 · 不用于导航', 28, height - 51);
  #|   context.fillText(asset.state === 'ready' ? '6,420 OSM ways · 44,343 vertices · shared ground camera' :
  #|     asset.state === 'error' ? 'Road overlay failed to load. Reload to retry.' : 'Loading calibrated road overlay…', 28, height - 29);
  #|   context.restore();
  #| }

///|
/// Ground, lots and actors share the corrected display-space road source.
fn draw_wenyu_gentle_ground_trial(
  context : @dom.CanvasRenderingContext2D,
  snapshot : @energy_valley_contract.TownSnapshot,
  view : TownCanvasViewState,
  width : Int,
  height : Int,
) -> Unit {
  wenyu_gentle_ground_trial_fit_camera(width, height)
  golden_valley_clear_canvas_frame()
  context.clear_rect(0.0, 0.0, width.to_double(), height.to_double())
  golden_draw_background(context, width, height, view.hour)
  let scene_ready = wenyu_rigid_scene_active() && wenyu_scene_prepare()
  if scene_ready {
    town_landmark_prepare()
  }
  let bearing_review = scene_ready && town_bearing_buildings_requested()
  let buildings : Map[Int, Array[IntersectionRoadPreviewBuilding]] = if scene_ready {
    intersection_road_preview_buildings_by_depth(snapshot)
  } else {
    Map([])
  }
  let land = intersection_road_preview_building_land_cells(
    buildings,
    intersection_road_preview_cache_key(snapshot),
  )
  let roads = town_snapshot_canvas_road_lookup(
    town_snapshot_canvas_roads(snapshot),
  )
  let chunks = golden_canvas_visible_tile_chunks(
    town_snapshot_canvas_cols(snapshot),
    town_snapshot_canvas_rows(snapshot),
    width,
    height,
    golden_valley_camera_x(),
    golden_valley_camera_y(),
    golden_valley_camera_zoom(),
  )
  for chunk in chunks {
    for y in chunk.min_y..<chunk.max_y {
      for x in chunk.min_x..<chunk.max_x {
        let terrain_override = if scene_ready &&
          town_landmark_reserved(x.to_double() + 0.5, y.to_double() + 0.5, 0) {
          Some(intersection_road_view_stale_ground_terrain(x, y))
        } else if bearing_review {
          Some(
            if reference_tile_kind_at(x, y) == Some("bridge") {
              "water"
            } else {
              intersection_road_view_stale_ground_terrain(x, y)
            },
          )
        } else if scene_ready {
          // Remove obsolete snapshot pads and spine; terrain evidence stays fixed.
          Some(
            land
            .get(town_canvas_road_key(x, y))
            .unwrap_or(
              if reference_tile_kind_at(x, y) == Some("bridge") {
                "water"
              } else {
                intersection_road_view_stale_ground_terrain(x, y)
              },
            ),
          )
        } else if roads.contains(town_canvas_road_key(x, y)) {
          Some(intersection_road_view_stale_ground_terrain(x, y))
        } else {
          None
        }
        golden_draw_tile(
          context, snapshot, roads, true, false, false, terrain_override, x, y, width,
          height,
        )
        if scene_ready &&
          !town_landmark_reserved(x.to_double() + 0.5, y.to_double() + 0.5, 0.4) &&
          !land.contains(town_canvas_road_key(x, y)) &&
          wenyu_scene_region_clear(wenyu_scene_prefix, x, y, 1, 1) {
          let flower = town_botanical_flower_kind(x, y)
          if flower >= 0 {
            town_botanical_draw_flowers(
              context,
              golden_screen_x(x.to_double() + 0.5, y.to_double() + 0.5, width),
              golden_screen_y(x.to_double() + 0.5, y.to_double() + 0.5, height),
              golden_valley_camera_zoom(),
              flower,
            )
          }
        }
      }
    }
  }
  if scene_ready {
    for _, items in buildings {
      for building in items {
        let (x, y) = intersection_road_preview_building_center(building)
        if town_landmark_reserved(x, y, building.width.to_double() / 2.0) {
          continue
        }
        if bearing_review {
          town_bearing_draw_lot(context, building, width, height)
          continue
        }
        golden_draw_intersection_road_preview_building_lot(
          context,
          golden_screen_x(x, y, width),
          golden_screen_y(x, y, height),
          golden_valley_camera_zoom(),
          intersection_road_preview_building_land_type(building.style),
          building.width.to_double(),
        )
        wenyu_scene_draw_access(context, x, y, width, height)
      }
    }
  }
  wenyu_gentle_ground_overlay(
    context,
    golden_valley_camera_x(),
    golden_valley_camera_y(),
    golden_valley_camera_zoom(),
    width,
    height,
  )
  if scene_ready {
    let production = wenyu_scene_default_requested()
    // Keep explicit user changes above the replacement base-road presentation.
    if production {
      for _, road in roads {
        if road.custom {
          golden_draw_road_overlay_tile(
            context,
            roads,
            Some(road),
            false,
            road.x,
            road.y,
            width,
            height,
          )
        }
      }
    }
    let user_buildings = if production {
      intersection_road_preview_user_buildings(snapshot)
    } else {
      []
    }
    let installations = if production {
      intersection_road_preview_installations_by_depth(snapshot)
    } else {
      Map([])
    }
    let agents = wenyu_scene_walkers(
      golden_animation_seconds(),
      golden_prefers_reduced_motion(),
    )
    golden_begin_spring_civic_building_asset_frame()
    for depth in 0..<432 {
      town_landmark_draw(
        context,
        depth,
        golden_valley_camera_x(),
        golden_valley_camera_y(),
        golden_valley_camera_zoom(),
        width,
        height,
      )
      match installations.get(depth) {
        Some(items) =>
          golden_draw_town_snapshot_installations(
            context,
            items.filter(i => {
              if i.provenance.kind is @energy_valley_contract.UserDelta {
                return true
              }
              match town_snapshot_installation_position(i) {
                Some(p) => !town_landmark_reserved(p.x, p.y, 0.7)
                None => true
              }
            }),
            true,
            width,
            height,
            view.hour,
          )
        None => ()
      }
      golden_draw_agents_at_depth(context, agents, depth, width, height)
      match buildings.get(depth) {
        Some(items) =>
          for building in items {
            let (x, y) = intersection_road_preview_building_center(building)
            if town_landmark_reserved(x, y, building.width.to_double() / 2.0) {
              continue
            }
            golden_draw_intersection_road_preview_building(
              context, building, width, height,
            )
          }
        None => ()
      }
      for building in user_buildings {
        if building.x + building.y + building.width + building.depth == depth {
          let selected = view.selected_place_id == Some(building.place_id)
          golden_draw_building(
            context,
            building,
            selected,
            "",
            width,
            height,
            view.hour,
          )
          golden_draw_ecosystem_place_layer(
            context, snapshot, building, selected, width, height,
          )
        }
      }
    }
    golden_end_spring_civic_building_asset_frame()
    town_landmark_draw_walker(context, width, height)
    let (images, vectors) = intersection_road_preview_building_counts(buildings)
    intersection_road_preview_record_building_counts(images, vectors)
    if bearing_review {
      town_bearing_review(context, width, buildings)
    }
    if production {
      // Same semantic input contract as the former production road view.
      // Decorative road walkers never acquire authoritative actor hit areas.
      golden_valley_accept_canvas_frame_with_runtime_eligibility(
        snapshot, false,
      )
    }
  }
}
