///|
fn setting_descriptor(
  key : String,
  group : String,
  label : String,
  description : String,
  value : Int,
  minimum : Int,
  maximum : Int,
  unit : String,
  apply_mode : String,
) -> Json {
  {
    "key": key,
    "group": group,
    "label": label,
    "description": description,
    "value": value,
    "minimum": minimum,
    "maximum": maximum,
    "unit": unit,
    "apply_mode": apply_mode,
    "editable": true,
  }
}

///| Authoritative Management Board catalog. Visual geometry, protocol schema

///| versions, cryptographic sizes, and algorithmic coefficients are deliberate

///|
