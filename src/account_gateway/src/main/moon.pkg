import {
  "vectie/lunanexa/workspace/webide",
  "vectie/lunanexa/workspace/webide/host",
  "vectie/moontown/account_identity",
  "vectie/moontown/account_system",
  "vectie/moontown/account_compute",
  "vectie/moontown/neighborhood",
  "vectie/moontown/creative_contest",
  "vectie/moontown/activity_program",
  "vectie/moontown/activity_curation",
  "moonbitlang/async",
  "moonbitlang/async/fs",
  "moonbitlang/async/http",
  "moonbitlang/async/io",
  "moonbitlang/async/socket",
  "moonbitlang/core/env",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/json",
  "moonbitlang/core/string",
  "moonbitlang/x/sys",
}

supported_targets = "native"

import { "moonbitlang/core/encoding/base64" } for "wbtest"

pkgtype(kind: "executable")

options(
  link: { "native": { "cc-link-flags": "-pthread -ldl -L/opt/homebrew/lib -lpng16 -lwebp" } },
)
