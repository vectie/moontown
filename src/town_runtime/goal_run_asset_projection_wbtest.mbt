///|
async test "configured default Wenyu asset task persists real Book projection links through launch repeat and reload" {
  // Integration opt-in points to the matching MoonBook checkout/binary. The
  // validation harness runs this against the freshly built provider-free CLI.
  let command = match @env.get_env_var("MOONTOWN_ASSET_PROJECTION_TEST_BIN") {
    Some(command) => command
    None => return
  }
  let root = @fs.tmpdir(prefix="town-wenyu-asset-journey-")
  ignore(@integration.run_checked(command, ["wiki", "init", root]))
  let entry = @moonbook.BookCatalogEntry::new(
    id="wenyu-art-studio",
    name="Wenyu Local Art Studio",
    purpose="Provider-free local projection regression",
    workspace_root=root,
    tags=["wenyu"],
  )
  let task = @build_pipeline.wenyu_build_tasks(
      entry, "Prepare the local art studio", root,
    ).filter(task => task.kind == "image-asset")[0]
  let state = @core.empty_state(
    @core.TownConfig::new(id="local-art", name="Local art"),
  )
  let mayor = @roles.Mayor::new()
  launch_goal_book_task(
    state,
    mayor,
    entry,
    task,
    to_town_task(entry, task, PacketReady),
    1,
    0,
  )
  let execution = @core.find_execution(state, task.id).unwrap()
  assert_eq(execution.run_id, None)
  assert_eq(execution.output_contract, "wenyu.build.local-result.v1")
  assert_eq(execution.status, ReviewQueued)
  assert_true(execution.summary.contains("Generated images remain pending"))
  assert_true(
    execution.summary.contains("Book generated local projection files:"),
  )
  let expected = [
    "build/ASSET_PROMPTS.md", "build/ASSET_MANIFEST.md", "book/site/generated/index.html",
  ]
  assert_eq(book_persist_artifacts(entry, execution), expected)
  let latest = @json.parse(@fs.read_file(root + "/events/latest.json").text())
  guard latest is { "artifacts": Array(artifacts), .. } else {
    fail("Book event did not retain artifact links")
  }
  assert_eq(artifacts, expected.map(path => path.to_json()))
  let html = @fs.read_file(root + "/book/site/generated/index.html").text()
  assert_true(html.contains("styles.css") && html.contains("app.js"))
  assert_false(
    @fs.exists(root + "/src/ui/rabbita-town/assets/" + entry.id + "-tile.png"),
  )
  assert_false(state.events.any(event => event.kind == "error"))
  assert_true(
    state.events.any(event => {
      event.kind == "projection" &&
      event.detail.contains("existing files were preserved")
    }),
  )
  let saved = root + "/town-snapshot.json"
  @storage.save_snapshot_file(saved, @storage.snapshot_of(state))
  let reloaded = @storage.load_snapshot_file(saved).unwrap().town
  assert_eq(@core.find_execution(reloaded, task.id), Some(execution))
  assert_eq(
    book_persist_artifacts(
      entry,
      @core.find_execution(reloaded, task.id).unwrap(),
    ),
    expected,
  )
  let human = "<html>Human newer output must survive default task finalization</html>"
  let prompts = "Human prompt edits must survive"
  let manifest = "Provider manifest with existing assets must survive"
  @fs.write_file(
    root + "/book/site/generated/index.html",
    human,
    create_mode=CreateOrTruncate,
  )
  @fs.write_file(
    root + "/build/ASSET_PROMPTS.md",
    prompts,
    create_mode=CreateOrTruncate,
  )
  @fs.write_file(
    root + "/build/ASSET_MANIFEST.md",
    manifest,
    create_mode=CreateOrTruncate,
  )
  launch_goal_book_task(
    reloaded,
    mayor,
    entry,
    task,
    to_town_task(entry, task, PacketReady),
    2,
    0,
  )
  let repeated = @core.find_execution(reloaded, task.id).unwrap()
  assert_true(
    repeated.summary.contains(
      "provenance unverified; not generated by this task",
    ),
  )
  assert_eq(
    @fs.read_file(root + "/book/site/generated/index.html").text(),
    human,
  )
  assert_eq(@fs.read_file(root + "/build/ASSET_PROMPTS.md").text(), prompts)
  assert_eq(@fs.read_file(root + "/build/ASSET_MANIFEST.md").text(), manifest)
  assert_eq(book_persist_artifacts(entry, repeated), expected)
  assert_false(reloaded.events.any(event => event.kind == "error"))
}

///|
async test "local Wenyu no-run persistence includes actual backlog outputs and omits missing declarations" {
  let root = @fs.tmpdir(prefix="town-wenyu-backlog-links-")
  let entry = @moonbook.BookCatalogEntry::new(
    id="wenyu-studio",
    name="Wenyu",
    purpose="Local backlog",
    workspace_root=root,
    tags=["wenyu"],
  )
  let task = @build_pipeline.wenyu_build_tasks(
      entry, "Prepare implementation", root,
    ).filter(task => task.kind == "implementation-backlog")[0]
  let execution = execute_goal_book_task(@roles.Mayor::new(), entry, task)
  let completed = @build_pipeline_runtime.complete_wenyu_build_artifacts_if_needed(
    entry, task, execution,
  )
  assert_eq(completed.run_id, None)
  assert_eq(book_persist_artifacts(entry, completed), task.target_pages)
  let missing = copy_execution_with(completed, context_pages=[
    "build/MISSING.md", "repo:this-moontown-checkout", "../outside.md",
  ])
  assert_eq(book_persist_artifacts(entry, missing), [])
}

///|
async test "configured missing local projection is not silently created after persistence and recovers on repeat task" {
  let command = match @env.get_env_var("MOONTOWN_ASSET_PROJECTION_TEST_BIN") {
    Some(command) => command
    None => return
  }
  let root = @fs.tmpdir(prefix="town-wenyu-missing-projection-")
  ignore(@integration.run_checked(command, ["wiki", "init", root]))
  @fs.mkdir(root + "/book/site/generated/index.html", recursive=true)
  let entry = @moonbook.BookCatalogEntry::new(
    id="wenyu-local-art",
    name="Wenyu local art",
    purpose="Missing projection regression",
    workspace_root=root,
    tags=["wenyu"],
  )
  let task = @build_pipeline.wenyu_build_tasks(
      entry, "Prepare local projection", root,
    ).filter(task => task.kind == "image-asset")[0]
  let state = @core.empty_state(
    @core.TownConfig::new(id="missing-art", name="Missing art"),
  )
  let mayor = @roles.Mayor::new()
  launch_goal_book_task(
    state,
    mayor,
    entry,
    task,
    to_town_task(entry, task, PacketReady),
    1,
    0,
  )
  let execution = @core.find_execution(state, task.id).unwrap()
  assert_true(
    execution.summary.contains(
      "Missing projection outputs: book/site/generated/index.html",
    ),
  )
  assert_eq(book_persist_artifacts(entry, execution), [
    "build/ASSET_PROMPTS.md", "build/ASSET_MANIFEST.md",
  ])
  let before = @fs.read_file(root + "/events/latest.json").text()
  guard @json.parse(before) is { "artifacts": Array(artifacts), .. } else {
    fail("Missing Book event")
  }
  assert_eq(artifacts, [
    "build/ASSET_PROMPTS.md".to_json(),
    "build/ASSET_MANIFEST.md".to_json(),
  ])
  // Remove only the empty fixture directory created above, simulating the
  // obstacle clearing after Book persistence. Finalization must stay read-only.
  @fs.rmdir(root + "/book/site/generated/index.html")
  assert_eq(
    build_goal_book_workspace_or_record_error(state, entry, local_outputs=true),
    None,
  )
  assert_false(@fs.exists(root + "/book/site/generated/index.html"))
  assert_eq(@fs.read_file(root + "/events/latest.json").text(), before)
  launch_goal_book_task(
    state,
    mayor,
    entry,
    task,
    to_town_task(entry, task, PacketReady),
    2,
    0,
  )
  let recovered = @core.find_execution(state, task.id).unwrap()
  assert_true(
    book_persist_artifacts(entry, recovered).contains(
      "book/site/generated/index.html",
    ),
  )
  let latest = @json.parse(@fs.read_file(root + "/events/latest.json").text())
  guard latest is { "artifacts": Array(artifacts), .. } else {
    fail("Missing recovered Book event")
  }
  assert_true(artifacts.contains("book/site/generated/index.html".to_json()))
}
