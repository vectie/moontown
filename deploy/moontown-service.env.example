# Example only: replace every domain and path with the target installation's
# approved values. Keep the rendered service environment outside Git.
# Public gate is mandatory for any non-loopback service.
MOONTOWN_DESKTOP_BIND=0.0.0.0:5007
MOONTOWN_PUBLIC_HOST=platform.example:5007
MOONTOWN_IDENTITY_ENDPOINT=https://identity.platform.example
MOONTOWN_IDENTITY_HOST=identity.platform.example
MOONSUITE_ROOT=/srv/moonsuite
MOONTOWN_DESKTOP_STATIC_ROOT=/opt/moontown/current/ui
MOONTOWN_OPERATOR_POLICY_PATH=/opt/moontown/current/assets/templates/operator-request-policy.json
MOONTOWN_MOONCLAW_BIN=/opt/moonsuite/bin/moonclaw
MOONTOWN_MOONBOOK_BIN=/opt/moonsuite/bin/moonbook
MOONBOOK_MODULE_ROOT=/opt/moonsuite/moonbook
MOON_HOME=/opt/moonbit
MOON_BIN=/opt/moonbit/bin/moon
PATH=/opt/moonsuite/bin:/opt/moonbit/bin:/usr/local/bin:/usr/bin:/bin
