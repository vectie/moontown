town-api.example.com {
  # Exact package responses must retain their original serialization.
  @transformable not path /miniapp/marketplace/portable-packages/content
  encode @transformable zstd gzip

  log {
    output file /var/log/moonsuite/moontown-access.log
    format filter {
      wrap json
      fields {
        request>headers>X-Miniapp-Session delete
        request>headers>Authorization delete
      }
    }
  }

  # One disjoint raw-upload exception. Every other write retains 128KB.
  @packageUpload {
    method PUT
    path /miniapp/marketplace/portable-packages/content
  }
  request_body @packageUpload {
    # Exact raw-byte limit: 64 MiB (avoid decimal MB ambiguity).
    max_size 67108864
  }
  @writes {
    method POST PUT PATCH DELETE
    not {
      method PUT
      path /miniapp/marketplace/portable-packages/content
    }
  }
  request_body @writes {
    max_size 128KB
  }

  reverse_proxy 127.0.0.1:18191 {
    header_up Host {host}
    header_up X-Forwarded-Proto https
  }

  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options nosniff
    Referrer-Policy no-referrer
    -Server
  }
}
