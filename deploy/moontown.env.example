# Non-secret deployment settings. Supply secrets through the service manager.
MOONSUITE_ROOT=/srv/moonsuite/tenant
MOONTOWN_MINIAPP_BIND=127.0.0.1:18191
MOONTOWN_MINIAPP_TENANT_ID=replace-with-tenant-id
MOONTOWN_MINIAPP_PRINCIPAL_ID=replace-with-service-bootstrap-principal
MOONTOWN_MINIAPP_PRINCIPAL_NAME=MoonTown
MOONTOWN_PUBLIC_BASE_URL=https://town-api.example.com
MOONTOWN_CDN_BASE_URL=https://cdn.example.com/moontown
MOONCLAW_ROOT=/srv/moonsuite/moonclaw
MOONCLAW_SUPERVISOR_WORKER_ACCOUNTING_MODE=metered

# Secret-manager values; never commit real values.
MOONTOWN_MINIAPP_SESSION_TOKEN=secret://moontown/session-bootstrap
MOONGATE_CONTROL_TOKEN=secret://moongate/control-token
MOONCLAW_CODEX_CREDENTIALS=secret://moonclaw/codex-credentials
