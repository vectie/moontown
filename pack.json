{
  "id": "moontown",
  "version": "0.1.0",
  "display_name": "MoonTown Civic Synthesis",
  "product_id": "moontown",
  "kind": "DomainPack",
  "app_area": {
    "id": "coordination.town",
    "category": "coordination",
    "label": "Town"
  },
  "app_presentation": {
    "contract_id": "moonsuite.pack-presentation.v1",
    "icon": "🏘️",
    "surface": "infinite-canvas",
    "primary_action_label": "Open town",
    "launch_query": [
      {"key": "seed", "value": "20260727"}
    ]
  },
  "required_runtime_extensions": ["moonflow", "moonclaw", "moonbook"],
  "book_templates": [],
  "template_catalogs": [
    {
      "id": "moontown.civic-templates",
      "version": "1.0.0",
      "path": "assets/templates/catalog.v1.json"
    },
    {
      "id": "moontown.knowledge-domains",
      "version": "1.0.0",
      "path": "assets/templates/domains/catalog.v1.json"
    }
  ],
  "schemas": [
    {
      "id": "civic-communication-handoff",
      "version": "1.0.0",
      "path": "schemas/civic-communication-handoff.schema.json"
    },
    {
      "id": "civic-synthesis-result",
      "version": "1.0.0",
      "path": "schemas/civic-synthesis-result.schema.json"
    },
    {
      "id": "knowledge-domain-catalog",
      "version": "1.0.0",
      "path": "schemas/knowledge-domain-catalog.schema.json"
    },
    {
      "id": "supervisor-profile",
      "version": "1.0.0",
      "path": "schemas/supervisor-profile.schema.json"
    },
    {
      "id": "supervisor-activation-handoff",
      "version": "1.0.0",
      "path": "schemas/supervisor-activation-handoff.schema.json"
    },
    {
      "id": "supervisor-execution-handoff",
      "version": "2.0.0",
      "path": "schemas/supervisor-execution-handoff.schema.json"
    },
    {
      "id": "supervisor-bookkeeper-review-request",
      "version": "1.0.0",
      "path": "schemas/supervisor-bookkeeper-review-request.schema.json"
    }
  ],
  "tools": [
    {
      "id": "civic.communication.synthesize",
      "owner_product": "moontown",
      "input_schema_id": "civic-communication-handoff",
      "output_schema_id": "civic-synthesis-result",
      "authority": "WorkspaceMutation",
      "idempotent": true,
      "evidence_outputs": [
        "records/civic-synthesis",
        "books/*/wiki/civic",
        "books/*/wiki/reviews"
      ],
      "review_required": true
    },
    {
      "id": "supervisor.profile.save",
      "owner_product": "moontown",
      "input_schema_id": "supervisor-profile",
      "output_schema_id": "supervisor-profile",
      "authority": "WorkspaceMutation",
      "idempotent": true,
      "evidence_outputs": ["supervisor-setup/state.json"],
      "review_required": false
    },
    {
      "id": "supervisor.activation.enqueue",
      "owner_product": "moontown",
      "input_schema_id": "supervisor-profile",
      "output_schema_id": "supervisor-activation-handoff",
      "authority": "WorkspaceMutation",
      "idempotent": true,
      "evidence_outputs": ["supervisor-setup/state.json"],
      "review_required": false
    }
  ],
  "workflows": [
    {
      "id": "civic-communication-synthesis",
      "version": "1.0.0",
      "path": "workflows/civic-communication-synthesis.md"
    }
  ],
  "skills": [],
  "policies": [
    {
      "id": "civic-synthesis-authority",
