    }
  ],
  "schedules": [],
  "app_entrypoints": [
    {
      "id": "energy-valley",
      "path": "/index.html",
      "audience": "civic-operator"
    }
  ],
  "migrations": [],
  "evaluations": [],
  "uninstall_contract": {
    "id": "moontown-pack-uninstall",
    "version": "1.0.0",
    "path": "UNINSTALL.md"
  }
