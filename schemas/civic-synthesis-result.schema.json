{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "moontown.civic-synthesis-result.v1",
  "title": "MoonTown civic synthesis result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_id",
    "operation_ref",
    "request_id",
    "attempt_id",
    "idempotency_key",
    "handoff_id",
    "producer",
    "producer_run_id",
    "scenario_id",
    "round_id",
    "round_number",
    "execution_status",
    "review_status",
    "accepted",
    "claim_ceiling",
    "reducer_kind",
    "participant_count",
    "reviewable_output_count",
    "receipt_ref",
    "evidence",
    "summary"
  ],
  "properties": {
    "contract_id": {"const": "moontown.civic-synthesis-result.v1"},
    "operation_ref": {
      "const": "moontown/civic.communication.synthesize@0.1.0"
    },
    "request_id": {"type": "string", "minLength": 1},
    "attempt_id": {"type": "string", "minLength": 1},
    "idempotency_key": {"type": "string", "minLength": 1},
    "handoff_id": {"type": "string", "minLength": 1},
    "producer": {"type": "string", "minLength": 1},
    "producer_run_id": {"type": "string", "minLength": 1},
    "scenario_id": {"type": "string", "minLength": 1},
    "round_id": {"type": "string", "minLength": 1},
    "round_number": {"type": "integer", "minimum": 1},
    "execution_status": {
      "enum": ["completed", "blocked", "rejected"]
    },
    "review_status": {
      "enum": ["pending", "blocked"]
    },
    "accepted": {"const": false},
    "claim_ceiling": {"const": "execution-result"},
    "reducer_kind": {
      "enum": ["moonclaw", "fixture"]
    },
    "participant_count": {"type": "integer", "minimum": 0},
    "reviewable_output_count": {"type": "integer", "minimum": 0},
    "receipt_ref": {"$ref": "#/$defs/relativePath"},
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ref", "digest"],
        "properties": {
          "ref": {"$ref": "#/$defs/relativePath"},
          "digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        }
      }
    },
    "summary": {"type": "string", "minLength": 1}
  },
  "allOf": [
    {
      "if": {
        "properties": {"execution_status": {"const": "completed"}}
      },
      "then": {
        "properties": {
          "review_status": {"const": "pending"},
          "participant_count": {"minimum": 2},
          "reviewable_output_count": {"minimum": 1}
        }
      },
      "else": {
        "properties": {
          "review_status": {"const": "blocked"},
          "reviewable_output_count": {"const": 0}
        }
      }
    }
  ],
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    }
  }
}
