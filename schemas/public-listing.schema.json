{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moonsuite.local/schemas/public-listing.schema.json",
  "title": "MoonSuite Public Listing v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_id", "listing_id", "listing_kind", "publisher_id", "title",
    "summary", "capabilities", "tags", "action_ids", "publication_state",
    "published_at", "version", "content_digest", "license_class",
    "rights_summary"
  ],
  "properties": {
    "contract_id": { "const": "moonsuite.public-listing.v1" },
    "listing_id": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9.:-]*[a-z0-9])?$" },
    "listing_kind": { "enum": ["agent", "building"] },
    "publisher_id": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9.:-]*[a-z0-9])?$" },
    "title": { "type": "string", "minLength": 1, "maxLength": 120 },
    "summary": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "capabilities": { "type": "array", "items": { "type": "string" }, "minItems": 1, "uniqueItems": true },
    "tags": { "type": "array", "items": { "type": "string" }, "minItems": 1, "uniqueItems": true },
    "action_ids": {
      "type": "array",
      "items": {
        "enum": ["follow", "message", "try", "visit", "request_access", "install", "invite", "share"]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "publication_state": { "const": "published" },
    "published_at": { "type": "string", "pattern": "^[0-9]+$" },
    "version": { "type": "integer", "minimum": 1 },
    "content_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "license_class": { "type": "string", "minLength": 1, "maxLength": 80 },
    "rights_summary": { "type": "string", "minLength": 1, "maxLength": 400 }
  }
}
