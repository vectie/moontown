{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "moontown.civic-communication-handoff.v1",
  "title": "MoonTown civic communication handoff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "handoff_id",
    "producer",
    "producer_run_id",
    "scenario"
  ],
  "properties": {
    "contract_version": {
      "const": "moontown.civic.communication.handoff.v1"
    },
    "handoff_id": {
      "type": "string",
      "minLength": 1
    },
    "producer": {
      "type": "string",
      "minLength": 1
    },
    "producer_run_id": {
      "type": "string",
      "minLength": 1
    },
    "scenario": {
      "$ref": "#/$defs/scenario"
    }
  },
  "$defs": {
    "participant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "book_id",
        "title",
        "focus_area",
        "perspective",
        "cadence",
        "current_question",
        "contribution",
        "next_artifact"
      ],
      "properties": {
        "book_id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "focus_area": {"type": "string", "minLength": 1},
        "perspective": {"type": "string", "minLength": 1},
        "cadence": {"type": "string", "minLength": 1},
        "current_question": {"type": "string", "minLength": 1},
        "contribution": {"type": "string", "minLength": 1},
        "next_artifact": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        }
      }
    },
    "idea": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "summary",
        "participating_books",
        "research_questions",
        "why_it_matters",
        "next_experiment"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1},
        "participating_books": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "research_questions": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "why_it_matters": {"type": "string", "minLength": 1},
        "next_experiment": {"type": "string", "minLength": 1}
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "building_id",
        "building_book_id",
        "domain_label",
        "topic",
        "cadence",
        "skill_name",
        "skill_description",
        "protocol_channel",
        "reduction_kind",
        "output_channel",
        "review_gate",
        "review_owner",
        "review_reason",
        "backlog_path",
        "synthesis_path",
        "metrics_path",
        "review_path",
        "returned_ideas_path",
        "participant_contract_path",
        "quality_rules",
        "skill_rules",
        "participants",
        "ideas"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "communication_pattern_id": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "communication_pattern_label": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "building_id": {"type": "string", "minLength": 1},
        "building_book_id": {"type": "string", "minLength": 1},
        "domain_label": {"type": "string", "minLength": 1},
        "topic": {"type": "string", "minLength": 1},
        "cadence": {"type": "string", "minLength": 1},
        "interval_ms": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "skill_name": {"type": "string", "minLength": 1},
        "skill_description": {"type": "string", "minLength": 1},
        "protocol_channel": {"type": "string", "minLength": 1},
        "reduction_kind": {"type": "string", "minLength": 1},
        "output_channel": {"type": "string", "minLength": 1},
        "review_gate": {"type": "string", "minLength": 1},
        "review_owner": {"type": "string", "minLength": 1},
        "review_reason": {"type": "string", "minLength": 1},
        "backlog_path": {"$ref": "#/$defs/relativePath"},
        "synthesis_path": {"$ref": "#/$defs/relativePath"},
        "metrics_path": {"$ref": "#/$defs/relativePath"},
        "review_path": {"$ref": "#/$defs/relativePath"},
        "returned_ideas_path": {"$ref": "#/$defs/relativePath"},
        "participant_contract_path": {"$ref": "#/$defs/relativePath"},
        "quality_rules": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "skill_rules": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "participants": {
          "type": "array",
          "minItems": 2,
          "items": {"$ref": "#/$defs/participant"}
        },
        "ideas": {
          "type": "array",
          "items": {"$ref": "#/$defs/idea"}
        }
      }
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    }
  }
}
