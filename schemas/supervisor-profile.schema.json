{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "moontown/supervisor-profile@1.0.0",
  "type": "object",
  "required": ["schema", "profile_id", "owner_user_id", "identity", "role", "mission", "tone", "capabilities", "bindings", "authority_ceiling", "revision", "consent", "content_digest"],
  "properties": {
    "schema": {"const": "moontown.supervisor-profile.v1"},
    "profile_id": {"type": "string", "minLength": 1},
    "owner_user_id": {"type": "string", "minLength": 1},
    "identity": {"type": "object"},
    "role": {"type": "string", "minLength": 1},
    "mission": {"type": "string", "minLength": 1},
    "tone": {"type": "string", "minLength": 1},
    "capabilities": {"type": "array", "minItems": 1},
    "bindings": {"type": "object"},
    "authority_ceiling": {"type": "string"},
    "revision": {"type": "integer", "minimum": 1},
    "consent": {"type": "object"},
    "content_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
